# macOS
.DS_Store

# Obsidian workspace (machine-local state)
.obsidian/

# claude local state
.claude/settings.local.json
.claude/CLAUDE.local.md
.claude/worktrees/

# pearde lives in its own repo (~/dev/infra/pearde); this is a local symlink
.claude/skills/pearde
# pearde view state — regenerable, rewritten continuously by the live service
.pearde/.state/
.pearde/.history.jsonl
.pearde/.plan.json
.pearde/.view.html
.pearde/.claims/

# The knowledge base and the graph vault ARE versioned; only the regenerable
# cache below is not. The secret that used to sit in .pearde/wiki/ is ignored
# by .pearde/.gitignore and is gone from every reachable commit.
.pearde/graphify/cache/
