# Gate recipes. The root justfile picks this file up with `import? 'gates/justfile'`
# — that seam belongs to 05-platform/01-deploy-mechanism/repo-skeleton (P.1),
# which owns the root file. Nothing here edits it: these recipes appear in
# `just --list` and run from any subdirectory purely by existing.
#
# The registry (gates/waves.tsv) says which gates belong to which wave and
# gates/wave-status.sh resolves whether a wave is ARMED. An ARMED wave that is
# failing is red; an ARMED wave with NO gate registered is red too.

gates_dir := source_directory()

# The whole set, in one command: guard, lint, probe preflight, meta-gate,
# registry integrity, then every wave in order. Non-zero if any ARMED wave is
# red.
[doc('Run every gate, in wave order. The one command R5 asks for.')]
gates:
    @bash "{{ gates_dir }}/wave-status.sh" --sweep

# One wave.
[doc('Run one wave gate: just gate 0')]
gate n:
    @bash "{{ gates_dir }}/wave-status.sh" --run {{ n }}

# The matrix only. Runs nothing, always exits 0.
[doc('Print the wave matrix — ARMED or PENDING per wave. Runs nothing.')]
gate-status:
    @bash "{{ gates_dir }}/wave-status.sh" --matrix

# The meta-gate: hold every gate script to the --selftest contract.
[doc('Prove every gate by breaking it: no gate ships unbroken.')]
gate-selftest:
    @bash "{{ gates_dir }}/selftest.sh"

# The interactive checklist for one wave — the checks a human must run.
[doc('Print the interactive checklist for a wave: just manual 3')]
manual n:
    @cat "{{ gates_dir }}/manual/wave{{ n }}.md"
