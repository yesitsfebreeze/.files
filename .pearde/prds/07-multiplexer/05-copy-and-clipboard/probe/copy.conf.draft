# ── 05-copy-and-clipboard: copy mode, the c-cycle, and the sink ─────────────

set -gw mode-keys vi

if-shell 'command -v pbcopy >/dev/null 2>&1' \
    'set -g @copy-sink pbcopy' \
    'set -g @copy-sink osc52'

set -s set-clipboard on

bind -n C-S-x {
    set -pu @copy-cycle
    copy-mode
}

bind -T copy-mode-vi c {
    if -F '#{==:#{@copy-cycle},cell}' {
        send -X select-word
        set -p @copy-cycle word
    } {
        if -F '#{==:#{@copy-cycle},word}' {
            send -X select-line
            set -p @copy-cycle line
        } {
            if -F '#{==:#{@copy-cycle},line}' { send -X jump-to-mark }
            send -X set-mark
            send -X clear-selection
            send -X begin-selection
            set -p @copy-cycle cell
        }
    }
}

bind -T copy-mode-vi y {
    set -pu @copy-cycle
    if -F '#{==:#{@copy-sink},pbcopy}' \
        'send -X copy-pipe-and-cancel pbcopy' \
        'send -X copy-selection-and-cancel'
}
