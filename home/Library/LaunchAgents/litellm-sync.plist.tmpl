<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>litellm-sync</string>
    <key>ProgramArguments</key>
    <array><string>{{ .chezmoi.homeDir }}/.local/bin/llm</string><string>sync</string></array>
    <key>EnvironmentVariables</key>
    <dict><key>PATH</key><string>{{ .chezmoi.homeDir }}/.local/bin:/opt/homebrew/bin:/usr/bin:/bin</string></dict>
    <key>StartCalendarInterval</key>
    <dict><key>Hour</key><integer>4</integer><key>Minute</key><integer>30</integer></dict>
    <key>StandardOutPath</key><string>{{ .chezmoi.homeDir }}/.local/state/litellm/sync.log</string>
    <key>StandardErrorPath</key><string>{{ .chezmoi.homeDir }}/.local/state/litellm/sync.log</string>
</dict>
</plist>
