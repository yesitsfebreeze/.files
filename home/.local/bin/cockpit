#!/bin/bash
# cockpit — compile cockpit.json into native tmux key tables on config reload.
# F5 and every menu key then run inside tmux; no dispatcher or status jobs.
# Each group has its own client-local table. Arrows reuse the jump bindings.
# JSON actions: tmux, popup (optional border/height), shell, or wezterm.
# manual → internals/tmux, "F5 — the cockpit".
set -eu
case ${1:-gen} in
--open) exec tmux switch-client -T cockpit \; refresh-client -S ;;
gen) ;;
*) echo 'usage: cockpit gen | --open' >&2; exit 1 ;;
esac
json=${XDG_CONFIG_HOME:-$HOME/.config}/tmux/cockpit.json
cache=${XDG_CACHE_HOME:-$HOME/.cache}
mkdir -p "$cache"
compiled=$(mktemp "$cache/cockpit.XXXXXX")
trap 'rm -f "$compiled"' EXIT
# Compile before touching the server: malformed JSON keeps the working menu.
jq -r --arg arrows "$(tmux list-keys -T jump | awk '$4 ~ /^((S-|M-)?(Up|Down|Left|Right))$/')" '
def q: "\"" + gsub("(?<c>[\\\\\"$])"; "\\\(.c)") + "\"";
def table: "cockpit" + (if . == "" then "" else "-" + . end);
def action:
    if .tmux then .tmux
    elif .popup then "run-shell -b " + ("~/.local/bin/modal \u0027#{client_name}\u0027 \u0027#{pane_id}\u0027 \u0027#{E:@cwd}\u0027 \u0027" + .popup + "\u0027" +
        (if .border then " border" else "" end) + (if .height then " h=\(.height)" else "" end) | q)
    elif .shell then "send-keys -Fl -- " + (.shell | q) + " ; send-keys Enter"
    elif .wezterm then "run-shell " + ("printf \u0027\\033]1337;SetUserVar=wez=" + (.wezterm | @base64) + "\\007\u0027 > #{client_tty}" | q)
    else "" end;
. as $menu | to_entries | map(. + {action: (.value | action)}) as $rows |
([""] + [$rows[] | select(.action == "") | .key]) as $paths |
("set -g @cockpit-menu " + (reduce $paths[] as $p ("";
    "#{?#{==:#{client_key_table},\($p | table)},#{E:@cockpit-menu-\($p | table)}," + . + "}") | q)),
($paths[] as $path |
($path | table) as $table |
[$rows[] | select((.key | length) == ($path | length) + 1 and (.key | startswith($path)))] as $children |
"unbind-key -aq -T \($table)",
"bind-key -T \($table) Any switch-client -T root",
(("Escape", "Enter") as $exit | "bind-key -T \($table) \($exit) { switch-client -T root ; refresh-client -S }"),
"bind-key -T \($table) BSpace { switch-client -T \(if $path == "" then "root" else $path[:-1] | table end) ; refresh-client -S }",
($arrows | gsub("-T jump +"; "-T \($table) ")),
($children[] | "bind-key -T \($table) \(.key[-1:] | q) { " +
    (if .action == "" then "switch-client -T " + (.key | table)
     else "switch-client -T root ; " + .action end) + " ; refresh-client -S }"),
(if $path == "" then range(1; 10) as $n |
    "bind-key -T cockpit \($n) { switch-client -T root ; if -F \"#{W:#{?#{==:#{window_index},\($n)},1,}}\" { select-window -t :=\($n) } { new-window -t :\($n) -c ~ } }"
 else empty end),
("set -g @cockpit-menu-\($table) " +
    ((if $path == "" then "" else "#[fg=colour8]" + $menu[$path].label + " ›  " end) +
     ([$children[] | select(.action != "")] + [$children[] | select(.action == "")] |
        map("#[fg=colour7]" + .key[-1:] + (if .action == "" then "#[fg=colour4] +" else "#[fg=colour8] " end) + .value.label + "  ") | join("")) +
     "#[fg=colour7]⌫#[fg=colour8] back  #[fg=colour7]Esc#[fg=colour8] close" | q)))
' "$json" > "$compiled"
tmux source-file -n "$compiled"
tmux source-file "$compiled"
