#!/bin/bash
# tmux-copy-expand PANE — Space in copy mode grows the selection one step:
# first the link under the cursor (trailing punctuation and any lead-in like
# "(" peeled off), else the word under it — the run of non-spaces; then the
# whole line; then every further press adds the line below, scrolling the view
# along, until the end of the scrollback. A Space with no selection, or with
# the cursor moved since the last one, starts over (tmux.conf's motion keys
# clear the selection).
#
# @expand-at is where the last press left the cursor.
#
# TRAP: every exec costs ~80 ms on this host (2026-09-23), so this is bash
# builtins and two tmux calls.
# manual → guide/copy (terminal.nuon, the copy-mode entry).

PANE=${1:?tmux-copy-expand: no pane}

# The line last: it may hold a `|`, and read hands the rest to the last name.
IFS='|' read -r CX CY SEL AT STAGE L < <(tmux display -p -t "$PANE" \
    '#{copy_cursor_x}|#{copy_cursor_y}|#{selection_present}|#{@expand-at}|#{@expand-stage}|#{copy_cursor_line}')

c=(send-keys -t "$PANE" -X)
x() { c+=(";" send-keys -t "$PANE" -X "$@"); }

if [[ $SEL == 1 && $AT == "$CX,$CY" ]]; then
    # Already a selection from here: the line, or one more line below. After
    # select-line the selection is in line mode, so cursor-down takes whole
    # lines and scrolls when it passes the bottom of the view.
    if [[ $STAGE == word ]]; then c+=(select-line); else c+=(cursor-down); x end-of-line; fi
    STAGE=line
elif (( CX < ${#L} )) && [[ ${L:CX:1} != " " ]]; then
    S=$CX E=$CX
    while (( S > 0 )) && [[ ${L:S-1:1} != " " ]]; do ((S--)); done
    while (( E < ${#L} )) && [[ ${L:E:1} != " " ]]; do ((E++)); done
    W=${L:S:E-S}
    if [[ $W == *http://* || $W == *https://* ]]; then
        pre=${W%%http*}; ((S += ${#pre})); W=${W:${#pre}}
        while [[ $W == *[.,\;:!?\)\]\>\'\"] ]]; do W=${W%?}; ((E--)); done
    fi
    # Relative moves, never start-of-line: that follows a wrap up a row.
    # A selection includes both end cells, so [S,E) is E-S-1 cursor-rights.
    c+=(clear-selection)
    (( CX > S )) && x -N $((CX - S)) cursor-left
    (( CX < S )) && x -N $((S - CX)) cursor-right
    x begin-selection
    (( E - S > 1 )) && x -N $((E - S - 1)) cursor-right
    STAGE=word
else
    # On a space or past the text: nothing word-like here, take the line.
    c+=(select-line); STAGE=line
fi

# -F reads the cursor back where the moves actually left it.
c+=(";" set -p -t "$PANE" -F @expand-at '#{copy_cursor_x},#{copy_cursor_y}'
    ";" set -p -t "$PANE" @expand-stage "$STAGE")
tmux "${c[@]}"
