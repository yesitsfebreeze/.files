#!/bin/sh
# tmux-jump — F5 p p: the panes numbered over a frozen screen.
#
#   tmux-jump CLIENT            (F5 p p)
#   tmux-jump --pick COMP WIN   (inside the popup: one key, then gone)
#
# The client's window is captured pane by pane — visible rows only, escape
# sequences kept — into one ANSI composite the exact size of the window
# area, and a popup over that very area cats it: the screen appears FROZEN
# for as long as the mode lasts (the status line sits outside the popup and
# stays live). On top of the composite each pane gets its number: the
# pane's index, the digit itself, in the middle of the pane inside one of
# our own rounded boxes — colour8 like the pickers', no background, only
# the box and the digit painted. One key decides: a digit jumps to the pane
# its index's last digit names (tmux's own display-panes rule; the first
# match wins), any other key closes with nothing run. The composite is
# built BEFORE the popup opens and the popup only cats it, so the frozen
# screen costs one process spawn — the same single blank frame the
# cockpit's own open pays. DECAWM is off inside the popup, so the content
# of a partially visible pane never wraps onto the row below.
# Zen: the spacers are neither captured nor numbered, the floated columns
# are panes and are numbered like any other; a column wholly off-screen
# (the carousel's waiting columns) is skipped. A zoomed window captures
# and numbers the zoomed pane alone.
# manual → internals/tmux, "p p — jump to a pane by its number".
set -u
if [ "${1-}" = --pick ]; then
    comp=$2 win=$3
    stty -echo -icanon min 1 time 0 || exit 0
    cat "$comp"; rm -f "$comp"
    # One key: a digit jumps to the pane its index's last digit names,
    # spacers skipped; anything else closes with nothing run.
    k=$(dd bs=1 count=1 2>/dev/null)
    case $k in
    [0-9]) pid=$(tmux list-panes -t "$win" -F '#{pane_index} #{?#{@zen_spacer},1,0} #{pane_id}' |
            awk -v d="$k" '$2 != 1 && ($1 % 10) == d { print $3; exit }')
           [ -n "$pid" ] && tmux select-window -t "$win" \; select-pane -t "$pid" ;;
    esac
    exit 0
fi
client=${1:-}
[ -n "$client" ] || exit 1
# The client's CURRENT window: the numbers must sit on what it shows.
set -- $(tmux display -p -c "$client" '#{window_id} #{window_width} #{window_height}')
[ $# -eq 3 ] || exit 0
win=$1 w=$2 h=$3
zoom=$(tmux display -p -t "$win" '#{window_zoomed_flag}')
comp=$(mktemp "${TMPDIR:-/tmp}/tmux-jump.XXXXXX")
# Fields: id idx left top width height active float spacer zen_float.
tmux list-panes -t "$win" -F '#{pane_id} #{pane_index} #{pane_left} #{pane_top} #{pane_width} #{pane_height} #{pane_active} #{pane_floating_flag} #{?#{@zen_spacer},1,0} #{?#{@zen_float},1,0}' |
awk -v W="$w" -v H="$h" -v zoom="$zoom" '
    function rep(s, k,   t) { t = ""; while (k-- > 0) t = t s; return t }
    BEGIN { printf "\033[?2026h\033[?25l\033[?7l\033[H\033[2J" }
    # The frozen screen: each pane at its own cells, colours kept.
    { if ($9 == 1) next                                     # a zen spacer
      if ($8 == 1 && $10 != 1) next                         # a stray popup
      if (zoom == 1 && $7 != 1) next                        # behind the zoom
      if ($3 + $5 <= 0 || $4 + $6 <= 0 || $3 >= W || $4 >= H) next
      c = "tmux capture-pane -e -p -t " $1
      for (r = $4; (c | getline line) > 0; r++) {
          if (r >= H) break
          printf "\033[%d;%dH%s", r + 1, $3 + 1, line
      }
      close(c)
      n++; L[n] = $3; T[n] = $4; Wd[n] = $5; Ht[n] = $6; Ix[n] = $2
    }
    END {
        b = "\033[90m"; z = "\033[0m"
        for (i = 1; i <= n; i++) {
            d = Ix[i] % 10
            # The chip is a cleared plate: a 9x5 footprint, blank everywhere,
            # with the 5x3 rounded box centred in it — one blank row above
            # and below, two blank columns left and right, and a blank cell
            # either side of the digit inside the border. Nothing shows
            # through: the margin and the padding are cleared, so the digit
            # reads against a clean ground however busy the pane is.
            fw = 9; fh = 5; bw = 5; bh = 3
            if (Wd[i] < fw || Ht[i] < fh) { fw = bw; fh = bh }
            if (Wd[i] < bw || Ht[i] < bh) continue
            x = L[i] + int((Wd[i] - fw) / 2); y = T[i] + int((Ht[i] - fh) / 2)
            if (x < 0 || y < 0 || x + fw > W || y + fh > H) continue
            # the clear: every footprint cell blank, default ground
            for (r = y; r < y + fh; r++)
                printf "%s\033[%d;%dH%s", z, r + 1, x + 1, rep(" ", fw)
            # the box, centred in the footprint, digit and padding inside
            bx = x + int((fw - bw) / 2); by = y + int((fh - bh) / 2)
            printf "%s\033[%d;%dH╭%s╮\033[%d;%dH│%s %d %s│\033[%d;%dH╰%s╯%s", \
                b, by + 1, bx + 1, rep("─", bw - 2), by + 2, bx + 1, z, d, b, \
                by + 3, bx + 1, rep("─", bw - 2), z
        }
        printf "\033[?2026l"
    }' > "$comp"
tmux display-popup -c "$client" -E -B -w "$w" -h "$h" -x 0 -y "$((h - 1))" \
    "exec '$0' --pick '$comp' '$win'"