#!/bin/bash
# Enter in copy mode opens the OSC 8 link or plain URL under the cursor;
# otherwise copy the selection and leave. One read, no per-character forks.
# manual → internals/tmux, "Enter opens a link before it copies".
PANE=${1:?tmux-copy-open-link: no pane}
{
    IFS= read -r URL
    IFS='|' read -r CX L
} < <(tmux display -p -t "$PANE" $'#{copy_cursor_hyperlink}\n#{copy_cursor_x}|#{copy_cursor_line}')

if [[ -z $URL && $CX -lt ${#L} && ${L:CX:1} != " " ]]; then
    S=$CX E=$CX
    while (( S > 0 )) && [[ ${L:S-1:1} != " " ]]; do ((S--)); done
    while (( E < ${#L} )) && [[ ${L:E:1} != " " ]]; do ((E++)); done
    URL=${L:S:E-S}
    while [[ $URL == *[.,\;:!?\)\]\>] ]]; do URL=${URL%?}; done
    case $URL in http://* | https://*) ;; *) URL= ;; esac
fi
if [[ -n $URL ]]; then
    open "$URL" >/dev/null 2>&1 &
    tmux send-keys -t "$PANE" -X cancel
else
    tmux send-keys -t "$PANE" -FX copy-pipe-and-cancel "#{@copy-pipe}"
fi
