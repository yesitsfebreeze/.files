#!/bin/sh
# tmux-main — the one way into this environment's tmux session.
#
# One spelling of the attach for WezTerm, ssh and everything else.
# `new-session -A` attaches or creates, so the session outlives the terminal.
# `-c` only applies at creation: a `new-window` without `-c` inherits the
# SESSION's directory, so every new-window in this repo passes its own `-c`.
# TRAP: the nu-launch ladder lives only in tmux.conf's default-command.
# POSIX sh: runs before nushell exists, maybe where it is not installed.
# manual → internals/tmux, "Where the start dir is read".
set -u

# The recorded directory if it still exists, then ~/dev, then $HOME.
mkdir -p "$HOME/dev" 2>/dev/null || true
start="$HOME"
if [ -d "$HOME/dev" ]; then start="$HOME/dev"; fi
_sd="${XDG_STATE_HOME:-$HOME/.local/state}/nushell/startdir.txt"
if [ -r "$_sd" ]; then
    _d=$(cat "$_sd" 2>/dev/null)
    if [ -n "$_d" ] && [ -d "$_d" ]; then start="$_d"; fi
fi

exec tmux new-session -A -s main -c "$start" "$@"
