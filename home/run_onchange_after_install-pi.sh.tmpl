#!/usr/bin/env bash
# chezmoi run_onchange — install the pi agent stack around the `pi` binary that
# run_onchange_install-packages.sh already put on PATH:
#
#   1. clone/refresh the extension workspace (one git repo per package)
#   2. point the workspace's node_modules at pi's install (LSP resolution only)
#   3. scaffold the workspace root files that are not part of any package repo
#   4. take over ~/.local/bin/pi with the pi-launch.sh wrapper the stack owns
#   5. register the extension sources in pi's settings
#   6. deep-merge the synced preferences into pi's settings
#
# Runs on Linux and macOS. Everything is idempotent and non-fatal: a missing
# network or a dead clone warns and moves on, it never breaks `chezmoi apply`.
#
# Re-runs whenever the rendered list below changes.
# pi.yaml sha256: {{ include ".chezmoidata/pi.yaml" | sha256sum }}
set -uo pipefail

log()  { printf '\033[1;34m::\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!!\033[0m %s\n' "$*"; }

# Pick up tools installed earlier in this same apply (brew shellenv / user bins).
[ -x /opt/homebrew/bin/brew ] && eval "$(/opt/homebrew/bin/brew shellenv)"
[ -x /usr/local/bin/brew ] && eval "$(/usr/local/bin/brew shellenv)"
export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"

ws="$HOME/{{ .pi.workspace }}"
owner="{{ .pi.owner }}"
prefix="{{ .pi.repo_prefix }}"
hub="{{ .pi.hub }}"
packages="{{ range .pi.packages }}{{ . }} {{ end }}"
settings="$HOME/.pi/agent/settings.json"

if ! command -v git >/dev/null 2>&1; then
    warn "pi extensions: git not found; install git and re-run: chezmoi apply"
    exit 0
fi

# --- 1. the extension workspace ------------------------------------------------
# Each package is a standalone repo (github.com/<owner>/<prefix><name>), NOT a
# submodule and not published to npm, so the checkout is what installs it: hub
# watches this directory and registers whatever it finds. Existing checkouts are
# fast-forwarded only — never rebased or reset, so local work in a package is
# safe and a dirty/diverged checkout is simply left alone.
log "pi extensions: workspace $ws"
mkdir -p "$ws"
cloned=0; pulled=0; skipped=0
for p in $packages; do
    if [ -d "$ws/$p/.git" ]; then
        if git -C "$ws/$p" pull --ff-only --quiet >/dev/null 2>&1; then
            pulled=$((pulled + 1))
        else
            skipped=$((skipped + 1))   # dirty, diverged, offline — leave it be
        fi
    elif [ -e "$ws/$p" ]; then
        warn "  $p exists but is not a git checkout — leaving it untouched"
    else
        log "  clone $prefix$p"
        if git clone --quiet "https://github.com/$owner/$prefix$p.git" "$ws/$p" >/dev/null 2>&1; then
            cloned=$((cloned + 1))
        else
            warn "    could not clone https://github.com/$owner/$prefix$p.git"
        fi
    fi
done
log "  $cloned cloned, $pulled updated, $skipped left alone (dirty/diverged/offline)"

# --- 2. node_modules shim ------------------------------------------------------
# Point the workspace at pi's own install so tsserver resolves @earendil-works/*,
# typebox and @types/node without an npm install here. Editor convenience only —
# pi loads the extensions through its own runtime either way.
pi_nm="$HOME/.pi/agent/npm/node_modules"
if [ -d "$pi_nm" ]; then
    if [ -L "$ws/node_modules" ]; then
        rm -f "$ws/node_modules"; ln -s "$pi_nm" "$ws/node_modules"
    elif [ ! -e "$ws/node_modules" ]; then
        ln -s "$pi_nm" "$ws/node_modules"
    else
        warn "  $ws/node_modules exists and is not a symlink — leaving it"
    fi
fi

# --- 3. workspace root scaffolding --------------------------------------------
# The root is not a package and has no repo of its own, so these two files ship
# from here. Written only when absent: if the root ever becomes a checkout, its
# tracked copies win.
#
# .gitignore keeps `git status` in the root from listing every package dir as
# untracked; it is generated from the same package list as the clones above.
if [ ! -e "$ws/.gitignore" ]; then
    {
        echo "# Generated by chezmoi (run_onchange_after_install-pi.sh) from"
        echo "# .chezmoidata/pi.yaml. Every package dir below is its own git repo —"
        echo "# anchored with a leading slash so the pattern cannot also swallow a"
        echo "# nested dir of the same name (an unanchored gantt/ ate .pi/gantt/)."
        echo "/node_modules"
        echo "/tsconfig.tsbuildinfo"
        for p in $packages; do echo "/$p/"; done
    } > "$ws/.gitignore"
    log "  wrote $ws/.gitignore"
fi

# The per-package release recipe. [no-cd] so `just push` inside a package runs in
# that package's dir (just searches upward and would otherwise run at the root).
# pi re-pulls a package only when its version changes, so the bump is the release.
if [ ! -e "$ws/justfile" ]; then
    cat > "$ws/justfile" <<'JUSTFILE'
# Bump patch version, commit all changes, push.
# [no-cd]: each package is its own repo — run in the caller's dir, not the
# workspace root just found this file in.
[no-cd]
push msg="update":
    npm version patch --no-git-tag-version
    git add -A
    git commit -m "{{ "{{msg}}" }} (v$(jq -r .version package.json))"
    git push
JUSTFILE
    log "  wrote $ws/justfile"
fi

# --- 4. the pi launcher wrapper ----------------------------------------------
# `pi` on PATH is a wrapper the ollama-models package owns: it heals the Ollama
# baseUrl before pi reads models.json, pins CLAUDE_CONFIG_DIR to the cc/cr
# last-login profile, offers session resume, and detaches the shutdown updater
# once an interactive TUI quits. It execs the REAL pi at $node_bin/pi (resolved
# by readlink through node), which is exactly where install-packages puts it —
# so symlinking over ~/.local/bin/pi cannot shadow the binary it needs.
# Skipped entirely unless that real binary is in place.
node_bin=""
command -v node >/dev/null 2>&1 && node_bin="$(dirname "$(readlink -f "$(command -v node)")")"
launcher="$ws/ollama-models/bin/pi-launch.sh"
if [ -n "$node_bin" ] && [ -x "$node_bin/pi" ] && [ -f "$launcher" ]; then
    chmod +x "$launcher" 2>/dev/null || true
    if [ "$(readlink -f "$HOME/.local/bin/pi" 2>/dev/null)" != "$(readlink -f "$launcher")" ]; then
        mkdir -p "$HOME/.local/bin"
        ln -sfn "$launcher" "$HOME/.local/bin/pi"
        log "  pi -> $launcher (wrapper; real pi at $node_bin/pi)"
    fi
elif [ -n "$node_bin" ] && [ -x "$node_bin/pi" ]; then
    warn "  pi-launch.sh missing (ollama-models not cloned?) — leaving plain pi on PATH"
else
    warn "  real pi binary not found in a node bin dir; re-run after install-packages succeeds"
fi

# --- 5 + 6. pi's settings -----------------------------------------------------
# settings.json is shared ground: pi writes runtime keys into it (the resolved
# `packages` array, lastChangelogVersion) while the preferences below are synced
# from this repo. So it is never copied over — it is merged, both halves.
if ! command -v jq >/dev/null 2>&1; then
    warn "pi settings: jq not found; skipping (install jq and re-run: chezmoi apply)"
    exit 0
fi
mkdir -p "$HOME/.pi/agent"
[ -s "$settings" ] || echo '{}' > "$settings"

# Extension sources: the npm-published ones plus the workspace hub (an absolute
# path — hub is loaded from the checkout, never from a registry). `pi install`
# resolves and fetches now; if it can't (offline, or the CLI rejects a path
# source) the entry is appended directly, and pi resolves it on next start.
has_source() { jq -e --arg s "$1" '(.packages // []) | index($s) != null' "$settings" >/dev/null 2>&1; }
for src in {{ range .pi.npm_packages }}"npm:{{ . }}" {{ end }}"$ws/$hub"; do
    has_source "$src" && continue
    log "pi install $src"
    pi install "$src" >/dev/null 2>&1 || true
    if ! has_source "$src"; then
        tmp="$(mktemp)"
        if jq --arg s "$src" '.packages = ((.packages // []) + [$s] | unique)' "$settings" > "$tmp" 2>/dev/null; then
            mv "$tmp" "$settings"
            log "  registered $src in settings (pi will resolve it on next start)"
        else
            rm -f "$tmp"; warn "  could not register $src"
        fi
    fi
done

# Synced preferences win over whatever is on this machine — same contract as the
# theme: pick it once, every machine adopts it on the next apply.
prefs='{{ .pi.settings | toJson }}'
tmp="$(mktemp)"
if jq --argjson p "$prefs" '. * $p' "$settings" > "$tmp" 2>/dev/null; then
    mv "$tmp" "$settings"
    log "pi settings: merged synced preferences into $settings"
else
    rm -f "$tmp"; warn "pi settings: could not merge preferences into $settings"
fi
