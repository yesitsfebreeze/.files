{
  "s": {"label": "search", "icon": ""},
  "sf": {"label": "files", "icon": "", "popup": "~/.local/bin/tv-go act files"},
  "sg": {"label": "grep", "icon": "", "popup": "~/.local/bin/tv-go act text"},
  "sr": {"label": "recent files", "icon": "", "popup": "~/.local/bin/tv-go act recent-files"},
  "sd": {"label": "dirs", "icon": "", "popup": "~/.local/bin/tv-go act dirs"},
  "sz": {"label": "recent dirs", "icon": "", "popup": "~/.local/bin/tv-go act recent-dirs"},
  "sh": {"label": "history", "icon": "", "popup": "~/.local/bin/tv-go type nu-history"},
  "sc": {"label": "any channel", "icon": "", "popup": "~/.local/bin/tv-go act"},
  "sq": {"label": "query first", "icon": "", "tmux": "command-prompt -p search { run-shell -b \"~/.local/bin/modal '#{client_name}' '#{pane_id}' '#{E:@cwd}' '~/.local/bin/tv-go find %1'\" }"},
  "st": {"label": "type into pane", "icon": "", "popup": "~/.local/bin/tv-go type"},
  "ss": {"label": "sessions", "icon": "", "popup": "~/.local/bin/tv-go act panes"},

  "g": {"label": "git", "icon": "󰊢"},
  "gl": {"label": "lazygit", "icon": "", "popup": "lazygit", "border": true},
  "gc": {"label": "commits", "icon": "", "popup": "~/.local/bin/tv-go act git-log"},
  "gd": {"label": "diff", "icon": "", "popup": "~/.local/bin/tv-go act git-diff"},
  "gs": {"label": "stash", "icon": "", "popup": "~/.local/bin/tv-go act git-stash"},
  "gr": {"label": "repos", "icon": "", "popup": "~/.local/bin/tv-go act git-repos"},
  "gw": {"label": "worktrees", "icon": "", "popup": "~/.local/bin/tv-go act git-worktrees"},

  "w": {"label": "window", "icon": ""},
  "wn": {"label": "new", "icon": "", "tmux": "new-window -c '#{E:@cwd}'"},
  "wr": {"label": "rename", "icon": "", "tmux": "command-prompt -I '#W' { rename-window '%%' }"},
  "wt": {"label": "tree", "icon": "", "tmux": "choose-tree -Zw"},
  "wx": {"label": "kill", "icon": "", "tmux": "kill-window"},
  "ww": {"label": "new here", "icon": "", "tmux": "run-shell -b '~/.local/bin/tmux-slot new #{pane_id} \"#{E:@cwd}\"'"},
  "wb": {"label": "back", "icon": "", "tmux": "run-shell -b '~/.local/bin/tmux-slot back #{pane_id}'"},
  "wf": {"label": "forward", "icon": "", "tmux": "run-shell -b '~/.local/bin/tmux-slot forward #{pane_id}'"},
  "wh": {"label": "hide", "icon": "󰈉", "tmux": "run-shell -b '~/.local/bin/tmux-slot hide #{pane_id} \"#{client_name}\"'"},
  "wq": {"label": "close pane", "icon": "", "tmux": "kill-pane"},
  "wz": {"label": "zen", "icon": "", "tmux": "run-shell -b '~/.local/bin/tmux-zen toggle'"},

  "p": {"label": "pane", "icon": ""},
  "ph": {"label": "split left", "icon": "", "tmux": "split-window -hb -c '#{E:@cwd}'"},
  "pj": {"label": "split down", "icon": "", "tmux": "split-window -v -c '#{E:@cwd}'"},
  "pk": {"label": "split up", "icon": "", "tmux": "split-window -vb -c '#{E:@cwd}'"},
  "pl": {"label": "split right", "icon": "", "tmux": "split-window -h -c '#{E:@cwd}'"},
  "pz": {"label": "zoom", "icon": "", "tmux": "resize-pane -Z"},
  "pb": {"label": "own window", "icon": "", "tmux": "break-pane"},
  "px": {"label": "close", "icon": "", "tmux": "kill-pane"},
  "pr": {"label": "relax", "icon": "", "tmux": "run-shell -b '~/.local/bin/tmux-relax #{pane_id}'"},

  "t": {"label": "theme", "icon": ""},
  "tt": {"label": "dark / light", "icon": "", "tmux": "run-shell -b '\"$HOME/.config/tinted-theming/tinty/theme.sh\" --toggle > /dev/null'"},
  "ts": {"label": "scheme", "icon": "", "popup": "~/.local/bin/tv-go act theme", "height": 30},
  "tf": {"label": "font", "icon": "", "popup": "~/.local/bin/tv-go act font", "height": 30},
  "tw": {"label": "wallpaper", "icon": "󰋩", "popup": "~/.local/bin/tv-go act wallpaper", "height": 30},

  "u": {"label": "wezterm", "icon": ""},
  "uq": {"label": "close window", "icon": "", "wezterm": "close"},
  "u+": {"label": "font bigger", "icon": "", "wezterm": "bigger"},
  "u-": {"label": "font smaller", "icon": "", "wezterm": "smaller"},
  "u0": {"label": "font reset", "icon": "", "wezterm": "reset"},
  "f": {"label": "files", "icon": "", "tmux": "display-popup -E -B -d '#{E:@cwd}' -w 90% -h 85% yazi"},
  "e": {"label": "environment", "icon": "󰘔"},
  "es": {"label": "search", "icon": "", "popup": "~/.local/bin/envs search"},
  "ec": {"label": "copy", "icon": "", "popup": "~/.local/bin/envs copy"},
  "ee": {"label": "edit", "icon": "", "popup": "~/.local/bin/envs edit"},
  "m": {"label": "modify", "icon": "", "tmux": "copy-mode"},
  "d": {"label": "detach", "icon": "", "tmux": "detach-client"},
  "l": {"label": "lock", "icon": "", "tmux": "lock-server"},
  "r": {"label": "reload config", "icon": "", "tmux": "source-file \"$XDG_CONFIG_HOME/tmux/tmux.conf\" ; display 'reloaded'"}
}
