#!/usr/bin/env bash
# chezmoi run_onchange — installs CLI tools on macOS + Linux.
# Driven by packages.yaml: package manager batch install → GitHub release → cargo
# → cargo_git → just_git. Re-runs when packages.yaml changes.
#
# packages.yaml sha256: {{ include ".chezmoidata/packages.yaml" | sha256sum }}
set -uo pipefail

log()  { printf '\033[1;34m::\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!!\033[0m %s\n' "$*"; }

# Pick up a Homebrew that run_once_before_install-homebrew may have just installed
[ -x /opt/homebrew/bin/brew ] && eval "$(/opt/homebrew/bin/brew shellenv)"
[ -x /usr/local/bin/brew ] && eval "$(/usr/local/bin/brew shellenv)"

export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"

# Bootstrap `make` — needed by lazy.nvim's `build` and some cargo crates.
if ! command -v make >/dev/null 2>&1; then
    if [ "$(uname -s)" = "Darwin" ]; then
        log "install Xcode Command Line Tools"
        xcode-select --install 2>/dev/null || true
        warn "  Xcode CLI tools install triggered (GUI prompt); re-run once it finishes"
    elif command -v apt-get >/dev/null 2>&1; then
        sudo apt-get install -y build-essential >/dev/null 2>&1 || warn "  could not install build-essential"
    elif command -v pacman >/dev/null 2>&1; then
        sudo pacman -S --needed --noconfirm base-devel >/dev/null 2>&1 || warn "  could not install base-devel"
    elif command -v dnf >/dev/null 2>&1; then
        sudo dnf install -y make >/dev/null 2>&1 || warn "  could not install make"
    else
        warn "make not found; install manually"
    fi
fi

# --- helpers ---
gh_latest_tag() {
    curl -fsSL "https://api.github.com/repos/$1/releases/latest" 2>/dev/null \
        | grep -m1 '"tag_name"' | sed -E 's/.*"tag_name"[[:space:]]*:[[:space:]]*"([^"]+)".*/\1/'
}

fetch_tarball_binary() {
    _bin="$1"; _url="$2"; _rc=1
    mkdir -p "$HOME/.local/bin"
    _td="$(mktemp -d)"
    if curl -fsSL -o "$_td/asset.tar" "$_url" \
        && tar -xf "$_td/asset.tar" -C "$_td" 2>/dev/null; then
        _found="$(find "$_td" -type f -name "$_bin" 2>/dev/null | head -n1)"
        if [ -n "$_found" ] && cp "$_found" "$HOME/.local/bin/$_bin"; then
            chmod +x "$HOME/.local/bin/$_bin"; _rc=0
        fi
    fi
    rm -rf "$_td"
    return "$_rc"
}

bin_for() {
    case "$1" in
        ripgrep)    echo rg ;;
        neovim)     echo nvim ;;
        imagemagick) echo magick ;;
        nushell)    echo nu ;;
        television) echo tv ;;
        bubblewrap) echo bwrap ;;
        gnupg)      echo gpg ;;
        worktrunk)  echo wt ;;
        burrito)    echo brr ;;
        *)          echo "$1" ;;
    esac
}

crate_for() {
    case "$1" in
        rg)      echo ripgrep ;;
        fd)      echo fd-find ;;
        bat)     echo bat ;;
        zoxide)  echo zoxide ;;
        starship) echo starship ;;
        delta)   echo git-delta ;;
        nu)      echo nu ;;
        tv)      echo television ;;
        tinty)   echo tinty ;;
        just)    echo just ;;
        wt)      echo worktrunk-sync ;;
        *)       echo "" ;;
    esac
}

# --- package lists (rendered from packages.yaml) ---
names="{{ range .packages }}{{ if not (hasKey . "lib") }}{{ .name }} {{ end }}{{ end }}"
brew_pkgs="{{ range .packages }}{{ with .brew }}{{ . }} {{ end }}{{ end }}"
apt_pkgs="{{ range .packages }}{{ with .apt }}{{ . }} {{ end }}{{ end }}"
pacman_pkgs="{{ range .packages }}{{ with .pacman }}{{ . }} {{ end }}{{ end }}"
dnf_pkgs="{{ range .packages }}{{ with .dnf }}{{ . }} {{ end }}{{ end }}"
gh_pkgs="{{ range .packages }}{{ if hasKey . "gh_release" }}{{ .name }}={{ .gh_release }} {{ end }}{{ end }}"

# --- package manager detection ---
if command -v brew >/dev/null 2>&1; then
    MGR=brew
elif command -v apt-get >/dev/null 2>&1; then
    MGR=apt
elif command -v pacman >/dev/null 2>&1; then
    MGR=pacman
elif command -v dnf >/dev/null 2>&1; then
    MGR=dnf
else
    warn "No supported package manager found (brew/apt/pacman/dnf)."
    warn "Install Homebrew (https://brew.sh) then re-run: chezmoi apply"
    MGR=none
fi
log "Package manager: $MGR"

# apt/pacman/dnf need sudo. Detect availability once to skip the doomed loop.
MGR_USABLE=1
case "$MGR" in
    apt|pacman|dnf)
        if [ "$(id -u)" != 0 ] && ! sudo -n true >/dev/null 2>&1; then
            MGR_USABLE=0
            warn "$MGR needs root, but passwordless sudo is unavailable — skipping system packages."
            warn "  relying on user-local fallbacks (~/.local, cargo)"
        fi
        ;;
esac

# --- batch install via package manager ---
install_one() {
    pkg="$1"
    case "$MGR" in
        brew)   brew install "$pkg" >/dev/null 2>&1 || brew install --cask "$pkg" >/dev/null 2>&1 ;;
        apt)    sudo apt-get install -y "$pkg" >/dev/null 2>&1 ;;
        pacman) sudo pacman -S --needed --noconfirm "$pkg" >/dev/null 2>&1 ;;
        dnf)    sudo dnf install -y "$pkg" >/dev/null 2>&1 ;;
        *)      return 1 ;;
    esac
}

if [ "$MGR" != none ] && [ "$MGR_USABLE" = 1 ]; then
    case "$MGR" in
        brew)   pkgs="$brew_pkgs" ;;
        apt)    pkgs="$apt_pkgs"; sudo apt-get update -y >/dev/null 2>&1 || true ;;
        pacman) pkgs="$pacman_pkgs" ;;
        dnf)    pkgs="$dnf_pkgs" ;;
    esac
    for p in $pkgs; do
        log "install $p"
        install_one "$p" || warn "  could not install $p via $MGR (will try fallback)"
    done
fi

# Debian/Ubuntu ship bat/fd as batcat/fdfind; symlink to the expected names.
mkdir -p "$HOME/.local/bin"
command -v batcat >/dev/null 2>&1 && [ ! -e "$HOME/.local/bin/bat" ] && ln -sf "$(command -v batcat)" "$HOME/.local/bin/bat"
command -v fdfind >/dev/null 2>&1 && [ ! -e "$HOME/.local/bin/fd" ]  && ln -sf "$(command -v fdfind)" "$HOME/.local/bin/fd"

# --- GitHub release binary fallbacks ---
# For tools in packages.yaml with gh_release: "<owner>/<repo>". On macOS the
# batch install above already covers most (brew), so gh_release only fires for
# tools brew didn't have or couldn't install. neovim is special: the apt/dnf
# version may be too old for the modern nvim config, so we also upgrade it on
# Linux when < 0.11.
for entry in $gh_pkgs; do
    name="${entry%%=*}"
    repo="${entry#*=}"
    b="$(bin_for "$name")"
    # neovim: apt/dnf ship a stale 0.9.x too old for modern config (< 0.11).
    # Also upgrade when present but outdated (Linux-only; macOS gets current from brew).
    if [ "$name" = neovim ] && command -v nvim >/dev/null 2>&1; then
        nvim_minor="$(nvim --version 2>/dev/null | sed -n '1s/^NVIM v0\.\([0-9]*\).*/\1/p')"
        [ -z "$nvim_minor" ] || [ "$nvim_minor" -ge 11 ] && continue
        # Fall through to reinstall from GitHub release.
    else
        command -v "$b" >/dev/null 2>&1 && continue
    fi

    # Platform/arch detection. macOS Darwin releases use the target triple suffix;
    # Linux uses various conventions per tool, handled per-case below.
    os="$(uname -s)"
    arch="$(uname -m)"
    case "$arch" in
        x86_64|amd64)  ;;
        aarch64|arm64)  ;;
        *)  warn "$name: no prebuilt binary for $arch"; continue ;;
    esac

    # Resolve the latest release tag.
    tag="$(gh_latest_tag "$repo")"
    [ -z "$tag" ] && { warn "$name: could not resolve latest release tag"; continue; }
    ver="${tag#v}"

    log "install $name (GitHub release fallback: $repo/$tag)"

    case "$name" in
        neovim)
            # neovim official release tarball — extract full tree to ~/.local/opt
            # so the binary can resolve its runtime relative to its real path.
            # Linux-only: macOS gets neovim from brew.
            [ "$os" != Linux ] && continue
            case "$arch" in x86_64|amd64) narch=x86_64 ;; aarch64|arm64) narch=arm64 ;; esac
            nd="$(mktemp -d)"
            url="https://github.com/$repo/releases/download/$tag/nvim-linux-$narch.tar.gz"
            if curl -fsSL -o "$nd/nvim.tar.gz" "$url" && tar -xzf "$nd/nvim.tar.gz" -C "$nd" 2>/dev/null; then
                nvim_src="$(find "$nd" -maxdepth 1 -type d -name 'nvim-linux-*' | head -n1)"
                if [ -n "$nvim_src" ]; then
                    rm -rf "$HOME/.local/opt/neovim"
                    mkdir -p "$HOME/.local/opt" "$HOME/.local/bin"
                    cp -r "$nvim_src" "$HOME/.local/opt/neovim"
                    ln -sf "$HOME/.local/opt/neovim/bin/nvim" "$HOME/.local/bin/nvim"
                    log "  installed $("$HOME/.local/bin/nvim" --version 2>/dev/null | sed -n '1p')"
                fi
            else
                warn "  could not download neovim release tarball"
            fi
            rm -rf "$nd"
            ;;

        nushell)
            [ "$os" != Linux ] && continue
            case "$arch" in x86_64|amd64) narch=x86_64 ;; aarch64|arm64) narch=aarch64 ;; esac
            url="https://github.com/$repo/releases/download/$tag/nu-${tag}-${narch}-unknown-linux-musl.tar.gz"
            fetch_tarball_binary nu "$url" && log "  installed nushell" || warn "  could not install nushell"
            ;;

        television)
            [ "$os" != Linux ] && continue
            case "$arch" in
                x86_64|amd64)  tv_target="x86_64-unknown-linux-musl" ;;
                aarch64|arm64) tv_target="aarch64-unknown-linux-gnu" ;;
            esac
            url="https://github.com/$repo/releases/download/$tag/tv-${tag}-${tv_target}.tar.gz"
            fetch_tarball_binary tv "$url" && log "  installed television" || warn "  could not install television"
            ;;

        gh)
            [ "$os" != Linux ] && continue
            case "$arch" in x86_64|amd64) garch=amd64 ;; aarch64|arm64) garch=arm64 ;; esac
            url="https://github.com/$repo/releases/download/$tag/gh_${ver}_linux_${garch}.tar.gz"
            fetch_tarball_binary gh "$url" && log "  installed gh" || warn "  could not install gh"
            ;;

        lazygit)
            [ "$os" != Linux ] && continue
            case "$arch" in x86_64|amd64) larch=x86_64 ;; aarch64|arm64) larch=arm64 ;; esac
            url="https://github.com/$repo/releases/download/$tag/lazygit_${ver}_linux_${larch}.tar.gz"
            fetch_tarball_binary lazygit "$url" && log "  installed lazygit" || warn "  could not install lazygit"
            ;;

        tinty)
            case "$os" in
                Linux)
                    case "$arch" in
                        x86_64|amd64)  ttarget="x86_64-unknown-linux-musl" ;;
                        aarch64|arm64) ttarget="aarch64-unknown-linux-gnu" ;;
                    esac ;;
                Darwin)
                    case "$arch" in
                        x86_64|amd64)  ttarget="x86_64-apple-darwin" ;;
                        aarch64|arm64) ttarget="aarch64-apple-darwin" ;;
                    esac ;;
            esac
            url="https://github.com/$repo/releases/latest/download/tinty-${ttarget}.tar.gz"
            fetch_tarball_binary tinty "$url" && log "  installed tinty" || warn "  could not install tinty"
            ;;

        kern)
            case "$os" in
                Linux)
                    case "$arch" in
                        x86_64|amd64)  ktarget="x86_64-unknown-linux-gnu" ;;
                        aarch64|arm64) ktarget="aarch64-unknown-linux-gnu" ;;
                    esac ;;
                Darwin)
                    case "$arch" in
                        aarch64|arm64) ktarget="aarch64-apple-darwin" ;;
                        *) ktarget="" ;;
                    esac ;;
            esac
            [ -z "$ktarget" ] && { warn "kern: no binary for $os/$arch"; continue; }
            url="https://github.com/$repo/releases/latest/download/kern-${ktarget}.tar.gz"
            fetch_tarball_binary kern "$url" && log "  installed kern" || warn "  could not install kern"
            ;;

        worktrunk)
            [ "$os" != Linux ] && continue
            case "$arch" in
                x86_64|amd64)  wtarget="x86_64-unknown-linux-musl" ;;
                aarch64|arm64) wtarget="aarch64-unknown-linux-musl" ;;
            esac
            url="https://github.com/$repo/releases/latest/download/worktrunk-${wtarget}.tar.xz"
            fetch_tarball_binary wt "$url" && log "  installed worktrunk" || warn "  could not install worktrunk"
            ;;
    esac
done

# --- nvm + Node.js ---
# Bootstraps nvm from its latest release, installs the latest Node, and
# symlinks node/npm/npx into ~/.local/bin for visibility outside bash.
export NVM_DIR="$HOME/.nvm"
if [ ! -s "$NVM_DIR/nvm.sh" ]; then
    nvm_tag="$(gh_latest_tag nvm-sh/nvm)"
    if [ -z "$nvm_tag" ]; then
        warn "nvm: could not resolve latest release tag"
    else
        log "install nvm $nvm_tag"
        curl -fsSL "https://raw.githubusercontent.com/nvm-sh/nvm/$nvm_tag/install.sh" | bash >/dev/null 2>&1 \
            && log "  installed nvm" || warn "  could not install nvm"
    fi
fi
if [ -s "$NVM_DIR/nvm.sh" ]; then
    # shellcheck disable=SC1091
    . "$NVM_DIR/nvm.sh"
    if ! command -v node >/dev/null 2>&1; then
        log "install latest Node.js"
        nvm install node >/dev/null 2>&1 && nvm alias default node >/dev/null 2>&1 \
            && log "  installed Node.js $(node --version 2>/dev/null)" \
            || warn "  could not install Node.js via nvm"
    fi
    # Expose node/npm/npx on PATH for every shell (nvm's PATH wiring is bash-only).
    nvm_bin="$(dirname "$(nvm which current 2>/dev/null)" 2>/dev/null)"
    if [ -n "$nvm_bin" ] && [ -d "$nvm_bin" ] && [ "$nvm_bin" != "$HOME/.local/bin" ]; then
        mkdir -p "$HOME/.local/bin"
        for b in node npm npx; do
            [ -x "$nvm_bin/$b" ] && ln -sf "$nvm_bin/$b" "$HOME/.local/bin/$b"
        done
    fi
fi

# --- npm packages (pi, tree-sitter-cli) ---
pi_npm_pkg="{{ range .packages }}{{ if hasKey . "npm" }}{{ .npm }}{{ end }}{{ end }}"
pi_real=""
if [ -n "${nvm_bin:-}" ]; then
    pi_real="$nvm_bin/pi"
elif command -v node >/dev/null 2>&1; then
    pi_real="$(dirname "$(readlink -f "$(command -v node)")")/pi"
fi
if [ -n "$pi_npm_pkg" ] && [ -n "$pi_real" ] && [ ! -x "$pi_real" ]; then
    if command -v npm >/dev/null 2>&1; then
        log "install pi ($pi_npm_pkg, global npm)"
        npm install -g --ignore-scripts "$pi_npm_pkg" >/dev/null 2>&1 \
            && log "  installed pi" || warn "  could not install pi via npm"
    else
        warn "pi: npm not found; install Node.js/npm and re-run"
    fi
fi
# Baseline `pi` on PATH: link the real binary into ~/.local/bin.
if [ -n "$pi_real" ] && [ -x "$pi_real" ] && [ ! -e "$HOME/.local/bin/pi" ]; then
    mkdir -p "$HOME/.local/bin"
    ln -sfn "$pi_real" "$HOME/.local/bin/pi"
fi

# tree-sitter CLI — needed by nvim-treesitter's `:TSInstall`. The brew formula
# ships only the shared library, so install the npm-published CLI globally.
if ! command -v tree-sitter >/dev/null 2>&1; then
    if ! command -v npm >/dev/null 2>&1; then
        warn "tree-sitter-cli: npm not found; install Node.js and re-run"
    else
        log "install tree-sitter-cli (npm global)"
        npm install -g --allow-scripts=tree-sitter-cli tree-sitter-cli >/dev/null 2>&1 \
            && log "  installed tree-sitter-cli" || warn "  could not install tree-sitter-cli"
        # Expose on PATH in every shell.
        npm_bin="$(npm prefix -g 2>/dev/null)"
        [ -n "$npm_bin" ] && npm_bin="$npm_bin/bin"
        ts_real="$npm_bin/tree-sitter"
        if [ -x "$ts_real" ] && [ "$ts_real" != "$HOME/.local/bin/tree-sitter" ] \
            && [ ! -e "$HOME/.local/bin/tree-sitter" ]; then
            mkdir -p "$HOME/.local/bin"
            ln -sfn "$ts_real" "$HOME/.local/bin/tree-sitter"
        fi
    fi
fi

# --- cargo fallback ---
if command -v cargo >/dev/null 2>&1; then
    for n in $names; do
        [ "$n" = "nerd-font" ] && continue
        b="$(bin_for "$n")"
        command -v "$b" >/dev/null 2>&1 && continue
        crate="$(crate_for "$b")"
        [ -z "$crate" ] && continue
        log "cargo install $crate (fallback for $b)"
        cargo install "$crate" >/dev/null 2>&1 || warn "  cargo install $crate failed"
    done
fi

# --- cargo_git packages (keydr, ...) ---
# Build from their GitHub repos with cargo. Bootstrap rustup if cargo is missing.
cargo_git_pkgs="{{ range .packages }}{{ if hasKey . "cargo_git" }}{{ .name }}={{ .cargo_git }} {{ end }}{{ end }}"
for entry in $cargo_git_pkgs; do
    name="${entry%%=*}"
    repo="${entry#*=}"
    command -v "$name" >/dev/null 2>&1 && continue
    if ! command -v cargo >/dev/null 2>&1; then
        log "install rustup (needed to build $name)"
        curl --proto '=https' --tlsv1.2 -fsSL https://sh.rustup.rs \
            | sh -s -- -y --profile minimal >/dev/null 2>&1 \
            || warn "  rustup bootstrap failed"
        [ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"
    fi
    if command -v cargo >/dev/null 2>&1; then
        log "install $name (cargo install --git $repo)"
        cargo install --git "$repo" --locked "$name" >/dev/null 2>&1 \
            && log "  installed $name" || warn "  could not build $name from $repo"
    else
        warn "$name: no cargo available; install Rust and re-run"
    fi
done

# --- just_git packages (burrito) ---
# Repos that own their build via `just install`.
just_git_pkgs="{{ range .packages }}{{ if hasKey . "just_git" }}{{ .name }}={{ .just_git }} {{ end }}{{ end }}"
for entry in $just_git_pkgs; do
    name="${entry%%=*}"
    repo="${entry#*=}"
    b="$(bin_for "$name")"
    command -v "$b" >/dev/null 2>&1 && continue
    if ! command -v just >/dev/null 2>&1; then
        warn "$name: just not on PATH yet; re-run chezmoi apply once just is installed"
        continue
    fi
    tmp="$(mktemp -d)"
    log "install $name (git clone + just install: $repo)"
    if git clone --depth 1 "$repo" "$tmp/$name" >/dev/null 2>&1 \
        && (cd "$tmp/$name" && just install) >/dev/null 2>&1; then
        log "  installed $b"
    else
        warn "  could not build $name from $repo"
    fi
    rm -rf "$tmp"
done

# --- Nerd Font ---
nerdfont_asset="{{ range .packages }}{{ if hasKey . "nerdfont_asset" }}{{ .nerdfont_asset }}{{ end }}{{ end }}"
if [ -n "$nerdfont_asset" ]; then
    case "$(uname -s)" in
        Darwin) font_dir="$HOME/Library/Fonts" ;;
        *)      font_dir="$HOME/.local/share/fonts" ;;
    esac
    have_font=0
    ls "$font_dir/$nerdfont_asset"*.ttf >/dev/null 2>&1 && have_font=1
    ls "$font_dir/$nerdfont_asset"*.otf >/dev/null 2>&1 && have_font=1
    if [ "$have_font" = 0 ] && command -v fc-list >/dev/null 2>&1; then
        fc-list 2>/dev/null | grep -qi "$nerdfont_asset" && have_font=1
    fi
    if [ "$have_font" = 0 ]; then
        log "install Nerd Font $nerdfont_asset"
        mkdir -p "$font_dir"
        ft="$(mktemp -d)"
        if curl -fsSL -o "$ft/$nerdfont_asset.zip" \
            "https://github.com/ryanoasis/nerd-fonts/releases/latest/download/$nerdfont_asset.zip"; then
            mkdir -p "$ft/fonts"
            if command -v unzip >/dev/null 2>&1; then
                unzip -oq "$ft/$nerdfont_asset.zip" '*.ttf' '*.otf' -d "$ft/fonts" 2>/dev/null
            elif command -v python3 >/dev/null 2>&1; then
                python3 -m zipfile -e "$ft/$nerdfont_asset.zip" "$ft/fonts" >/dev/null 2>&1
            else
                tar -xf "$ft/$nerdfont_asset.zip" -C "$ft/fonts" 2>/dev/null
            fi
            copied=0
            for f in "$ft"/fonts/*.ttf "$ft"/fonts/*.otf; do
                [ -e "$f" ] || continue
                cp "$f" "$font_dir"/ 2>/dev/null && copied=1
            done
            if [ "$copied" = 1 ]; then
                command -v fc-cache >/dev/null 2>&1 && fc-cache -f "$font_dir" >/dev/null 2>&1
                log "  installed $nerdfont_asset"
            else
                warn "  downloaded but could not place $nerdfont_asset font files"
            fi
        else
            warn "  could not download $nerdfont_asset"
        fi
        rm -rf "$ft"
    fi
fi

# --- missing check ---
missing=""
for n in $names; do
    [ "$n" = "nerd-font" ] && continue
    b="$(bin_for "$n")"
    command -v "$b" >/dev/null 2>&1 || missing="$missing $b"
done
if [ -n "$missing" ]; then
    warn "Still missing:$missing"
    warn "Install these manually, or use Homebrew and re-run: chezmoi apply"
else
    log "All tools present."
fi
