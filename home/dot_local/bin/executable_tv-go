#!/bin/sh
# tv-go — F8, F7, F9 and F3: pick a channel, then a row in it.
#
#   tv-go act         (F8) act on the row: open a file or a match below this
#                     pane, cd to a directory in a new pane, apply a theme or
#                     font; anything else lands on a new prompt, unrun
#   tv-go type        (F7) type the row into this pane, whatever the channel
#   tv-go act theme   (F9) skip the channel step
#   tv-go find QUERY  (F3) F8 with QUERY already typed into the row list
#
# The pane is TV_ALL_ORIGIN and the client TV_ALL_CLIENT, named by the
# binding: tv-go runs in its own window (`modal`), not the pane it acts on.
# manual → internals/tmux, "F8 / F7".
#
# fzf, not tv 0.15.9, for three steps: accept the channel once one is left
# (`one:accept`), re-run a look preview on every focus (tv caches it, #969),
# and re-list F5 s s's panes on every keystroke (tv filters only what it shows).
# A look preview paints only the row you stop on — per-row retints flickered:
# it sleeps 0.15 s, then asks fzf over --listen whether its row still has focus.
#
# TRAP: no `2>/dev/null` on a tv call — with stdout captured, tv draws the
# whole UI on stderr, and silencing it blanks the picker.
set -u
ORIGIN=${TV_ALL_ORIGIN:-}
mode=${1:-act} ch=${2:-} q=""
[ "$mode" = find ] && { mode=act ch="" q=$(shift; printf '%s' "$*"); }
# ANSI slots only, never hex, so fzf follows every retint for free.
export FZF_DEFAULT_OPTS="--reverse --border rounded --info inline-right \
 --color 16,fg:7,bg:-1,hl:4,fg+:15,bg+:8,hl+:4,border:8,label:7 \
 --color prompt:5,pointer:1,marker:2,info:8,header:8,spinner:6,preview-border:8"
LOOKS="$HOME/.config/tinted-theming/tinty/theme.sh"
FONT="$HOME/.config/wezterm/font.sh"

[ -n "$ch" ] || ch=$(tv list-channels | fzf --bind one:accept --prompt 'channel> ' \
    --header "${q:+“${q}” — }type until one is left, or enter; esc cancels")
[ -n "$ch" ] || exit 0
# limit=0: the reply holds no match list, so the only "text" is the focus.
still='sleep 0.15; case $(curl -s --max-time 1 "localhost:$FZF_PORT?limit=0") in *\"text\":\"{}\"*) ;; *) exit 0 ;; esac'
look() { fzf --listen --with-shell 'sh -c' --no-sort --prompt "$1> " --query "$q" \
             --preview "$still; $2 --preview {}" --preview-window right,65%; }
case $ch in
# F5 s s: fzf, because tv matches only the text it shows and cannot re-run
# its source per keystroke; each keystroke re-lists the panes whose name or
# content holds the query (rg over one capture per pane, taken at open).
# Enter swaps the pane into this one (tmux-slot, so F5 w b undoes it);
# Ctrl-D closes the focused pane, whatever runs in it, never the origin;
# Ctrl-X closes the listed panes that sit at a bare shell prompt; Tab
# toggles the backlog, panes untouched for 1 h+.
panes)
    snap=$(mktemp -d); tmux-panes snap "$snap"
    row=$(tmux-panes list "$snap" | fzf --with-shell 'sh -c' --ansi --disabled --prompt 'sessions> ' \
        --delimiter '\t' --with-nth 2 --bind "change:reload:tmux-panes list '$snap' {q}" \
        --bind "ctrl-d:execute-silent([ {1} = '$ORIGIN' ] || tmux kill-pane -t {1})+reload(tmux-panes list '$snap' {q})" \
        --bind "ctrl-x:execute-silent(tmux-panes close '$snap' {q})+reload(tmux-panes list '$snap' {q})" \
        --bind "tab:transform:case \$FZF_PROMPT in backlog*) p=sessions ;; *) p=backlog ;; esac; echo \"change-prompt(\$p> )+reload(FZF_PROMPT='\$p> ' tmux-panes list '$snap' {q})\"" \
        --header 'enter swap · tab backlog · ^d close · ^x close idle' \
        --preview 'tmux capture-pane -p -e -t {1}' --preview-window right,60%,follow)
    rm -rf "$snap"
    [ -z "$row" ] || tmux-slot swap "$ORIGIN" "$(printf '%s' "$row" | cut -f1)"
    exit 0 ;;
theme) row=$("$LOOKS" --list | look theme "$LOOKS") ;;
font)  row=$("$FONT" --list | look font "$FONT") ;;
# Enter returns the row: several channels bind it to an action of their own
# (text opens nvim, git-stash applies), which would run inside the picker.
*)     row=$(tv "$ch" --no-remote --keybindings 'enter="confirm_selection"' \
           ${q:+--input "$q"} | head -1) ;;
esac

# theme and font preview by side effect: settle it whether or not a row came
# back, so Esc and F7 both leave the current look on screen.
case $ch in
theme) if [ -n "$row" ] && [ "$mode" = act ]; then "$LOOKS" --apply "$row"; else "$LOOKS"; fi ;;
font)  if [ -n "$row" ] && [ "$mode" = act ]; then "$FONT" --apply "$row"; else "$FONT"; fi ;;
esac
[ -n "$row" ] || exit 0
: "${ORIGIN:?tv-go: set TV_ALL_ORIGIN}"
[ "$mode" = type ] && exec tmux send-keys -t "$ORIGIN" -l "$row"

# ── act: picks land in a new pane BELOW the origin ──────────────────────────
# Things you look AT open; things that CHANGE something land on a prompt unrun.
# Single quotes inside a single-quoted shell word.
_q() { printf '%s' "$1" | sed "s/'/'\\\\''/g"; }
# Rows become absolute: the new pane starts in $PWD, so relative resolves twice.
# shellcheck disable=SC2088  # a literal "~/" from a row
case $row in "~/"*) row="$HOME/${row#\~/}" ;; esac

# TRAP: a full window refuses a split, and the picker window has closed —
# fall back to a new window or the key reads as doing nothing.
split() {
    _d=$1; shift
    tmux split-window -v -P -F '#{pane_id}' -t "$ORIGIN" -c "$_d" "$@" 2>/dev/null ||
        tmux new-window -P -F '#{pane_id}' -c "$_d" "$@" 2>/dev/null
}
# prefill DIR TEXT: a new pane in DIR with TEXT on its prompt, unrun.
# TRAP 1: splice `--execute "cd …"` into default-command, never type the cd:
# reedline drops keys that arrive while it runs a line. Splice, don't replace
# — default-command owns the XDG export, PATH lookup and fallback.
# TRAP 2: `stty -echo` — send-keys lands while the pane is still cooked, so
# without it the tty echoes the text and reedline draws it again.
prefill() {
    _dc=$(tmux show -gv default-command 2>/dev/null)
    [ -n "$_dc" ] || _dc="exec \"\${SHELL:-/bin/sh}\""
    _dc=$(printf '%s' "$_dc" | sed "s|exec nu |exec nu --execute \"cd '$(_q "$1")'\" |")
    _p=$(split "$1" "stty -echo; $_dc") || return 0
    [ -z "$2" ] || tmux send-keys -t "$_p" -l "$2"
}
edit() { split "$PWD" "\${EDITOR:-nvim} $1 -- '$(_q "$2")'" >/dev/null; }

case $ch in
theme|font) ;;
files|recent-files) edit "" "$row" ;;
text|docs)
    n=$(printf '%s' "$row" | cut -d: -f2); case $n in ''|*[!0-9]*) n=1 ;; esac
    edit "+$n" "${row%%:*}" ;;
dirs|recent-dirs|git-repos)
    # nu refuses a PWD with a trailing slash, and fd prints dirs with one.
    case $row in /*) ;; *) row="$PWD/$row" ;; esac; row=${row%/}
    prefill "$row" "" ;;
git-log) split "$PWD" "git show '$(_q "$row")'" >/dev/null ;;
*) prefill "$PWD" "$row" ;;
esac
