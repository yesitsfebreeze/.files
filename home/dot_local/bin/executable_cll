#!/usr/bin/env bash
# cll — Claude Code against the local LiteLLM proxy, or natively on the Max plan.
#
#   cll                    pick a model (fzf, grouped by provider)
#   cll opus-5             a proxied model, using its normal fallback chain
#   cll opus-5@openrouter  pin one provider hop
#   cll native:opus        Max plan — launched through cc's login picker
#   cll --list             model names, one per line
#   cll --catalog          JSON: name, providers, kind
#
# Switch mid-session with `/model <name>`; cll regenerates the picker list from
# the proxy on every launch. That choice persists into CLAUDE_CONFIG_DIR, which
# is why cll runs its own `litellm` profile — it must never rewrite the `model`
# field of the Max-plan ~/.claude/settings.json.
#
# Launches with --dangerously-skip-permissions, like `cc`/`cr`.
set -euo pipefail

. "$(dirname "$(command -v litellm-env)")/litellm-env"

CATALOG="$HOME/.local/state/litellm/catalog.json"
# Claude Code's own aliases, served by the Max plan rather than any provider.
NATIVE=(opus sonnet haiku fable)

catalog_json() {
  CLL_NATIVE="${NATIVE[*]}" python3 - "$CATALOG" <<'PY'
import json, os, sys
rows = []
for a in os.environ["CLL_NATIVE"].split():
    rows.append({"name": f"native:{a}", "providers": ["max-plan"], "kind": "native"})
try:
    cat = json.load(open(sys.argv[1]))
except Exception:
    cat = {}
for name, chain in cat.items():
    rows.append({"name": name, "providers": chain, "kind": "proxy"})
    for p in chain[1:]:
        rows.append({"name": f"{name}@{p}", "providers": [p], "kind": "pinned"})
print(json.dumps(rows))
PY
}

# Names only. The reader (a completer, `head`) may close the pipe early, and an
# unguarded print then dies with BrokenPipeError noise on stderr — so the JSON
# is decoded in one process that swallows EPIPE rather than piped between two.
names_only() {
  catalog_json | python3 -c '
import sys, json
try:
    for r in json.load(sys.stdin):
        print(r["name"])
    sys.stdout.flush()
except BrokenPipeError:
    pass
except Exception:
    sys.exit(1)
' 2>/dev/null
}

# Picker rows, grouped by the provider that serves each model first, with the
# remaining balance alongside — a model is only as usable as the credit behind
# it. Emitted as TAB-separated fields for fzf; see the --nth flags at the call.
picker_rows() {
  CLL_ROWS="$(catalog_json)" CLL_QUOTA="$(llm-quota --json 2>/dev/null || echo '{}')" python3 <<'PY'
import json, os
rows = json.loads(os.environ["CLL_ROWS"])
quota = json.loads(os.environ["CLL_QUOTA"] or "{}")

def left(prov):
    if prov == "max-plan":
        return "plan"
    e = quota.get(prov)
    if not e:
        return "?"
    if e.get("unit") == "free":
        return "free"
    r = e.get("remaining")
    return "?" if r is None else f"{r:,.2f}"

groups, order = {}, []
for r in rows:
    p = r["providers"][0]
    if p not in order:
        order.append(p); groups[p] = []
    groups[p].append(r)

DIM, CYAN, RESET = "\033[2m", "\033[36m", "\033[0m"
width = max((len(r["name"]) for r in rows), default=20) + 2
pwidth = max((len(p) for p in order), default=8) + 1

# Every row carries its OWN provider column, not just the group header above
# it. fzf drops non-matching lines, so a header cannot stay pinned over its
# group once you type — filtering to "opus" would otherwise leave a column of
# models with no way to tell which router each came from. The header gives the
# shape at rest; the column is what survives a query.
for p in order:
    bal = left(p)
    rule = "─" * max(4, width + pwidth - len(p) - len(bal))
    print(f"__hdr__\t{DIM}── {p} {rule} {bal}{RESET}\t")
    for r in groups[p]:
        chain = " → ".join(r["providers"][1:])
        tail = f"{DIM}↳ {chain}{RESET}" if chain else ""
        print(f"{r['name']}\t{CYAN}{p:<{pwidth}}{RESET} {r['name']:<{width}}\t{tail}")
PY
}

case "${1:-}" in
  --catalog) catalog_json; exit 0 ;;
  --list)    names_only; exit 0 ;;
  --rows)    picker_rows; exit 0 ;;
esac

MODEL=""
if [ $# -gt 0 ] && [ "$1" != "--" ] && [[ "$1" != -* ]]; then
  MODEL="$1"; shift
fi
[ "${1:-}" = "--" ] && shift

if [ -z "$MODEL" ]; then
  if command -v fzf >/dev/null 2>&1; then
    # Rows are TAB-separated: key, padded model name, fallback chain.
    #
    # --nth=1 NOT =2, and the reason is not obvious: --with-nth re-indexes the
    # fields, so --nth counts against the TRANSFORMED line, where the name is
    # field 1 and the chain field 2 — the key is already gone. Measured on fzf
    # 0.74.3: with --nth=2, `opus` matched nothing at all, because it was
    # searching the chain column. Searching field 1 alone is also what makes
    # group headers behave: their name column is a rule, so `opus` drops them
    # and `zenmux` keeps that one header — filter by model, or by group.
    #
    # --accept-nth=1 hands back the bare key. fzf has no unselectable row, so a
    # header's key is a sentinel and Enter on one simply re-opens the picker.
    while :; do
      MODEL="$(picker_rows | fzf --ansi --delimiter=$'\t' \
        --with-nth=2.. --nth=1 --accept-nth=1 \
        --height=70% --reverse --prompt='model> ' \
        --header='claude via litellm — grouped by provider; type to filter models')" || MODEL=""
      [ "$MODEL" = "__hdr__" ] || break
    done
  else
    # Plain `while read`, not `mapfile`: this machine's only bash is /bin/bash
    # 3.2 (macOS ships no newer one and no homebrew bash is installed), where
    # that builtin does not exist.
    NAMES=""
    while IFS= read -r line; do NAMES="$NAMES$line
"; done <<EOF
$(names_only)
EOF
    printf '%s' "$NAMES" | nl -w3 -s') '
    printf 'model number: '; read -r n
    MODEL="$(printf '%s' "$NAMES" | sed -n "${n}p")"
  fi
fi
[ -n "$MODEL" ] || { echo "cll: no model selected" >&2; exit 1; }

# --- native: Claude Code's own models on the Max plan, launched the way cc
# launches them — no proxy in the way, and no proxy env inherited either.
if [[ "$MODEL" == native:* ]]; then
  M="${MODEL#native:}"
  # "No proxy" must mean no proxy: unset, not merely don't-set. Launched from
  # inside a cll session the parent exports ANTHROPIC_BASE_URL/AUTH_TOKEN, and
  # an inherited pair would route this "native" hop through the proxy anyway.
  unset ANTHROPIC_BASE_URL ANTHROPIC_AUTH_TOKEN ANTHROPIC_API_KEY \
        ANTHROPIC_MODEL ANTHROPIC_SMALL_FAST_MODEL ANTHROPIC_DEFAULT_HAIKU_MODEL

  if [ -t 0 ] && command -v nu >/dev/null 2>&1; then
    # Interactive: this is cc's job. Its login picker chooses the profile and
    # _claude_run supplies the --dangerously-skip-permissions launch, so a
    # native hop behaves exactly like `cc --model <m>` — one implementation
    # of "launch Claude on a login", not a second one here. Args travel via
    # the environment as JSON: splicing argv into a nu command string would
    # be a quoting bug waiting for the first space.
    echo "cll: $M — max plan, via cc (login picker)" >&2
    export CLL_NATIVE_MODEL="$M"
    if [ $# -gt 0 ]; then
      export CLL_NATIVE_ARGS="$(printf '%s\0' "$@" | python3 -c '
import json, sys
print(json.dumps(sys.stdin.buffer.read().decode("utf-8", "surrogateescape").split("\0")[:-1]))
')"
    else
      export CLL_NATIVE_ARGS="[]"
    fi
    exec nu -c 'source ~/.config/nushell/config.nu
      cc ...([--model, $env.CLL_NATIVE_MODEL] ++ ($env.CLL_NATIVE_ARGS? | default "[]" | from json))'
  fi

  # No TTY (scripted) or no nu: cc's picker cannot run — `input list` without
  # a terminal errors out. Resolve the login the way its picker would have
  # offered: an inherited profile that is actually logged in, else the last
  # one cc recorded, else the default ~/.claude.
  d="${CLAUDE_CONFIG_DIR:-}"
  if [ -z "$d" ] || ! grep -q '"oauthAccount"' "$d/.claude.json" 2>/dev/null; then
    d=""
    LAST="$(cat "$HOME/.claude/.last-login" 2>/dev/null || true)"
    if [ -n "$LAST" ] && [ "$LAST" != "default" ] && \
       grep -q '"oauthAccount"' "$HOME/.claude/$LAST/.claude.json" 2>/dev/null; then
      d="$HOME/.claude/$LAST"
    fi
  fi
  if [ -n "$d" ]; then export CLAUDE_CONFIG_DIR="$d"; else unset CLAUDE_CONFIG_DIR; fi
  echo "cll: $M — max plan${d:+ ($d)}" >&2
  exec claude --model "$M" --dangerously-skip-permissions "$@"
fi

if ! curl -sf --max-time 2 "$LITELLM_BASE/health/liveliness" >/dev/null 2>&1; then
  echo "cll: LiteLLM proxy is not running on ${LITELLM_BASE#http://} — start it with: litellm-up" >&2
  exit 1
fi

# --- proxied: its own login profile, so /model can't leak into the Max config -
ROOT="$HOME/.claude"; PROFILE="$ROOT/litellm"
mkdir -p "$PROFILE"
for item in plugins projects sessions session-env history.jsonl cache file-history \
            shell-snapshots agent-memory hooks hub jobs plans backups paste-cache \
            context-mode debug tasks teams telemetry; do
  [ -e "$ROOT/$item" ] && [ ! -e "$PROFILE/$item" ] && ln -s "$ROOT/$item" "$PROFILE/$item"
done
for f in .claude.json settings.json settings.local.json; do
  [ -f "$ROOT/$f" ] && [ ! -f "$PROFILE/$f" ] && cp "$ROOT/$f" "$PROFILE/$f"
done
[ -f "$PROFILE/settings.json" ] || echo '{}' > "$PROFILE/settings.json"

# Rebuild /model's list from the catalog so runtime switching offers the same
# names as the launch picker. Only `modelPicker` is touched — the `model` key
# /model writes, and every other setting, is preserved.
CLL_ROWS="$(catalog_json)" python3 - "$PROFILE/settings.json" <<'PY'
import json, os, sys
rows = json.loads(os.environ["CLL_ROWS"])
path = sys.argv[1]
try:
    s = json.load(open(path))
except Exception:
    s = {}
opts = []
for r in rows:
    if r["kind"] == "native":
        continue  # the Max-plan models aren't reachable through the proxy
    opts.append({"model": r["name"], "label": r["name"],
                 "description": " → ".join(r["providers"])})
s["modelPicker"] = {"options": opts, "replaceBuiltInOptions": True}
json.dump(s, open(path, "w"), indent=2)
PY

export CLAUDE_CONFIG_DIR="$PROFILE"
export ANTHROPIC_BASE_URL="$LITELLM_BASE"
export ANTHROPIC_AUTH_TOKEN="$LITELLM_MASTER_KEY"
export ANTHROPIC_MODEL="$MODEL"
export ANTHROPIC_SMALL_FAST_MODEL="${CLL_SMALL_MODEL:-claude-haiku-4-5-20251001}"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="$ANTHROPIC_SMALL_FAST_MODEL"
unset ANTHROPIC_API_KEY

echo "cll: $MODEL via litellm" >&2
exec claude --dangerously-skip-permissions "$@"
