#!/bin/bash
# grid — F5: burrito's picker, drawn over tmux. Windows 1-9 are a 3x3 grid
# of tiles, each a live snapshot of that window, addressed by the left hand:
#
#   l w d      1 2 3
#   r s t  =   4 5 6
#   x c v      7 8 9
#
# A tile key lands on that window, creating it at ~ if empty; onto a window
# with more than one pane the grid stays open for a pane digit. A digit picks
# that pane of the current window. The key of the window or pane you are
# already on toggles its zoom. Arrows walk panes and keep the grid open;
# Shift+arrow splits, Ctrl+arrow carries the pane (tmux's `pane-move`), `q`
# closes it, a second F5 is the cockpit, Escape closes. tmux does every
# split and move — this only draws and reads keys.
#
#   grid CLIENT PANE WIDTH HEIGHT            (F5)
#   grid --pick CLIENT PANE W H OUT          (inside the popup)
#
# manual → internals/tmux, "F5 — the grid".
set -u
keys=lwdrstxcv

# One synchronized frame, W x H inside the popup's border.
draw() {
    local W=$1 H=$2 tw th sid act wins buf r c i x y n l name
    tw=$(((W - 2) / 3)) th=$(((H - 3) / 3))
    sid=$(tmux display -p -t "$pane" '#{session_id}')
    act=$(tmux display -p -t "$pane" '#{window_index}')
    # `display -t` on a missing window falls back to another one, so the
    # names come from one listing: `|index name|` per window.
    wins="|$(tmux list-windows -t "$sid" -F '#{window_index} #{window_name}' | tr '\n' '|')"
    buf=$'\e[?2026h\e[?25l\e[H\e[2J\e[1;2H\e[1mburrito\e[0;90m  panes'
    while read -r n l; do
        [ "$l" = 1 ] && buf+=$'\e[0;1;7;34m'" $n "$'\e[0m' || buf+=" $n "
    done < <(tmux list-panes -t "$pane" -F '#{pane_index} #{pane_active}')
    for i in 1 2 3 4 5 6 7 8 9; do
        r=$(((i - 1) / 3)) c=$(((i - 1) % 3))
        y=$((2 + r * th)) x=$((1 + c * (tw + 1)))
        name=""
        case $wins in *"|$i "*) name=${wins#*"|$i "} name=${name%%|*} ;; esac
        if [ "$i" = "$act" ]; then
            buf+=$'\e['"$y;${x}H"$'\e[1;7;34m'" ${keys:i-1:1} "$'\e[0;34m'" $i $name"$'\e[0m'
        else
            buf+=$'\e['"$y;${x}H"$'\e[1;34m'" ${keys:i-1:1} "$'\e[0;90m'" $i $name"$'\e[0m'
        fi
        if [ -z "$name" ]; then
            buf+=$'\e['"$((y + th / 2));$((x + tw / 2 - 2))H"$'\e[90midle\e[0m'
        else
            # ponytail: a double-width glyph overruns its tile by a column;
            # the separators are drawn after and cover most of it.
            n=0
            while IFS= read -r l && [ "$n" -lt $((th - 2)) ]; do
                n=$((n + 1))
                buf+=$'\e['"$((y + n));${x}H${l:0:tw}"
            done < <(tmux capture-pane -p -t "$sid:$i" 2>/dev/null)
        fi
    done
    # burrito's borders: full-height columns, half-width rules between rows.
    for ((y = 2; y <= H - 1; y++)); do
        buf+=$'\e[90m\e['"$y;$((tw + 1))H│"$'\e['"$y;$((2 * tw + 2))H│"
    done
    l=$(printf '%*s' $((tw / 2)) '' | sed 's/ /─/g')
    for r in 1 2; do
        for c in 0 1 2; do
            buf+=$'\e['"$((1 + r * th));$((1 + c * (tw + 1) + tw / 4))H$l"
        done
    done
    buf+=$'\e['"$H;2H"'lwd rst xcv window · 1-9 pane · again zoom · ←↑↓→ walk · shift split · ctrl carry · q close · F5 cockpit · esc'
    printf '%s\e[0m\e[?2026l' "$buf"
}

if [ "${1-}" = --pick ]; then
    client=$2 pane=$3 out=$6
    run() { tmux if -F -t "$pane" 1 "$(tmux display -p -t "$pane" "$1")"; }
    while :; do
        draw "$4" "$5"
        IFS= read -rsn1 k || exit 0
        if [ "$k" = $'\e' ]; then
            # The rest of an escape sequence arrives in the same write; a
            # lone Escape times out after 0.1 s and closes. (bash 3.2's
            # `read -t` takes whole seconds only.)
            s=$(stty -g); stty -icanon min 0 time 1; k=$(dd bs=8 count=1 2>/dev/null); stty "$s"
        fi
        case $k in
        '') exit 0 ;;
        '[A' | OA) run 'select-pane -U' ;;
        '[B' | OB) run 'select-pane -D' ;;
        '[C' | OC) run 'select-pane -R' ;;
        '[D' | OD) run 'select-pane -L' ;;
        '[1;2A') run 'split-window -vb -c "#{E:@cwd}"'; exit 0 ;;
        '[1;2B') run 'split-window -v -c "#{E:@cwd}"'; exit 0 ;;
        '[1;2C') run 'split-window -h -c "#{E:@cwd}"'; exit 0 ;;
        '[1;2D') run 'split-window -hb -c "#{E:@cwd}"'; exit 0 ;;
        '[1;5A') run "swap-pane -d -t '{up-of}' ; switch-client -c '$client' -T pane-move"; exit 0 ;;
        '[1;5B') run "swap-pane -d -t '{down-of}' ; switch-client -c '$client' -T pane-move"; exit 0 ;;
        '[1;5C') run "swap-pane -d -t '{right-of}' ; switch-client -c '$client' -T pane-move"; exit 0 ;;
        '[1;5D') run "swap-pane -d -t '{left-of}' ; switch-client -c '$client' -T pane-move"; exit 0 ;;
        '[15~') printf cockpit > "$out"; exit 0 ;;
        q) tmux kill-pane -t "$pane"; exit 0 ;;
        [1-9])
            [ "$k" = "$(tmux display -p -t "$pane" '#{pane_index}')" ] && { tmux resize-pane -Z -t "$pane"; exit 0; }
            tmux select-pane -t "$(tmux display -p -t "$pane" '#{window_id}').$k" 2>/dev/null && exit 0 ;;
        [lwdrstxcv])
            i=${keys%%"$k"*} i=$((${#i} + 1))
            [ "$i" = "$(tmux display -p -t "$pane" '#{window_index}')" ] && { tmux resize-pane -Z -t "$pane"; exit 0; }
            sid=$(tmux display -p -t "$pane" '#{session_id}')
            tmux select-window -t "$sid:$i" 2>/dev/null || tmux new-window -t "$sid:$i" -c "$HOME"
            [ "$(tmux display -p -t "$sid:$i" '#{window_panes}')" = 1 ] && exit 0
            pane=$(tmux display -p -t "$sid:$i" '#{pane_id}') ;;
        esac
        # A walk moved focus: follow it to the window's active pane.
        pane=$(tmux display -p -t "$(tmux display -p -t "$pane" '#{window_id}')" '#{pane_id}')
    done
fi

client=$1 pane=$2
w=$(($3 * 90 / 100)) h=$(($4 * 85 / 100)) out=$(mktemp)
tmux display-popup -c "$client" -E -b rounded -S fg=colour8 -w "$w" -h "$h" -x C -y C \
    "bash '$0' --pick '$client' '$pane' $((w - 2)) $((h - 2)) '$out'"
next=$(cat "$out"); rm -f "$out"
[ "$next" = cockpit ] || exit 0
exec ~/.local/bin/cockpit "$client" "$(tmux display -p -c "$client" '#{pane_id}')" "$3" "$4"
