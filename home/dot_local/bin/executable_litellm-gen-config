#!/usr/bin/env python3
"""Generate ~/.config/litellm/config.yaml from live provider inventories.

Provider order per alias is the fallback chain: cheapest/most-funded first.
Only deployments the provider actually serves are emitted.
"""
import json, os, urllib.request, sys

HOME = os.path.expanduser("~")
auth = json.load(open(f"{HOME}/.pi/agent/auth.json"))
key = lambda p: (auth.get(p) or {}).get("key") or (auth.get(p) or {}).get("access") or ""

PROVIDERS = {
    # name: (base_url, env var, litellm prefix style)
    "ollama":      ("http://127.0.0.1:11434/v1", None),
    "zenmux":      ("https://zenmux.ai/api/v1", "ZENMUX_API_KEY"),
    "opencode":    ("https://opencode.ai/zen/v1", "OPENCODE_API_KEY"),
    "opencode-go": ("https://opencode.ai/zen/go/v1", "OPENCODE_GO_API_KEY"),
    "openrouter":  ("https://openrouter.ai/api/v1", "OPENROUTER_API_KEY"),
}
# Preference order — zenmux is funded, openrouter is spent, ollama is free but weak.
ORDER = ["zenmux", "opencode", "opencode-go", "openrouter"]

def fetch(url, k):
    """Model ids of a provider, with the context window each publishes
    ({context_length, max_completion_tokens} — None where absent)."""
    try:
        r = urllib.request.Request(url + "/models", headers={"Authorization": "Bearer " + k})
        got = {}
        for m in json.load(urllib.request.urlopen(r, timeout=25))["data"]:
            mx = m.get("max_completion_tokens")
            if mx is None:
                mx = (m.get("top_provider") or {}).get("max_completion_tokens")
            got[m["id"]] = {"context": m.get("context_length"), "max": mx}
        return got
    except Exception as e:
        print(f"  ! {url}: {e}", file=sys.stderr)
        return {}

def ollama_ctx(name):
    """Trained window from the GGUF metadata (/api/show → `llama.context_length`
    and friends). The USEABLE window is num_ctx: the daemon serves at its own
    default (or OLLAMA_CONTEXT_LENGTH) unless the Modelfile sets num_ctx, and it
    silently truncates rather than erroring when a request overstays — so a
    trained max with no num_ctx is an upper bound the server may not honour.
    Callers record the distinction instead of passing a bound off as a promise."""
    try:
        req = urllib.request.Request(
            "http://127.0.0.1:11434/api/show",
            data=json.dumps({"model": name}).encode(),
            headers={"Content-Type": "application/json"})
        d = json.load(urllib.request.urlopen(req, timeout=10))
        lens = [v for k, v in d.get("model_info", {}).items()
                if k.endswith(".context_length")]
        params = d.get("model_info", {}).get("general.parameter_count")
        p = d.get("parameters") or ""
        nums = [int(t.split()[1]) for t in p.splitlines() if t.startswith("num_ctx ")]
        if nums:
            return {"context": min(nums), "max": None, "kind": "num_ctx",
                    "params": params}
        return {"context": min(lens) if lens else None, "max": None,
                "kind": "trained", "params": params}
    except Exception:
        return {"context": None, "max": None}

avail = {}
# Context windows per provider, {provider: {model id: {context, max}}}. Every
# client downstream of this generator used to carry a flat 200000/64000 for
# every route (hardcoded in the pi models.json write below), which silently
# under-windowed the 1M models and over-promised the 131K ones.
ctx = {}
for p in ("zenmux", "openrouter"):
    got = fetch(PROVIDERS[p][0], key(p))
    avail[p] = set(got)
    ctx[p] = got
store = json.load(open(f"{HOME}/.pi/agent/models-store.json"))
for p in ("opencode", "opencode-go"):
    models = store.get(p, {}).get("models", [])
    avail[p] = {m["id"] for m in models}
    # The store already rates context per model — read it, don't re-fetch.
    ctx[p] = {m["id"]: {"context": m.get("contextWindow"), "max": m.get("maxTokens")}
              for m in models}
try:
    tags = json.load(urllib.request.urlopen("http://127.0.0.1:11434/api/tags", timeout=5))
    avail["ollama"] = {m["name"] for m in tags["models"]}
    ctx["ollama"] = {m["name"]: ollama_ctx(m["name"])
                     for m in tags["models"] if "embed" not in m["name"]}
except Exception:
    avail["ollama"] = set()

for p in ORDER + ["ollama"]:
    print(f"  {p}: {len(avail[p])} models", file=sys.stderr)

# alias -> {provider: model id as that provider names it}
def A(vendor, name, oc=None, go=None, ol=None):
    d = {"zenmux": f"{vendor}/{name}", "openrouter": f"{vendor}/{name}"}
    if oc: d["opencode"] = oc
    if go: d["opencode-go"] = go
    if ol: d["ollama"] = ol
    return d

ALIASES = {
    # Anthropic
    "opus-5":        A("anthropic", "claude-opus-5",   oc="claude-opus-5"),
    "opus-4.8":      A("anthropic", "claude-opus-4.8", oc="claude-opus-4-8"),
    "sonnet-5":      A("anthropic", "claude-sonnet-5", oc="claude-sonnet-5"),
    "haiku-4.5":     A("anthropic", "claude-haiku-4.5", oc="claude-haiku-4-5"),
    "fable-5":       A("anthropic", "claude-fable-5",  oc="claude-fable-5"),
    # OpenAI
    "gpt-5.6-sol":   A("openai", "gpt-5.6-sol",   oc="gpt-5.6-sol"),
    "gpt-5.6-luna":  A("openai", "gpt-5.6-luna",  oc="gpt-5.6-luna", go="gpt-5.6-luna"),
    "gpt-5.5":       A("openai", "gpt-5.5",       oc="gpt-5.5"),
    "gpt-5.5-pro":   A("openai", "gpt-5.5-pro",   oc="gpt-5.5-pro"),
    "gpt-5.3-codex": A("openai", "gpt-5.3-codex", oc="gpt-5.3-codex"),
    "gpt-5.4-mini":  A("openai", "gpt-5.4-mini",  oc="gpt-5.4-mini"),
    # Google
    "gemini-3.1-pro":   {"zenmux": "google/gemini-3.1-pro-preview",
                         "openrouter": "google/gemini-3.1-pro-preview",
                         "opencode": "gemini-3.1-pro"},
    "gemini-3.7-flash": A("google", "gemini-3.7-flash", oc="gemini-3.7-flash"),
    # Open weights
    "kimi-k3":         A("moonshotai", "kimi-k3", go="kimi-k3"),
    "kimi-k2.7-code":  A("moonshotai", "kimi-k2.7-code", go="kimi-k2.7-code"),
    "glm-5.3":         A("z-ai", "glm-5.3", go="glm-5.3"),
    "glm-5.2":         A("z-ai", "glm-5.2", oc="glm-5.2", go="glm-5.2"),
    "deepseek-v4-pro": A("deepseek", "deepseek-v4-pro", oc="deepseek-v4-pro", go="deepseek-v4-pro"),
    "qwen3-max":       A("qwen", "qwen3-max"),
}

# Ollama is enumerated, not hand-listed: it serves BOTH local weights and
# ollama.com cloud models (a `:cloud` tag — deepseek-v4-flash:cloud is 304B),
# and the set changes whenever something is pulled. Embedding models are not
# chat models, so they are excluded rather than offered as broken routes.
for _name in sorted(avail.get("ollama", set())):
    if "embed" in _name:
        continue
    _alias = _name.replace(":", "-")
    if _alias not in ALIASES:
        ALIASES[_alias] = {"ollama": _name}
# Canonical Anthropic ids so Claude Code reads the right context window.
CANONICAL = {
    "claude-opus-5": "opus-5", "claude-sonnet-5": "sonnet-5",
    "claude-haiku-4-5-20251001": "haiku-4.5", "claude-fable-5": "fable-5",
}

def deployment(prov, model_id, indent="      "):
    base, envvar = PROVIDERS[prov]
    if prov == "openrouter":
        m, extra = f"openrouter/{model_id}", ""
    else:
        m, extra = f"openai/{model_id}", f", api_base: {base}"
    k = f", api_key: os.environ/{envvar}" if envvar else ", api_key: ollama"
    # Claude Code always sends `thinking`. A small local ollama model rejects it
    # outright ("does not support thinking", measured on granite4:3b) and the
    # global drop_params does not cover it — the param is valid upstream, it is
    # the DEPLOYMENT that can't take it. Cloud models are the other way round:
    # deepseek-v4-flash:cloud answered a reasoning_effort request with a
    # populated `reasoning` field (measured 2026-08-25), so dropping there would
    # throw away the capability. Hence local-only.
    local_ollama = prov == "ollama" and not model_id.endswith(":cloud")
    drop = ', additional_drop_params: ["thinking", "reasoning_effort"]' if local_ollama else ""
    return f"{{ model: {m}{extra}{k}{drop} }}"

lines = ["# GENERATED by scripts/gen-litellm-config.py — regenerate, don't hand-edit.",
         "# Chain per alias is the fallback order; `<alias>@<provider>` pins one hop.",
         "", "model_list:"]
fallbacks, catalog = [], {}

for alias, m in ALIASES.items():
    chain = [p for p in ORDER + ["ollama"] if p in m and m[p] in avail.get(p, set())]
    if not chain:
        print(f"  ~ {alias}: no provider serves it, skipped", file=sys.stderr)
        continue
    catalog[alias] = chain
    primary = chain[0]
    lines.append(f"  - model_name: {alias}")
    lines.append(f"    litellm_params: {deployment(primary, m[primary])}")
    for p in chain[1:]:
        lines.append(f"  - model_name: {alias}@{p}")
        lines.append(f"    litellm_params: {deployment(p, m[p])}")
    if len(chain) > 1:
        fallbacks.append((alias, [f"{alias}@{p}" for p in chain[1:]]))

for canon, alias in CANONICAL.items():
    if alias not in catalog:
        continue
    chain = catalog[alias]; p = chain[0]
    lines.append(f"  - model_name: {canon}")
    lines.append(f"    litellm_params: {deployment(p, ALIASES[alias][p])}")
    if len(chain) > 1:
        fallbacks.append((canon, [f"{alias}@{q}" for q in chain[1:]]))
    catalog[canon] = chain

# --- Per-route context windows, from the first provider in each chain that
# publishes one. A pinned hop (`alias@provider`) keeps its base alias's number:
# it is a provider fix, not a different model, and the windows a provider
# reports for the same model agree where they overlap at all.
windows = {}
for alias in catalog:
    base = CANONICAL.get(alias, alias)   # canonical ids borrow their alias's data
    w, mx, src = None, None, "default"
    for p in catalog[alias]:
        mid = ALIASES.get(base, {}).get(p)
        v = ctx.get(p, {}).get(mid) or {}
        if v.get("context"):
            w = v["context"]
            mx = v.get("max")
            src = p if p != "ollama" else f"ollama {v.get('kind', '')}".strip()
            break
        # else: skip to the next hop (default 200000/64000, source labelled below)
    windows[alias] = {"context_window": w, "max_tokens": mx, "source": src}
    if src == "ollama trained":
        print(f"  ~ {alias}: {w} is the GGUF trained max, no num_ctx set — the"
              " daemon may serve less (it truncates silently)", file=sys.stderr)
os.makedirs(f"{HOME}/.local/state/litellm", exist_ok=True)
json.dump(windows, open(f"{HOME}/.local/state/litellm/contexts.json", "w"), indent=2)

# --- Free last resort, ranked from the live ollama inventory, not hardcoded.
# When every paid hop in a chain is spent (zenmux, opencode and openrouter all
# answered 402 no-credit on 2026-09-01) the chain's tail is a free ollama
# model, so the client degrades to free instead of failing. Which one is
# decided per job: heavy chains get the largest model the daemon knows
# (parameter_count from /api/show — cloud models report 0 bytes in /api/tags,
# so disk size cannot rank them), light chains (haiku/mini — titles, short
# background work) get the smallest non-embedding model for latency. The full
# ranking is written to state so the pick is auditable.
free_ranked = sorted(
    ((n, (ctx.get("ollama", {}).get(n) or {}).get("params") or 0)
     for n in avail.get("ollama", set()) if "embed" not in n),
    key=lambda kv: -kv[1])
alias_of = lambda n: n.replace(":", "-")
strongest = alias_of(free_ranked[0][0]) if free_ranked else None
fastest = alias_of(free_ranked[-1][0]) if free_ranked else None
light_job = lambda a: "haiku" in a or "mini" in a

if free_ranked:
    os.makedirs(f"{HOME}/.local/state/litellm", exist_ok=True)
    json.dump({"ranked": [[n, p] for n, p in free_ranked],
               "strongest": strongest, "fastest": fastest},
              open(f"{HOME}/.local/state/litellm/free-fallbacks.json", "w"), indent=2)

lines += ["", "litellm_settings:", "  drop_params: true", "  num_retries: 2",
          "  request_timeout: 600", "", "router_settings:", "  fallbacks:"]
for name, fb in fallbacks:
    pick = fastest if light_job(name) else strongest
    if pick and pick not in fb:
        fb = fb + [pick]
    lines.append(f"    - {name}: [{', '.join(fb)}]")
lines += ["", "general_settings:", "  master_key: os.environ/LITELLM_MASTER_KEY", ""]

open(f"{HOME}/.config/litellm/config.yaml", "w").write("\n".join(lines))
os.makedirs(f"{HOME}/.local/state/litellm", exist_ok=True)
json.dump(catalog, open(f"{HOME}/.local/state/litellm/catalog.json", "w"), indent=2)

# pi reaches the same routes through a `litellm` provider. Regenerated here so
# one catalogue drives both clients; the key is `!litellm-env`, never a copy.
pi_models = f"{HOME}/.pi/agent/models.json"
try:
    cfg = json.load(open(pi_models))
except Exception:
    cfg = {}
cfg.setdefault("providers", {})["litellm"] = {
    "name": "LiteLLM (local)",
    "baseUrl": "http://127.0.0.1:4000/v1",
    "api": "openai-completions",
    "apiKey": "!litellm-env",
    "models": [
        # No window resolved for an alias keeps the old flat 200000/64000 — but
        # `source: default` in contexts.json says that is what it is, so nothing
        # downstream can mistake the fallback for a measurement.
        {"id": a, "name": f"{a} ({' → '.join(c)})", "reasoning": True,
         "input": ["text", "image"],
         "contextWindow": (windows.get(a) or {}).get("context_window") or 200000,
         "maxTokens": (windows.get(a) or {}).get("max_tokens") or 64000,
         "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0}}
        for a, c in catalog.items()
    ],
}
# Write through a temp file in the same dir and rename: pi re-reads models.json
# on every /model open, and a plain truncate-and-write let it observe a
# half-written file (seen 2026-08-25 as "Failed to resolve API key"). rename(2)
# within one filesystem is atomic, so a concurrent reader sees old or new.
tmp = pi_models + ".tmp"
with open(tmp, "w") as fh:
    json.dump(cfg, fh, indent=2)
os.replace(tmp, pi_models)
print(f"  pi: {len(catalog)} models -> {pi_models}", file=sys.stderr)
print(f"\nwrote config.yaml: {len(catalog)} routes", file=sys.stderr)
for a, c in catalog.items():
    w = windows.get(a) or {}
    ws = f"{w['context_window']:,}" if w.get("context_window") else "200000 (default)"
    print(f"  {a:28} {' -> '.join(c):42} ctx {ws:14} [{w.get('source', 'default')}]",
          file=sys.stderr)
