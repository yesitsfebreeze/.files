#!/bin/sh
# tv-all — F3 (here) and Shift+F3 (everywhere): say WHAT, then say WHERE.
#
# Type what you are looking for. You get back the list of channels that have a
# hit on it, with counts — so the question "which channel is that in", which is
# exactly what you do not know when you are looking for something, is answered
# for you instead of being asked first. Type a channel name to narrow that
# list, Enter to enter it, and pick a row. If only one channel has a hit at
# all, there is nothing to choose and you go straight to its rows.
#
# Everywhere-mode is progressive, and that is the whole reason it is usable.
# Counting one query across $HOME costs 29-74s with ripgrep, which is dead as
# an interactive wait — but the lanes people actually navigate by (recent
# directories, recent files, shell history, aliases, the manual) all answer in
# under 0.2s. So the fast lanes land first and you can act on them immediately,
# while files, directories and file contents fill in behind them; tv's --watch
# redraws the list as each one arrives. If you only wanted to jump somewhere
# you have already been you never wait; if you are genuinely hunting, you let
# it run.
#
# POSIX sh, not nushell, for tmux-main's reason: this is launched by the tmux
# server, whose environment is not a login shell's, and it must not assume the
# process tree it is called from.
#
# Why any of this is shaped the way it is: manual → internals/tmux.

set -u

SELF=$(command -v "$0" 2>/dev/null || printf '%s' "$0")

XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
MANUAL="$XDG_CONFIG_HOME/nushell/help/manual"
CACHE="$XDG_CACHE_HOME/tv-all"

# Where "everywhere" reaches. $HOME is the honest reading of the word and the
# cache below is what makes it affordable; narrow it here, or export the
# variable, if a machine has a home directory worth avoiding.
GLOBAL_ROOT=${TV_ALL_GLOBAL_ROOT:-$HOME}

# How long a cached directory listing is served before a refresh is started
# behind it. The refresh never blocks a search — the stale list serves this
# query and the fresh one serves the next.
TREE_TTL_MIN=10

# The one search-ignore list, named rather than inherited. ~/.config/fd/ignore
# is what fd reads by itself; ripgrep only reaches it through
# RIPGREP_CONFIG_PATH, which env.nu exports and which therefore does not exist
# in the sh that tmux spawns.
IGNORE_FILE="$XDG_CONFIG_HOME/fd/ignore"
[ -f "$IGNORE_FILE" ] || IGNORE_FILE=""

# A SECOND ignore list, layered on the first and applied only to the home-wide
# search. It is what makes "everywhere" terminate at all: measured 2026-09-01,
# `fd -t f -H . ~` had not finished enumerating $HOME after two minutes, almost
# all of it ~/Library; with this list it returns 402,970 files in 2.2s and
# ripgrep answers a query in about 15s. It is deliberately NOT folded into
# ~/.config/fd/ignore, because that file governs what `fd` and `rg` do at a
# prompt and excluding Pictures/ there would be a surprise nobody asked for.
GLOBAL_IGNORE="$XDG_CONFIG_HOME/tv-all/ignore"
[ -f "$GLOBAL_IGNORE" ] || GLOBAL_IGNORE=""

# The ignore flags for a scope: both lists for the global root, the shared one
# for anywhere else.
_ig() {
    [ -n "$IGNORE_FILE" ] && printf -- '--ignore-file\n%s\n' "$IGNORE_FILE"
    [ "$1" = "$GLOBAL_ROOT" ] && [ -n "$GLOBAL_IGNORE" ] &&
        printf -- '--ignore-file\n%s\n' "$GLOBAL_IGNORE"
    return 0
}

# Lane order is display order, and it is fastest-first on purpose: the lanes
# that answer instantly sit at the top of the list while the slow ones are
# still counting, so the list is useful before it is complete.
LANES_FAST='recent-dir recent-file history alias env manual docs git-log git-branch'
LANES_SCOPED='files dirs text'

# ── helpers ─────────────────────────────────────────────────────────────────

_hash() { printf '%s' "$*" | cksum | tr -cd '0-9'; }

# Single quotes inside a single-quoted shell word.
_q() { printf '%s' "$1" | sed "s/'/'\\\\''/g"; }

# A leading ~ is not a path. The recents log stores values as it displayed them.
_expand() { case $1 in "~/"*) printf '%s' "$HOME/${1#\~/}" ;; *) printf '%s' "$1" ;; esac; }

# Every whitespace-separated term must appear, case-insensitively. Fixed
# strings, never patterns: a query is something a person typed at a prompt, and
# a stray `[` in it must narrow the list rather than fail the search.
_filter() {
    [ -n "${1:-}" ] || { cat; return; }
    _f_cmd='cat'
    for _f_t in $1; do _f_cmd="$_f_cmd | grep -iF -e '$(_q "$_f_t")'"; done
    eval "$_f_cmd"
}

# ── the directory-listing cache ─────────────────────────────────────────────
#
# Only the global root is cached. A repository answers `fd` in hundredths of a
# second, so caching it would buy nothing and could only ever be wrong; $HOME
# takes ~9s for its 905k files, which is worth keeping and worth serving stale.
_tree() {
    _t_scope=$1; _t_kind=$2
    # IFS=newline so the ignore flags split on lines and never on a space in a
    # path; restored immediately, because a global IFS is a trap for every
    # later expansion in this script.
    _t_ifs=$IFS; IFS='
'
    # shellcheck disable=SC2046
    set -- $(_ig "$_t_scope")
    IFS=$_t_ifs
    if [ "$_t_scope" != "$GLOBAL_ROOT" ]; then
        fd -t "$_t_kind" -H "$@" . "$_t_scope" 2>/dev/null
        return
    fi
    _t_f="$CACHE/tree-$(_hash "$_t_scope$_t_kind")"
    if [ -s "$_t_f" ]; then
        cat "$_t_f"
        # Stale-while-revalidate: this search gets the old list, the next one
        # gets the new. Blocking here would hand back the ~9s the cache exists
        # to avoid, on the one lane that is meant to be instant.
        if [ -n "$(find "$_t_f" -mmin +$TREE_TTL_MIN 2>/dev/null)" ] && [ ! -f "$_t_f.building" ]; then
            : > "$_t_f.building"
            nohup "$SELF" tree "$_t_scope" "$_t_kind" "$_t_f" >/dev/null 2>&1 &
        fi
    else
        fd -t "$_t_kind" -H "$@" . "$_t_scope" 2>/dev/null > "$_t_f.new"
        mv "$_t_f.new" "$_t_f" 2>/dev/null
        cat "$_t_f" 2>/dev/null
    fi
}

# ── the lanes ───────────────────────────────────────────────────────────────

_lane_rows() {
    _l=$1; _scope=$2; _lq=$3
    case $_l in
    recent-dir)
        {
            nu -n -c 'source ~/.config/nushell/dirstack.nu; _dirstack_list | str join (char nl)' 2>/dev/null
            zoxide query -l 2>/dev/null
        } | awk 'NF && !seen[$0]++' | _filter "$_lq" ;;
    recent-file)
        # The pick log, minus the directories — those are recent-dir's job, and
        # a row in two lanes is a row you have to dismiss twice.
        nu -n -c 'source ~/.config/nushell/dirstack.nu; source ~/.config/nushell/recents.nu; _recents_lines' 2>/dev/null \
            | awk -F'\t' '$1 != "DirList" && NF > 1 {print $2}' | awk 'NF && !seen[$0]++' | _filter "$_lq" ;;
    history)
        nu -n -c 'let db = ($nu.history-path | path dirname | path join history.sqlite3); if ($db | path exists) { open $db | query db "SELECT command_line FROM history GROUP BY command_line ORDER BY MAX(id) DESC" | get command_line | to text }' 2>/dev/null | _filter "$_lq" ;;
    alias)
        nu -n -c 'source ~/.config/nushell/config.nu; scope aliases | get name | str join (char nl)' 2>/dev/null | _filter "$_lq" ;;
    env)
        # Well-formed assignments only: a value holding a newline would
        # otherwise contribute rows with no KEY= on them.
        printenv 2>/dev/null | grep -E '^[A-Za-z_][A-Za-z0-9_]*=' | _filter "$_lq" ;;
    manual)
        nu -n -c 'source ~/.config/nushell/help.nu; _help_rows' 2>/dev/null \
            | awk -F'\t' 'NF>2 {printf "%s — %s\n", $2, $3}' | _filter "$_lq" ;;
    docs)
        # Paths stay relative to $MANUAL so the rows read as manual pages
        # rather than as a home directory; the opener puts the prefix back.
        ( cd "$MANUAL" 2>/dev/null && rg . ./ --no-heading --line-number --hidden 2>/dev/null ) | _filter "$_lq" ;;
    git-log)
        # TRAP: `git log` without --no-pager blocks forever on `less` when
        # stdout is a pipe with no tty, and the lane never finishes. tformat,
        # not format: `format` omits the trailing newline.
        git --no-pager log --pretty=tformat:'%h %s' --abbrev-commit 2>/dev/null | _filter "$_lq" ;;
    git-branch)
        git --no-pager branch --all --format='%(refname:short)' 2>/dev/null | _filter "$_lq" ;;
    files)
        _tree "$_scope" f | _filter "$_lq" ;;
    dirs)
        _tree "$_scope" d | _filter "$_lq" ;;
    text)
        _text "$_scope" "$_lq" ;;
    esac
}

# The background half of _tree's stale-while-revalidate. A subcommand rather
# than an inline `sh -c`, because the ignore flags and the scope would otherwise
# have to survive three levels of quoting to get there.
tree_rebuild() {
    _r_scope=$1; _r_kind=$2; _r_f=$3
    _r_ifs=$IFS; IFS='
'
    # shellcheck disable=SC2046
    set -- $(_ig "$_r_scope")
    IFS=$_r_ifs
    fd -t "$_r_kind" -H "$@" . "$_r_scope" 2>/dev/null > "$_r_f.new" &&
        mv "$_r_f.new" "$_r_f" 2>/dev/null
    rm -f "$_r_f.building" "$_r_f.new" 2>/dev/null
    return 0
}

_text() {
    _x_scope=$1; _x_q=$2
    _x_first=$(printf '%s' "$_x_q" | awk '{print $1}')
    [ -n "$_x_first" ] || return 0
    _x_rest=$(printf '%s' "$_x_q" | sed 's/^[^ ][^ ]*[ ]*//')
    # ripgrep does the first term and the filter does the rest. Searching FOR
    # the term rather than listing every line is the whole difference between
    # three seconds and materialising 4.2M rows, and the reason "everywhere" is
    # possible at all.
    #
    # TRAP: the explicit path is not decoration and its absence is not a slow
    # search, it is a HANG. Given no PATH, ripgrep searches the current
    # directory only when stdin is a terminal; when stdin is a pipe it searches
    # STDIN, which here nobody ever writes to or closes.
    _x_ifs=$IFS; IFS='
'
    # shellcheck disable=SC2046
    set -- $(_ig "$_x_scope")
    IFS=$_x_ifs
    rg -i --fixed-strings --no-heading --line-number --hidden "$@" --glob '!.git/*' \
        -e "$_x_first" "$_x_scope" 2>/dev/null | _filter "$_x_rest"
}

# ── the scan ────────────────────────────────────────────────────────────────
#
# One file per lane in the query's directory. Each is written to `.new` and
# moved into place, so a reader can never see half a lane: the file is absent
# (still searching) or complete, and never partial.

scan() {
    _s_dir=$1; _s_scope=$2; _s_q=$3
    for _s_l in $LANES_FAST $LANES_SCOPED; do
        _lane_rows "$_s_l" "$_s_scope" "$_s_q" > "$_s_dir/$_s_l.new" 2>/dev/null
        mv "$_s_dir/$_s_l.new" "$_s_dir/$_s_l" 2>/dev/null
    done
    : > "$_s_dir/.done"
}

counts() {
    _c_dir=$1
    for _c_l in $LANES_FAST $LANES_SCOPED; do
        if [ -f "$_c_dir/$_c_l" ]; then
            _c_n=$(wc -l < "$_c_dir/$_c_l" 2>/dev/null | tr -d ' ')
            [ "${_c_n:-0}" -gt 0 ] && printf '%-12s%s hits\n' "$_c_l" "$_c_n"
        else
            printf '%-12s%s\n' "$_c_l" "searching…"
        fi
    done
}

rows() { cat "$1/$2" 2>/dev/null; }

# Lanes that have finished with at least one hit.
_hit_lanes() {
    for _h_l in $LANES_FAST $LANES_SCOPED; do
        [ -s "$1/$_h_l" ] && printf '%s\n' "$_h_l"
    done
    return 0
}

# ── the preview ─────────────────────────────────────────────────────────────

preview() {
    _p_l=$1; shift; _p_b=$*
    case $_p_l in
    files|recent-file)
        _p_f=$(_expand "$_p_b")
        bat --style=plain --color=always "$_p_f" 2>/dev/null || cat "$_p_f" 2>/dev/null ;;
    dirs|recent-dir)
        ls -la "$(_expand "$_p_b")" 2>/dev/null ;;
    text)
        _preview_at "$(_expand "${_p_b%%:*}")" "$(printf '%s' "$_p_b" | cut -d: -f2)" ;;
    docs)
        _preview_at "$MANUAL/$(printf '%s' "${_p_b%%:*}" | sed 's|^\./||')" "$(printf '%s' "$_p_b" | cut -d: -f2)" ;;
    git-log)
        git --no-pager show --color=always --stat "${_p_b%% *}" 2>/dev/null ;;
    git-branch)
        git --no-pager log --color=always --oneline -20 "$_p_b" 2>/dev/null ;;
    manual)
        nu -n -c "source ~/.config/nushell/help.nu; help --entry \"$(_key "$_p_b")\"" 2>/dev/null ;;
    *)
        printf '%s\n' "$_p_b" ;;
    esac
}

_preview_at() {
    # A window around the hit, not the head of the file — a grep hit 900 lines
    # down previews as nothing useful otherwise.
    _a_f=$1; _a_n=${2:-1}
    case $_a_n in ''|*[!0-9]*) _a_n=1 ;; esac
    [ -f "$_a_f" ] || return 0
    _a_s=$((_a_n - 10)); [ "$_a_s" -lt 1 ] && _a_s=1
    bat --style=plain --color=always --highlight-line "$_a_n" \
        --line-range "$_a_s:$((_a_n + 30))" "$_a_f" 2>/dev/null \
        || sed -n "${_a_s},$((_a_n + 30))p" "$_a_f"
}

# The manual lane renders as `key — description`; the key is what
# `help --entry` addresses, so everything from the em dash on is display.
_key() { printf '%s' "${1%% — *}"; }

# ── openers ─────────────────────────────────────────────────────────────────
#
# Every one of them lands BELOW the pane the key was pressed in, which is the
# whole reason this is a tmux binding and not a shell one: the popup is modal
# and transient, and the thing you picked has to survive it. $ORIGIN is passed
# in by the binding because a popup is not part of the window layout — it has
# no position of its own to split from.
#
# The split between running a pick and merely typing it is read-only vs not. A
# file, a directory, a commit and a manual entry are all things you are looking
# AT, so they open. A history line, an alias, an env var and a branch switch
# all CHANGE something, and they land on a prompt for you to read once and
# press Enter, or edit, or abandon.

# TRAP: a split is not always possible. tmux refuses one with "no space for a
# new pane" once the window is full, and by then the popup has closed — so
# without the fallback the whole gesture reads as the key having done nothing
# at all, with the error written to a pane that no longer exists.
_split() {
    _sp_cwd=$1; shift
    tmux split-window -v -P -F '#{pane_id}' -t "$ORIGIN" -c "$_sp_cwd" "$@" 2>/dev/null \
        || tmux new-window -P -F '#{pane_id}' -c "$_sp_cwd" "$@" 2>/dev/null
}

split_run() {
    if [ -n "${2:-}" ]; then _split "$1" "$2" >/dev/null; else _split "$1" >/dev/null; fi
}

split_cd() { split_prefill "$1" ""; }

split_prefill() {
    # $1 cwd, $2 text to leave on the new pane's prompt, unrun ("" for none).
    #
    # TRAP 1: `-c` did not use to decide where a nushell pane ends up, and the
    # pane would lie to you about it — tmux really does start it there, and
    # then the shell cd'd away. env.nu's start-dir (04-shell R7) ran `cd` on
    # every interactive shell, unconditionally, to whatever
    # ~/.local/state/nushell/startdir.txt held. A launch directory therefore
    # survived in an `sh` pane and never in a `nu` one. It matters well beyond
    # the directory lanes: `git switch` and a recalled history line are both
    # the wrong command when they run in the wrong repository.
    #
    # Fixed at the source 2026-09-01 — env.nu now skips the start-dir cd when
    # $env.TMUX is set, so `-c` alone would carry these panes. The --execute
    # splice below is KEPT as the belt to that braces: it is the only spelling
    # that also holds if this script is ever run against a shell whose config
    # is not this one. Do not read the paragraph above as live behaviour.
    #
    # The splice is nushell's own --execute, which runs AFTER the env config
    # and so after any start-dir cd, and before the prompt. Typing the cd in
    # instead does not work: the keys are sent as one burst, and reedline
    # discards whatever arrives while it is running the line it already has —
    # so the cd executes and the command meant for the prompt vanishes.
    #
    # The flag is spliced into `default-command` rather than replacing it,
    # because that option carries three obligations this must not re-spell:
    # XDG_CONFIG_HOME exported BEFORE the exec, nu resolved on PATH and never
    # absolutely, and a fallback shell when nu is missing. If the option is
    # ever reworded so `exec nu ` no longer appears, the splice quietly does
    # nothing and the pane opens in the start dir — the old wrong directory,
    # not a broken pane.
    _pf_dc=$(tmux show -gv default-command 2>/dev/null)
    [ -n "$_pf_dc" ] || _pf_dc="exec \"\${SHELL:-/bin/sh}\""
    _pf_dc=$(printf '%s' "$_pf_dc" | sed "s|exec nu |exec nu --execute \"cd '$(_q "$1")'\" |")

    # TRAP 2: `stty -echo` is not cosmetic. send-keys arrives while the pane is
    # still in cooked mode — nushell has not started, let alone taken the
    # terminal raw — so the tty echoes the text once itself, and then reedline
    # reads the same bytes out of the input buffer and draws them again. You
    # get the command twice, once as a stray line above the prompt. Turning
    # echo off before the exec leaves only reedline's copy. Both orderings are
    # then safe: if send-keys wins the race the bytes wait in the buffer
    # silently, and if nushell wins, reedline is already drawing its own.
    _pf_p=$(_split "$1" "stty -echo; $_pf_dc")
    [ -n "$_pf_p" ] || return 0
    [ -n "$2" ] || return 0
    tmux send-keys -t "$_pf_p" -l "$2"
}

open_row() {
    _o_l=$1; shift; _o_b=$*
    _o_here=$PWD
    case $_o_l in
    files|recent-file)
        split_run "$_o_here" "\${EDITOR:-nvim} -- '$(_q "$(_expand "$_o_b")")'" ;;
    text)
        _o_f=$(_expand "${_o_b%%:*}"); _o_n=$(printf '%s' "$_o_b" | cut -d: -f2)
        case $_o_n in ''|*[!0-9]*) _o_n=1 ;; esac
        split_run "$_o_here" "\${EDITOR:-nvim} '+$_o_n' -- '$(_q "$_o_f")'" ;;
    docs)
        _o_f="$MANUAL/$(printf '%s' "${_o_b%%:*}" | sed 's|^\./||')"
        _o_n=$(printf '%s' "$_o_b" | cut -d: -f2)
        case $_o_n in ''|*[!0-9]*) _o_n=1 ;; esac
        split_run "$_o_here" "\${EDITOR:-nvim} '+$_o_n' -- '$(_q "$_o_f")'" ;;
    dirs|recent-dir)
        split_cd "$(_expand "$_o_b")" ;;
    git-log)
        split_run "$_o_here" "git show '$(_q "${_o_b%% *}")'" ;;
    manual)
        split_prefill "$_o_here" "help --entry \"$(_key "$_o_b")\"" ;;
    git-branch)
        split_prefill "$_o_here" "git switch $_o_b" ;;
    history)
        split_prefill "$_o_here" "$_o_b" ;;
    alias)
        split_prefill "$_o_here" "$_o_b " ;;
    env)
        split_prefill "$_o_here" "\$env.${_o_b%%=*}" ;;
    esac
}

# ── the ask line ────────────────────────────────────────────────────────────
#
# A byte-at-a-time reader rather than `read -r`, and the whole reason is Escape.
# Under `read` the terminal is in canonical mode and Escape is simply a
# character that goes into the buffer: the box cannot be dismissed with it, only
# with Ctrl-C, which is not what anybody presses to back out of a search. Raw
# mode is what makes a key a key.
#
# TRAP: Escape is also the first byte of every arrow, Home, End and function
# key, so treating a bare 0x1b as cancel would make one stray arrow press throw
# the query away. The two are told apart the only way a terminal allows — by
# time. After an Escape the read is switched to a tenth-of-a-second timeout: a
# byte arriving that fast is the rest of a sequence the terminal sent as one
# burst, and is swallowed; nothing arriving is a human finger, and cancels.
ask_line() {
    [ -t 0 ] || return 0
    _al_saved=$(stty -g 2>/dev/null)
    # The trap covers every exit, including the popup being killed from
    # outside: a terminal left in raw mode with echo off is a dead pane.
    trap 'stty "$_al_saved" 2>/dev/null' EXIT INT TERM
    stty raw -echo 2>/dev/null

    _al_buf=""
    printf '\r  \033[K'
    while :; do
        _al_c=$(dd bs=1 count=1 2>/dev/null; printf X); _al_c=${_al_c%X}
        _al_n=$(printf '%s' "$_al_c" | od -An -tu1 | tr -d ' \n')
        case ${_al_n:-none} in
        none) break ;;
        27)
            # After an Escape byte, exactly two things can continue a real
            # escape SEQUENCE: `[` (CSI) or `O` (SS3). Anything else is a
            # keypress, and the Escape was a keypress too.
            #
            # TRAP: the obvious test — "another byte arrived within a tenth of
            # a second, so this must be a sequence" — is wrong, and it is the
            # bug that made the box refuse to close. Measured inside a real
            # popup on 2026-09-01: a single press of Escape can arrive as TWO
            # bytes, `27 27`. The peek saw the second Escape land instantly,
            # concluded a sequence had begun, found neither `[` nor `O`, and
            # discarded both. Timing narrows the question but does not answer
            # it; the byte that follows does. So the timeout is only used to
            # tell "nothing follows" from "something follows", and what
            # follows is then read rather than assumed.
            _al_p=$(stty -g 2>/dev/null); stty -icanon min 0 time 1 2>/dev/null
            _al_x=$(dd bs=1 count=1 2>/dev/null; printf X); _al_x=${_al_x%X}
            stty "$_al_p" 2>/dev/null
            [ -z "$_al_x" ] && { stty "$_al_saved" 2>/dev/null; printf '\r\033[K'; return 0; }
            _al_seq=""
            stty -icanon min 0 time 1 2>/dev/null
            case $_al_x in
            '[')
                # Consume exactly the sequence and not a byte more. Draining
                # until the input falls quiet is the other obvious version and
                # it eats the characters typed straight after an arrow, which
                # arrive inside the same gap. CSI runs to a final byte in @..~.
                while :; do
                    _al_y=$(dd bs=1 count=1 2>/dev/null; printf X); _al_y=${_al_y%X}
                    [ -z "$_al_y" ] && break
                    _al_seq="$_al_seq$_al_y"
                    _al_m=$(printf '%s' "$_al_y" | od -An -tu1 | tr -d ' \n')
                    [ "${_al_m:-0}" -ge 64 ] && [ "${_al_m:-0}" -le 126 ] && break
                done
                # CSI-u carries the key as a number, and 27 in that wrapping is
                # still Escape — belt to the bare-byte braces above.
                case $_al_seq in
                27u|27\;*u) stty "$_al_saved" 2>/dev/null; printf '\r\033[K'; return 0 ;;
                esac
                stty raw -echo 2>/dev/null ;;
            O)
                dd bs=1 count=1 >/dev/null 2>&1
                stty raw -echo 2>/dev/null ;;
            *)
                # Not a sequence introducer. A second Escape is the common
                # case; Alt+key is the other, and this box binds no Alt key,
                # so treating either as "the user meant to leave" is both
                # simpler and what they meant.
                stty "$_al_saved" 2>/dev/null; printf '\r\033[K'; return 0 ;;
            esac
            ;;
        3)  stty "$_al_saved" 2>/dev/null; printf '\r\033[K'; return 0 ;;
        10|13) break ;;
        21) _al_buf="" ;;
        8|127) _al_buf=${_al_buf%?} ;;
        *)
            # Printable only. A control byte that reached here is a key this
            # box has no meaning for, and appending it would put an invisible
            # character into the query.
            [ "$_al_n" -ge 32 ] && _al_buf="$_al_buf$_al_c" ;;
        esac
        # Drawn short of the content width on purpose. The popup's pty is one
        # line; a string long enough to wrap scrolls it, and a scrolled
        # one-line pty is how the box loses its shape mid-typing. The tail is
        # what is kept, because the end of what you are typing is the part you
        # are looking at.
        _al_show=$_al_buf
        if [ ${#_al_show} -gt 44 ]; then _al_show="…$(printf '%s' "$_al_show" | tail -c 44)"; fi
        printf '\r  %s\033[K' "$_al_show"
    done

    stty "$_al_saved" 2>/dev/null
    printf '\r\033[K'
    [ -n "$_al_buf" ] || return 0
    printf '%s' "$_al_buf" > "$PENDING"
}

# ── the two stages ──────────────────────────────────────────────────────────

pick_lane() {
    # $1 qdir, $2 query, $3 scope label. Prints the chosen lane, or nothing.
    #
    # The header repeats the query because the prompt that took it is a separate
    # popup and has already closed — without it there is nothing on screen
    # saying what these counts are counting.
    #
    # --watch is what makes everywhere-mode progressive: tv re-runs `counts`
    # twice a second, so a lane that read "searching…" becomes a count the
    # moment its file lands, without the list closing or losing what you typed.
    #
    # --no-sort keeps the fastest-first order the lane list is written in.
    # There are at most twelve rows here, so ranking buys nothing, and a list
    # that reorders itself under a --watch redraw is a list you cannot aim at.
    tv --source-command "$SELF counts '$(_q "$1")'" \
        --source-output '{}' \
        --watch 0.5 \
        --no-sort \
        --no-preview \
        --input-header "“$2” $3 — type a channel, enter to open it" \
        --keybindings 'enter="confirm_selection"' \
        --no-remote \
        | head -1 | awk '{print $1}'
}

pick_row() {
    # $1 qdir, $2 lane. Prints the chosen row.
    #
    # TRAP: stderr must NOT be redirected on either tv call. The answer comes
    # back on stdout, so stdout is captured — and when it is, tv draws the
    # whole interface on STDERR instead. A `2>/dev/null` here is not tidiness,
    # it is turning the display off: tv runs, reads keys and returns a correct
    # answer, and the popup stays blank the entire time. Nothing in the exit
    # code or the output says so.
    tv --source-command "$SELF rows '$(_q "$1")' '$(_q "$2")'" \
        --source-output '{}' \
        --preview-command "$SELF preview '$(_q "$2")' {}" \
        --preview-size 45 \
        --input-header "$2 — enter opens it below, esc cancels" \
        --keybindings 'enter="confirm_selection"' \
        --no-remote \
        | head -1
}

# ── entry point ─────────────────────────────────────────────────────────────

case "${1:-}" in
    counts)  counts "$2"; exit 0 ;;
    rows)    rows "$2" "$3"; exit 0 ;;
    scan)    shift; scan "$1" "$2" "$3" < /dev/null; exit 0 ;;
    tree)    shift; tree_rebuild "$1" "$2" "$3" < /dev/null; exit 0 ;;
    preview) shift; preview "$@"; exit 0 ;;
    # `open` is how the openers get exercised without a human driving a TUI:
    # hand it a lane and a row and it does exactly what picking that row does.
    # It exists because the dispatch is the half that can be wrong quietly — a
    # lane that is missing is visible the moment the list draws, an opener that
    # splits into the wrong directory is not.
    open)    shift; ORIGIN=${TV_ALL_ORIGIN:?tv-all open: set TV_ALL_ORIGIN}; open_row "$@"; exit 0 ;;
esac

command -v tv >/dev/null 2>&1 || { echo "tv-all: television (tv) is not installed — the finder needs it." >&2; sleep 3; exit 1; }
ORIGIN=${TV_ALL_ORIGIN:-}
[ -n "$ORIGIN" ] || { echo "tv-all: no origin pane — run this from the F3 binding, not by hand." >&2; sleep 3; exit 1; }

mkdir -p "$CACHE" 2>/dev/null

# The query is handed from the ask popup to the run popup through a file named
# for the pane the key was pressed in. It has to be a file rather than an
# argument because these are two separate popups: tmux allows exactly one popup
# per client, so a small bordered prompt and a full-height result list cannot be
# the same one, and the binding runs them in sequence instead. Naming it for the
# origin pane keeps two panes searching at once from reading each other's query.
PENDING="$CACHE/pending-$(printf '%s' "$ORIGIN" | tr -cd 'A-Za-z0-9')"

case "${1:-here}" in
    everywhere) MODE=everywhere; SCOPE=$GLOBAL_ROOT ;;
    *)          MODE=here;       SCOPE=$PWD ;;
esac

# ── the ask step: one line, in a small popup the binding drew the border on ──

if [ "${2:-}" = "ask" ]; then
    # Cleared first, so a cancelled prompt cannot leave the previous query
    # behind for the binding's `test -s` to find and act on.
    rm -f "$PENDING"
    ask_line
    exit 0
fi

# ── the run step ────────────────────────────────────────────────────────────

[ -s "$PENDING" ] || exit 0
QUERY=$(cat "$PENDING")
rm -f "$PENDING"

case $MODE in
    everywhere) LABEL="everywhere — $(printf '%s' "$GLOBAL_ROOT" | sed "s|^$HOME|~|")" ;;
    *)          LABEL="here — $(printf '%s' "$PWD" | sed "s|^$HOME|~|")" ;;
esac

# Every search leaves a directory of row files behind, and a broad `text` lane
# is megabytes of them. Without this they accumulate for the life of the
# machine — the tree caches are bounded and rewritten in place, but the query
# dirs are one per distinct query and nothing else would ever remove them.
# Pruned on the way in rather than on the way out, because the way out is a
# popup closing and is not guaranteed to run at all.
find "$CACHE" -maxdepth 1 -name 'q-*' -type d -mmin +60 -exec rm -rf {} + 2>/dev/null
# And the handoff files, which outlive their pane only when the second popup
# never ran at all — a killed client, say. Harmless but not tidy, and a pane
# id is never reused so nothing can ever read one of these again.
find "$CACHE" -maxdepth 1 -name 'pending-*' -type f -mmin +60 -delete 2>/dev/null

QDIR="$CACHE/q-$(_hash "$SCOPE|$QUERY")"
rm -rf "$QDIR" 2>/dev/null
mkdir -p "$QDIR" 2>/dev/null

# Detached, so the scan outlives this shell: the popup closes the moment a row
# is picked, and a slow lane still writing its file must not be killed halfway
# through — the cache it is filling is what makes the next search fast.
nohup "$SELF" scan "$QDIR" "$SCOPE" "$QUERY" >/dev/null 2>&1 &

# A short budget for the scan to finish outright. Here-mode nearly always beats
# it — a repository answers every lane in about half a second — and when it
# does the count list is complete, so it can be acted on rather than merely
# watched. Everywhere-mode never beats it, which is the point: the list opens
# unfinished and fills in.
_i=0
while [ "$_i" -lt 15 ] && [ ! -f "$QDIR/.done" ]; do sleep 0.1; _i=$((_i + 1)); done

LANE=""
if [ -f "$QDIR/.done" ]; then
    _n=$(_hit_lanes "$QDIR" | wc -l | tr -d ' ')
    # Nothing anywhere: say so, rather than opening an empty list to pick from.
    if [ "$_n" -eq 0 ]; then
        printf '\n  no hits for “%s” %s\n' "$QUERY" "$LABEL"
        sleep 2
        exit 0
    fi
    # One channel is not a choice. This is "if only one is left, select it" —
    # answered before it is asked, because the counts already know.
    [ "$_n" -eq 1 ] && LANE=$(_hit_lanes "$QDIR")
fi

[ -n "$LANE" ] || LANE=$(pick_lane "$QDIR" "$QUERY" "$LABEL")
[ -n "$LANE" ] || exit 0

ROW=$(pick_row "$QDIR" "$LANE")
[ -n "$ROW" ] || exit 0
open_row "$LANE" "$ROW"
