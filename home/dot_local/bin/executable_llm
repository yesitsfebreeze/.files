#!/usr/bin/env python3
"""llm — a local OpenAI/Anthropic route in front of every model you can reach.

  llm           pick a model (auto included), then which agent runs it
  llm sync      providers.json -> every model, price, caps, window, public rank,
                our own record -> models.json + litellm config.yaml
  llm serve     run the proxy (litellm) on that config, foreground
  llm status    what's parked and why, and who is best at which job
  llm cc [agent] [model] [args…]
                an agent (agents.json: claude, pi, …) on a model: `auto`,
                `auto:free`, any alias, `alias@provider` to pin a hop,
                `native:opus` for the agent's own plan; no model -> fzf
                picker. `llm claude …` / `llm pi …` are the same; `cll` is
                `llm claude`.
  llm env       print the exports (credentials.env + master key) for scripts
  llm report <task> <model> <note…>      a free-text note into the record
  llm judge  <task> <model> [file]       a free model scores an output 1-5

Request path (litellm_hooks.py, loaded by the proxy): `model: auto` or
`auto:<tier>` is answered from models.json — filter by tier, capability and
parked-state, sort by that job's score, first goes out, the rest ride as
litellm fallbacks until one answers. No model is asked how to route. Every
call's outcome goes to performance.jsonl; every refusal parks the model with
the API's own reason and a cooldown; the next `sync` folds the record back
into the scores.

Files:  ~/.config/litellm/{providers,aliases,agents}.json + litellm_hooks.py  (dotfiles)
        ~/.local/state/litellm/credentials.env   export VAR=value, mode 600
        ~/.local/state/litellm/models.json       the shelf, one file
        ~/.local/state/litellm/performance.jsonl the record, append-only
        ~/.local/state/litellm/status.json       parked models
        ~/.config/litellm/config.yaml            generated for litellm
"""
import collections, json, os, re, secrets, shlex, signal, subprocess, sys, time, urllib.request

HOME = os.path.expanduser("~")
STATE = f"{HOME}/.local/state/litellm"
CONF = f"{HOME}/.config/litellm"
ROOT = CONF  # providers.json, aliases.json, agents.json, litellm_hooks.py — deployed by the dotfiles
CREDS = f"{STATE}/credentials.env"
MODELS = f"{STATE}/models.json"
RECORD = f"{STATE}/performance.jsonl"
STATUS = f"{STATE}/status.json"
PORT = int(os.environ.get("LITELLM_PORT", "4000"))
BASE = f"http://127.0.0.1:{PORT}"
JOBS = ["text", "code", "vision", "agent", "document", "search"]
ARENA = "https://raw.githubusercontent.com/oolong-tea-2026/arena-ai-leaderboards/main/data"


# ---------------------------------------------------------------- env
def load_env():
    """credentials.env into os.environ, plus the proxy's own master key
    (generated on first use). Returns the exports as shell lines."""
    os.makedirs(STATE, exist_ok=True)
    mk = f"{STATE}/master.key"
    if not os.path.exists(mk):
        fd = os.open(mk, os.O_WRONLY | os.O_CREAT, 0o600)
        os.write(fd, ("sk-litellm-" + secrets.token_urlsafe(24)).encode()); os.close(fd)
    out = {}
    try:
        for line in open(CREDS):
            line = line.strip()
            if line.startswith("export "):
                line = line[7:]
            k, _, v = line.partition("=")
            if k and v:
                out[k.strip()] = v.strip().strip("'\"")
    except FileNotFoundError:
        print(f"llm: no {CREDS} — every proxied route will be unauthenticated", file=sys.stderr)
    out["LITELLM_MASTER_KEY"] = open(mk).read().strip()
    out["LITELLM_PORT"], out["LITELLM_BASE"] = str(PORT), BASE
    os.environ.update(out)
    return "\n".join(f"export {k}={shlex.quote(v)}" for k, v in out.items())


def registry():
    """providers.json: {"skip": [substrings of ids never offered — embeddings,
    batch endpoints, image/audio/video models: not chat], "providers": [...]}."""
    r = json.load(open(f"{ROOT}/providers.json"))
    return {p["name"]: dict(p, skip=r.get("skip", []) + p.get("skip", [])) for p in r["providers"]}


def get(url, key=None, timeout=25):
    r = urllib.request.Request(url, headers={"Authorization": f"Bearer {key}"} if key else {})
    return json.load(urllib.request.urlopen(r, timeout=timeout))


# ---------------------------------------------------------------- sync: inventory
def price_of(m):
    """(in, out) USD per million tokens, or None. openrouter: pricing.prompt
    per token as a string; zenmux: pricings.prompt[0].value per M; a
    provider listing upstreams under providers[] (huggingface): the first
    live one, and its is_free is the fact — a model is not free by being
    listed there (GLM-5.3 via novita: $1.40/$4.40, measured 2026-09-04)."""
    hp = [p for p in (m.get("providers") or []) if p.get("status", "live") == "live"]
    if hp:
        if any(p.get("is_free") for p in hp):
            return (0.0, 0.0)
        pr = hp[0].get("pricing")
        return (float(pr.get("input", 0)), float(pr.get("output", 0))) if pr else None
    p = m.get("pricing")
    if isinstance(p, dict) and "prompt" in p:
        try:
            return (float(p["prompt"]) * 1e6, float(p.get("completion", 0)) * 1e6)
        except (TypeError, ValueError):
            return None
    p = m.get("pricings")
    if isinstance(p, dict) and "prompt" in p:
        try:
            return (float(p["prompt"][0]["value"]), float((p.get("completion") or [{"value": 0}])[0]["value"]))
        except (TypeError, ValueError, IndexError, KeyError):
            return None
    return None


def caps_of(m):
    """input modalities / tools / reasoning as the provider states them;
    None where it states nothing — unknown is not "can't"."""
    arch = m.get("architecture") or {}
    sp = m.get("supported_parameters")
    hp = m.get("providers")
    tools = any(p.get("supports_tools") for p in hp) if hp else (("tools" in sp) if sp else None)
    reasoning = (m.get("capabilities") or {}).get("reasoning")
    if reasoning is None and sp:
        reasoning = "reasoning" in sp
    return {"input": m.get("input_modalities") or arch.get("input_modalities"),
            "tools": tools, "reasoning": reasoning}


def fetch_openai(spec):
    try:
        data = get(spec["base"] + "/models", os.environ.get(spec.get("key", ""), ""))["data"]
    except Exception as e:
        print(f"  ! {spec['name']}: {e}", file=sys.stderr)
        return {}
    got = {}
    for m in data:
        hp = [p for p in (m.get("providers") or []) if p.get("status", "live") == "live"]
        ctx = m.get("context_length") or (hp[0].get("context_length") if hp else None)
        mx = m.get("max_completion_tokens") or (m.get("top_provider") or {}).get("max_completion_tokens")
        outm = (m.get("architecture") or {}).get("output_modalities") or m.get("output_modalities")
        if outm and "text" not in outm:
            continue  # says so itself: not a chat model
        got[m["id"]] = {"context": ctx, "max": mx, "price": price_of(m), "caps": caps_of(m)}
    return got


def fetch_store(spec, live):
    """A provider whose /models carries no price or window (opencode): the
    live list is what it serves, ~/.pi/agent/models-store.json is where the
    price and window are. /models 403s now and then; the last good list is
    kept so a blip does not put dead ids back on the shelf."""
    cache = f"{STATE}/live-{spec['name']}.json"
    ids = set(live)
    if ids:
        json.dump(sorted(ids), open(cache, "w"))
    else:
        try:
            ids = set(json.load(open(cache)))
            print(f"  ~ {spec['name']}: /models failed, last good list ({len(ids)})", file=sys.stderr)
        except Exception:
            pass
    try:
        models = {m["id"]: m for m in json.load(open(f"{HOME}/.pi/agent/models-store.json"))
                  .get(spec["store"], {}).get("models", [])}
    except Exception:
        models = {}
    ids = ids or set(models)
    out = {}
    for mid in ids:
        m = models.get(mid, {})
        c = m.get("cost")
        out[mid] = {"context": m.get("contextWindow"), "max": m.get("maxTokens"),
                    "price": (float(c.get("input", 0)), float(c.get("output", 0))) if c else None,
                    "caps": {"input": m.get("input"), "tools": None, "reasoning": m.get("reasoning")}}
    return out


def fetch_ollama(spec):
    try:
        tags = get(f"{spec['base']}/api/tags", timeout=5)["models"]
    except Exception:
        return {}
    out = {}
    for m in tags:
        ctx = (m.get("details") or {}).get("context_length")
        if not ctx:
            try:
                req = urllib.request.Request(f"{spec['base']}/api/show", data=json.dumps({"model": m["name"]}).encode(),
                                             headers={"Content-Type": "application/json"})
                d = json.load(urllib.request.urlopen(req, timeout=10))
                lens = [v for k, v in d.get("model_info", {}).items() if k.endswith(".context_length")]
                ctx = min(lens) if lens else None
            except Exception:
                pass
        if not m.get("remote_host"):
            # served on this machine: num_ctx is the window. A `:cloud` model
            # runs on ollama.com at its trained window — capping it to num_ctx
            # launched Claude Code with a 32K limit on a 1M model, which
            # stopped at 56K with "Prompt is too long" (2026-09-04).
            ctx = min(ctx or spec.get("num_ctx", 32768), spec.get("num_ctx", 32768))
        out[m["name"]] = {"context": ctx, "max": None, "price": (0.0, 0.0),
                          "caps": {"input": ["text"], "tools": None, "reasoning": None}}
    return out


CONTEXT_FLOOR = 32768  # a window nobody states: small enough that a refusal is rare, and one refusal measures the truth
_table = None


def researched(hops):
    """The window a model was trained to, when no provider states one, asked
    of the sources that publish it: a huggingface hop's own config.json
    (`max_position_embeddings`; a gated repo 403s), then litellm's public
    model table (~3500 ids, matched by name core — the narrowest match, a
    hosted variant is never wider than the base). None when neither knows."""
    global _table
    for p, mid in hops.items():
        if p != "huggingface":
            continue
        try:
            r = urllib.request.Request(f"https://huggingface.co/{mid}/resolve/main/config.json",
                                       headers={"Authorization": f"Bearer {os.environ.get('HUGGINGFACE_API_KEY', '')}"})
            found = [int(v) for v in re.findall(r'"max_position_embeddings":\s*(\d+)', urllib.request.urlopen(r, timeout=15).read().decode())]
            if found:
                return min(found)
        except Exception:
            pass
    if _table is None:
        _table = {}
        try:
            t = get("https://raw.githubusercontent.com/BerriAI/litellm/main/model_prices_and_context_window.json")
        except Exception:
            import glob
            paths = glob.glob(f"{HOME}/.local/share/uv/tools/litellm/lib/python3.*/site-packages/litellm/model_prices_and_context_window_backup.json")
            t = json.load(open(paths[0])) if paths else {}
        for k, v in t.items():
            w = v.get("max_input_tokens") if isinstance(v, dict) else None
            if w:
                _table[core(k)] = min(_table.get(core(k), w), w)
    return next((_table[core(n)] for n in hops.values() if core(n) in _table), None)


def inventory(spec):
    if spec["kind"] == "ollama":
        got = fetch_ollama(spec)
    else:
        got = fetch_openai(spec)
        if spec.get("store"):
            got = fetch_store(spec, got)
    return {mid: v for mid, v in got.items() if not any(s in mid for s in spec.get("skip", []))}


# ---------------------------------------------------------------- sync: priors + record
def core(name):
    """'deepseek/deepseek-v4-flash-20260731' -> 'deepseekv4flash' — the
    name core public boards and providers share once vendor, date and
    ':free' are stripped."""
    name = name.split("/")[-1].lower()
    name = re.sub(r"-\d{8}$", "", name)
    name = re.sub(r":free$|-free$", "", name)
    name = re.sub(r"-(fp8|bf16|fp16|int4|int8|awq|gptq|instruct|it)$", "", name)  # a quant or chat variant of the same model
    return re.sub(r"[^a-z0-9]", "", name)


def priors(models):
    """{alias: {arena: {job: rank}, usage: rank}} from the Arena boards per
    job (top 20, keyless daily mirror) and OpenRouter's rankings-daily
    (top 50/day by tokens, ~30 days, our key). Matched by name core."""
    keys = collections.defaultdict(set)
    for a, m in models.items():
        keys[core(a)].add(a)
        for mid in m["hops"].values():
            keys[core(mid)].add(a)
    out = collections.defaultdict(dict)
    try:
        rows = get("https://openrouter.ai/api/v1/datasets/rankings-daily", os.environ.get("OPENROUTER_API_KEY"))["data"]
        tot = collections.defaultdict(int)
        for r in rows:
            if r.get("model_permaslug") and r["model_permaslug"] != "other":
                tot[r["model_permaslug"]] += int(r["total_tokens"])
        for rank, (slug, _) in enumerate(sorted(tot.items(), key=lambda kv: -kv[1]), 1):
            for a in keys.get(core(slug), ()):
                out[a].setdefault("usage", rank)
        print(f"  usage: {len(tot)} models ranked", file=sys.stderr)
    except Exception as e:
        print(f"  ~ usage skipped: {e}", file=sys.stderr)
    try:
        day = get(f"{ARENA}/latest.json")["path"]
        for job in JOBS:
            try:
                board = get(f"{ARENA}/{day}/{job}.json")
            except Exception:
                continue
            if isinstance(board, dict):
                board = board.get("models") or board.get("data") or board.get("entries") or []
            for r in board:
                for a in keys.get(core(r["model"]), ()):
                    out[a].setdefault("arena", {})[job] = r["rank"]
        print(f"  arena: snapshot {day}", file=sys.stderr)
    except Exception as e:
        print(f"  ~ arena skipped: {e}", file=sys.stderr)
    return out


def record():
    """{task: {alias: {ok, n, judge: [...]}}} from performance.jsonl."""
    st = {}
    try:
        for line in open(RECORD):
            if not line.strip():
                continue
            r = json.loads(line)
            s = st.setdefault(r.get("task"), {}).setdefault(r.get("model"), {"ok": 0, "n": 0, "judge": []})
            if r.get("kind") == "call":
                s["n"] += 1; s["ok"] += 1 if r.get("success") else 0
            elif r.get("kind") == "judge" and r.get("score") is not None:
                s["judge"].append(r["score"])
    except FileNotFoundError:
        pass
    return st


def windows():
    """{alias: tokens} — the narrowest window a model has named in a context
    refusal, as the hook recorded it. A fact from the model itself, so it
    outranks whatever a provider or a table says."""
    out = {}
    try:
        for line in open(RECORD):
            r = json.loads(line) if line.strip() else {}
            if r.get("window") and r.get("model"):
                out[r["model"]] = min(out.get(r["model"], r["window"]), r["window"])
    except FileNotFoundError:
        pass
    return out


def job_score(s):
    """0-1: success rate, averaged with the judge's 1-5 mapped to 0-1."""
    if not s or not s["n"]:
        return None
    rate = s["ok"] / s["n"]
    if s["judge"]:
        return round((rate + (sum(s["judge"]) / len(s["judge"]) - 1) / 4) / 2, 2)
    return round(rate, 2)


def scores(alias, m, rec):
    """Per job, one number the request path sorts by — precomputed here so
    routing is a lookup. Our own record wins when it exists (tasks are
    mapped to arena jobs by keyword in the hook; here every task's score is
    kept under its own name too). Without a record: arena rank for that job
    (1st -> 0.9, 20th -> 0.5), else usage rank (1st -> 0.6, 100th -> 0.3),
    else 0.4 unknown. Free is +0.05 so ties go to the cheaper model."""
    out = {}
    pri = m.get("priors") or {}
    free = 0.05 if m["tier"] == "free" else 0.0
    for job in JOBS:
        s = None
        if job in (pri.get("arena") or {}):
            s = 0.9 - 0.4 * (pri["arena"][job] - 1) / 19
        elif "usage" in pri:
            s = max(0.3, 0.6 - 0.3 * (pri["usage"] - 1) / 99)
        else:
            s = 0.4
        if job in ("agent", "code"):
            # an unknown that states tool calling and a big window is the
            # better unknown for agent work — Claude Code is agent work
            s += 0.05 * bool((m.get("caps") or {}).get("tools")) + 0.05 * ((m.get("context") or 0) >= 128000)
        out[job] = round(s + free, 3)
    for task, models in rec.items():
        js = job_score(models.get(alias))
        if js is not None:
            out[task] = round(min(1.0, js + free), 3)
    return out


# ---------------------------------------------------------------- sync
def sync():
    load_env()
    reg = registry()
    order = list(reg)
    al = json.load(open(f"{ROOT}/aliases.json"))
    aliases, canonical = al["aliases"], al["canonical"]
    inv = {}
    for p in order:
        inv[p] = inventory(reg[p])
        print(f"  {p}: {len(inv[p])} models", file=sys.stderr)
    # every model every provider serves, on top of the curated names; the
    # same raw id on several providers is one alias with all those hops
    slug = lambda s: s.replace("/", "-").replace(":", "-").lower()
    claimed = {(p, mid) for m in aliases.values() for p, mid in m.items()}
    by_id = {}
    for p in order:
        names = sorted(inv[p])
        cap = reg[p].get("cap")
        if cap and len(names) > cap:
            print(f"  ~ {p}: {len(names)} models, capping at {cap}", file=sys.stderr)
            names = names[:cap]
        for mid in names:
            if (p, mid) not in claimed:
                by_id.setdefault(mid, {})[p] = mid
    for mid, hops in sorted(by_id.items()):
        aliases.setdefault(slug(mid), hops)

    free_prov = {p for p in order if reg[p].get("free")}
    def hop_price(p, mid):
        return (0.0, 0.0) if p in free_prov else (inv[p].get(mid) or {}).get("price")
    def hop_cost(p, mid):
        pr = hop_price(p, mid)
        if pr is None:
            return (1, float("inf"), order.index(p))
        return (0 if pr == (0.0, 0.0) else 1, pr[0] + pr[1], order.index(p))

    models = {}
    measured = windows()
    src = collections.Counter()
    for alias, hops in aliases.items():
        chain = sorted((p for p in order if p in hops and hops[p] in inv[p]), key=lambda p: hop_cost(p, hops[p]))
        if not chain:
            continue
        p0 = chain[0]; v = inv[p0][hops[p0]]
        pr = hop_price(p0, hops[p0])
        # the window is never unknown: an unknown one walked a 67K request into
        # a 32K model and let Claude Code assume 200K (2026-09-04). Stated by a
        # hop, else researched, else the floor — and never wider than a refusal
        # this model has actually sent.
        ctx = next(((inv[p][hops[p]] or {}).get("context") for p in chain if (inv[p][hops[p]] or {}).get("context")), None)
        how = "stated" if ctx else "researched"
        ctx = ctx or researched({p: hops[p] for p in chain})
        if not ctx:
            ctx, how = CONTEXT_FLOOR, "floor"
        if measured.get(alias, ctx) < ctx:
            ctx, how = measured[alias], "measured"
        src[how] += 1
        if how == "floor":
            print(f"  ~ {alias}: no source states a window, floor {CONTEXT_FLOOR}", file=sys.stderr)
        models[alias] = {"hops": {p: hops[p] for p in chain}, "chain": chain,
                         "tier": "free" if pr == (0.0, 0.0) else "paid", "price": pr,
                         # local = every hop is a local daemon: the last resort, never a preference
                         "local": all(reg[p]["kind"] == "ollama" for p in chain),
                         "context": ctx, "max": v.get("max"), "caps": v.get("caps")}
    for canon, alias in canonical.items():
        if alias in models:
            models[canon] = dict(models[alias], canonical_of=alias)

    for a, pri in priors(models).items():
        models[a]["priors"] = pri
    rec = record()
    for a, m in models.items():
        m["jobs"] = scores(a, m, rec)
    os.makedirs(STATE, exist_ok=True)
    tmp = MODELS + ".tmp"
    json.dump(models, open(tmp, "w"), indent=1); os.replace(tmp, MODELS)

    # litellm config: every hop a deployment; `alias@provider` pins one
    def deployment(p, mid):
        spec = reg[p]
        if spec["kind"] == "ollama":
            if mid.endswith(":cloud"):
                return f"{{ model: openai/{mid}, api_base: {spec['base']}/v1, api_key: ollama }}"
            # ollama_chat/ carries num_ctx; without it the daemon's default
            # window (262144 here) loads a 3B at 12.8 GB, ~170s a load, and
            # reloads on every size change. Local models also reject Claude
            # Code's `thinking` param outright.
            return (f"{{ model: ollama_chat/{mid}, api_base: {spec['base']}, num_ctx: {spec.get('num_ctx', 32768)}, "
                    f'additional_drop_params: ["thinking", "reasoning_effort"] }}')
        k = f", api_key: os.environ/{spec['key']}" if spec.get("key") else ""
        if spec["kind"] == "openrouter":
            return f"{{ model: openrouter/{mid}{k} }}"
        return f"{{ model: openai/{mid}, api_base: {spec['base']}{k} }}"
    lines = ["# GENERATED by `llm sync` from providers.json + aliases.json — regenerate, don't hand-edit.",
             "", "model_list:"]
    fallbacks = []
    for alias, m in models.items():
        base = m.get("canonical_of", alias)
        for i, p in enumerate(m["chain"]):
            name = alias if i == 0 else f"{base}@{p}"
            if i and name in {l.split("model_name: ")[1] for l in lines if "model_name: " in l}:
                continue
            lines.append(f"  - model_name: {name}")
            lines.append(f"    litellm_params: {deployment(p, m['hops'][p])}")
            # `max_input_tokens` is the one number the harness reads to size its
            # context gauge; without it the gauge divides by zero and reports
            # 23710% "until auto-compact" (measured 2026-09-04). Every model
            # carries one now — a literal 0 would be a window nothing fits in.
            tag = f'tier:{"free" if hop_price(p, m["hops"][p]) == (0.0, 0.0) else "paid"}'
            lines.append(f'    model_info: {{ tags: ["{tag}"], max_input_tokens: {m["context"]} }}')
        if len(m["chain"]) > 1:
            fallbacks.append((alias, [f"{base}@{p}" for p in m["chain"][1:]]))
    lines += ["", "litellm_settings:", "  drop_params: true", "  num_retries: 1", "  request_timeout: 600",
              # Claude Code speaks /v1/messages; litellm bridges it to the Responses API by
              # default, which opencode.ai/zen/go answers with 429/500 — bridge via chat.
              "  use_chat_completions_url_for_anthropic_messages: true",
              "  callbacks: [litellm_hooks.router]", "", "router_settings:", "  fallbacks:"]
    for name, fb in fallbacks:
        lines.append(f"    - {name}: [{', '.join(fb)}]")
    lines += ["", "general_settings:", "  master_key: os.environ/LITELLM_MASTER_KEY", ""]
    os.makedirs(CONF, exist_ok=True)
    open(f"{CONF}/config.yaml", "w").write("\n".join(lines))
    tiers = collections.Counter(m["tier"] for m in models.values())
    print(f"wrote {MODELS}: {len(models)} models ({tiers['free']} free, {tiers['paid']} paid); "
          f"config.yaml; {sum(1 for m in models.values() if m.get('priors'))} with a public rank; "
          f"windows: {', '.join(f'{n} {how}' for how, n in src.most_common())}", file=sys.stderr)


# ---------------------------------------------------------------- serve / status / record
def serve(args):
    load_env()
    if not os.path.exists(f"{CONF}/config.yaml"):
        sync()
    os.execvp("litellm", ["litellm", "--config", f"{CONF}/config.yaml", "--port", str(PORT)] + args)


def status(args):
    try:
        models = json.load(open(MODELS))
    except FileNotFoundError:
        sys.exit("llm status: no models.json — run `llm sync`")
    st = {}
    try:
        st = json.load(open(STATUS))
    except FileNotFoundError:
        pass
    now = time.time()
    if args[:1] == ["clear"]:
        keep = {} if len(args) == 1 else {a: e for a, e in st.items() if a != args[1]}
        json.dump(keep, open(STATUS, "w"), indent=2)
        print(f"cleared {len(st) - len(keep)}")
        return
    parked = st  # every entry: a park lasts until the proxy's probe clears it
    ago = lambda t: f"{int((now - t) // 60)}m" if now - t < 3600 else f"{(now - t) / 3600:.1f}h"
    print(f"{len(models)} models, {sum(1 for m in models.values() if m['tier'] == 'free')} free, {len(parked)} parked")
    if parked:
        w = max(len(a) for a in parked)
        print(f"\n{'parked':<{w}}  {'state':<12} {'since':>6} {'probe in':>8}  reason")
        for a, e in sorted(parked.items(), key=lambda kv: (kv[1]["state"], kv[1]["until"])):
            due = "due" if e["until"] <= now else ago(2 * now - e["until"])
            print(f"{a:<{w}}  {e['state']:<12} {ago(e['since']):>6} {due:>8}  {e.get('reason', '')[:60]}")
    rec = record()
    if args[:1] == ["jobs"] or not args:
        jobs = sorted({j for m in models.values() for j in m.get("jobs", {})} - set(JOBS)) if rec else []
        for job in (args[1:] if len(args) > 1 else JOBS + jobs):
            top = sorted(((m["jobs"].get(job), a) for a, m in models.items()
                          if m.get("jobs", {}).get(job) is not None and a not in parked), reverse=True)[:5]
            own = rec.get(job, {})
            print(f"\n{job}:")
            for sc, a in top:
                n = own.get(a, {}).get("n", 0)
                print(f"  {sc:.2f}  {a:<44} {models[a]['tier']:<5} {'(' + str(n) + ' calls)' if n else ''}")


def needs(args):
    """What each model has told us it needs, from the record — read after the
    fact, never guessed. A `context` refusal on a model at N tokens means that
    model needs a wider window (the request is the user's, not ours to shrink),
    so the need is recorded against the model and the next sync sizes the walk
    by it. `llm needs` lists every model with a need; `llm needs <alias>`
    shows the evidence."""
    by = {}
    try:
        for line in open(RECORD):
            if not line.strip():
                continue
            r = json.loads(line)
            if r.get("success") or r.get("state") != "context" or not r.get("model"):
                continue
            e = by.setdefault(r["model"], {"n": 0, "tokens": [], "tasks": set(), "window": None})
            e["n"] += 1
            if r.get("tokens"):
                e["tokens"].append(r["tokens"])
            if r.get("window"):
                e["window"] = min(e["window"] or r["window"], r["window"])
            if r.get("task"):
                e["tasks"].add(r["task"])
    except FileNotFoundError:
        pass
    if not by:
        print("no model has recorded a need yet")
        return
    target = args[0] if args else None
    rows = [(m, e) for m, e in by.items() if not target or m == target]
    if target and not rows:
        sys.exit(f"llm needs: {target} has no recorded need")
    for m, e in sorted(rows, key=lambda kv: -kv[1]["n"]):
        mx = max(e["tokens"]) if e["tokens"] else 0
        w = f"window {e['window']:>7}" if e["window"] else "window unnamed  "
        print(f"{m:<44} context x{e['n']:<4} max request {mx:>7} tokens  {w}  {','.join(sorted(e['tasks']))[:60]}")
        if target:
            print(f"  need: a window wider than {mx} tokens" + (f" — the model names {e['window']}" if e["window"] else ""))
            print(f"  evidence: {e['n']} context refusals in performance.jsonl")


def report(args):
    if len(args) < 3:
        sys.exit("usage: llm report <task> <model> <note…>")
    _append({"ts": time.time(), "kind": "self-report", "task": args[0], "model": args[1], "note": " ".join(args[2:])})


def judge(args):
    """A cheap model scores another model's output 1-5, through the proxy.
    Scripted grading, one completion — not a subagent judging another."""
    if len(args) < 2:
        sys.exit("usage: llm judge <task> <model> [output-file]")
    load_env()
    task, model = args[0], args[1]
    output = open(args[2]).read() if len(args) > 2 else sys.stdin.read()
    # a free cloud model that answers the format (minimax-m3:free via
    # openrouter, ~6s, measured 2026-09-04); rate-limited -> the free walk
    grader = os.environ.get("LLM_JUDGE_MODEL", "minimax-m3-free")
    prompt = (f"Task: {task}\nModel under review: {model}\nOutput:\n{output}\n\n"
              "Score this output 1-5 for how well it did the task (5 = excellent). "
              "Reply with ONLY the digit, a dash, then one short sentence why.")
    def ask(m):
        req = urllib.request.Request(f"{BASE}/v1/chat/completions",
                                     data=json.dumps({"model": m, "messages": [{"role": "user", "content": prompt}],
                                                      "max_tokens": 4000, "metadata": {"tags": ["dispatcher"]}}).encode(),
                                     headers={"Authorization": f"Bearer {os.environ['LITELLM_MASTER_KEY']}",
                                              "Content-Type": "application/json"})
        return (json.load(urllib.request.urlopen(req, timeout=180))["choices"][0]["message"]["content"] or "").strip()
    # a reasoning model can spend its whole budget thinking and hand back
    # nothing; the free walk re-picks, so ask it again rather than give up
    score, verdict = None, ""
    for m in (grader, "auto:free", "auto:free"):
        try:
            verdict = ask(m)
        except Exception as e:
            print(f"llm judge: {m} failed ({str(e)[:80]})", file=sys.stderr)
            continue
        d = re.search(r"[1-5]", verdict)
        if d:
            grader, score = m, int(d.group())
            break
    _append({"ts": time.time(), "kind": "judge", "task": task, "model": model, "grader": grader,
             "score": score, "verdict": verdict})
    print(verdict)


def _append(rec):
    os.makedirs(STATE, exist_ok=True)
    with open(RECORD, "a") as f:
        f.write(json.dumps(rec) + "\n")


# ---------------------------------------------------------------- cc: an agent on a model
def agents():
    return json.load(open(f"{ROOT}/agents.json"))


def rows(agent=None):
    """Every launchable name: the agent's native (no-proxy) models, auto,
    each alias, each pinned hop — with tier and the report (best jobs,
    PARKED and why)."""
    try:
        models = json.load(open(MODELS))
    except FileNotFoundError:
        models = {}
    try:
        parked = json.load(open(STATUS))
    except FileNotFoundError:
        parked = {}
    nat = (agent or {}).get("native") or {}
    out = [{"name": f"{nat.get('prefix', 'native:')}{a}", "providers": ["native"], "kind": "native", "tier": "plan", "note": ""}
           for a in nat.get("models", [])]
    # auto re-picks on EVERY turn, not once per session — a long conversation
    # can bounce between backends mid-context. No pinning yet.
    out += [{"name": a, "providers": ["auto"], "kind": "auto", "tier": "auto", "note": ""} for a in ("auto", "auto:free", "auto:paid")]
    for name, m in models.items():
        jobs = sorted(((s, j) for j, s in (m.get("jobs") or {}).items()), reverse=True)[:3]
        note = ", ".join(f"{j} {s:.2f}" for s, j in jobs)
        if name in parked:
            note = f"PARKED {parked[name]['state']} · " + note
        out.append({"name": name, "providers": m["chain"], "kind": "proxy", "tier": m["tier"], "note": note})
        if "canonical_of" not in m:
            out += [{"name": f"{name}@{p}", "providers": [p], "kind": "pinned", "tier": m["tier"], "note": note}
                    for p in m["chain"][1:]]
    return out


def picker_rows(rs):
    """TAB-separated lines for fzf: key, provider + padded name, tier/chain/report.
    Every row carries its OWN provider column, not just the group header:
    fzf drops non-matching lines, so a header cannot stay pinned over its group
    once you type."""
    groups, order = {}, []
    for r in rs:
        p = r["providers"][0]
        if p not in order:
            order.append(p); groups[p] = []
        groups[p].append(r)
    DIM, CYAN, RESET = "\033[2m", "\033[36m", "\033[0m"
    width = max((len(r["name"]) for r in rs), default=20) + 2
    pwidth = max((len(p) for p in order), default=8) + 1
    lines = []
    for p in order:
        n = len(groups[p]); free = sum(1 for r in groups[p] if r["tier"] == "free")
        bal = f"{free} free / {n}" if p not in ("max-plan", "auto") else groups[p][0]["tier"]
        rule = "─" * max(4, width + pwidth - len(p) - len(bal))
        lines.append(f"__hdr__\t{DIM}── {p} {rule} {bal}{RESET}\t")
        for r in groups[p]:
            chain = " → ".join(r["providers"][1:])
            tail = f"{r['tier']:<5}" + (f" ↳ {chain}" if chain else "") + (f"  {r['note']}" if r["note"] else "")
            lines.append(f"{r['name']}\t{CYAN}{p:<{pwidth}}{RESET} {r['name']:<{width}}\t{DIM}{tail}{RESET}")
    return "\n".join(lines) + "\n"


def pick(rs):
    # --nth=1 not 2: --with-nth re-indexes fields, so --nth counts against
    # the TRANSFORMED line where the name is field 1 (fzf 0.74.3: --nth=2
    # searched the chain column and `opus` matched nothing). A header's key
    # is a sentinel — Enter on one re-opens the picker.
    while True:
        m = fuzzy(picker_rows(rs).rstrip("\n").split("\n"), "model",
                  "grouped by provider; type to filter — auto lets the router pick per request")
        if m != "__hdr__":
            return m


def proxy_live():
    try:
        urllib.request.urlopen(f"{BASE}/health/liveliness", timeout=2)
        return True
    except Exception:
        return False


def fill(x, v):
    """Expand {model} {base} {key} {context} {home} {args_json} in a string,
    list or dict of strings."""
    if isinstance(x, str):
        return x.format(**v)
    if isinstance(x, list):
        return [fill(i, v) for i in x]
    if isinstance(x, dict):
        return {k: fill(i, v) for k, i in x.items()}
    return x


def fuzzy(lines, prompt, header):
    """One pick from TAB-separated lines (key first) via fzf, else a numbered
    list. Returns the key, or ""."""
    if subprocess.run(["sh", "-c", "command -v fzf"], capture_output=True).returncode == 0:
        r = subprocess.run(["fzf", "--ansi", "--delimiter=\t", "--with-nth=2..", "--nth=1", "--accept-nth=1",
                            "--height=40%", "--reverse", f"--prompt={prompt}> ", f"--header={header}"],
                           input="\n".join(lines) + "\n", capture_output=True, text=True)
        return r.stdout.strip()
    keys = [l.split("\t")[0] for l in lines]
    for i, l in enumerate(lines, 1):
        print(f"{i:>3}) {l.split(chr(9), 1)[1]}")
    try:
        return keys[int(input(f"{prompt} number: ")) - 1]
    except (ValueError, IndexError, EOFError):
        return ""


def pick_agent(cfg, model=""):
    """Which agent runs the model. A `native:` pick narrows to agents that
    have that native; everything else is open to all."""
    names = [n for n, a in cfg["agents"].items()
             if not (a.get("native") and model.startswith(a["native"].get("prefix", "native:")))
             or model[len(a["native"].get("prefix", "native:")):] in a["native"].get("models", [])]
    if model.startswith("native:") and not names:
        sys.exit(f"llm: no agent has a native {model}")
    if len(names) == 1:
        return names[0]
    DIM, RESET = "\033[2m", "\033[0m"
    w = max(len(n) for n in names) + 2
    lines = [f"{n}\t{n:<{w}}{DIM}{' '.join(cfg['agents'][n]['cmd'])}{RESET}" for n in names]
    return fuzzy(lines, "agent", f"which agent runs {model or 'it'}")


def cc(args, ask_agent=False):
    """An agent on a model, as agents.json says: `llm cc [agent] [model] [args…]`.
    Bare `llm`: pick the model, then the agent — two fuzzy lists. The agent's
    `cmd` and `env` are templates; `profile` gives it a config dir of its own
    (linked and copied from its real one, so a model switch inside the agent
    can't rewrite the real settings) with the model picker written into
    `model_picker`; `native` is the no-proxy hop for the agent's own models
    (Claude Code on the Max plan)."""
    cfg = agents()
    name = None
    if args and args[0] in cfg["agents"]:
        name, args = args[0], args[1:]
    if name is None and not ask_agent:
        name = cfg.get("default") or next(iter(cfg["agents"]))
    if name is None:
        # model first, from the union of every agent's shelf; then the agent
        seen, union = set(), []
        for a in cfg["agents"].values():
            for r in rows(a):
                if r["name"] not in seen:
                    seen.add(r["name"]); union.append(r)
        model = pick(union) if not (args and not args[0].startswith("-")) else args[0]
        if args and not args[0].startswith("-"):
            args = args[1:]
        if not model:
            sys.exit("llm: no model selected")
        name = pick_agent(cfg, model)
        if not name:
            sys.exit("llm: no agent selected")
        args = [model] + args
    agent = cfg["agents"][name]
    rs = rows(agent)
    if args[:1] == ["--catalog"]:
        print(json.dumps(rs)); return
    if args[:1] == ["--list"]:
        try:
            for r in rs:
                print(r["name"])
            sys.stdout.flush()
        except BrokenPipeError:
            pass
        return
    if args[:1] == ["--rows"]:
        sys.stdout.write(picker_rows(rs)); return
    model = ""
    if args and args[0] != "--" and not args[0].startswith("-"):
        model, args = args[0], args[1:]
    if args[:1] == ["--"]:
        args = args[1:]
    model = model or pick(rs)
    if not model:
        sys.exit(f"llm {name}: no model selected")
    env = dict(os.environ)
    # "no proxy" must mean no proxy: a parent session exports the agent's env
    for k in list((agent.get("env") or {})) + list(agent.get("unset") or []):
        env.pop(k, None)

    nat = agent.get("native") or {}
    if nat and model.startswith(nat.get("prefix", "native:")):
        m = model[len(nat.get("prefix", "native:")):]
        v = {"model": m, "args_json": json.dumps(args), "home": HOME, "base": "", "key": "", "context": ""}
        tty = nat.get("tty")
        if tty and sys.stdin.isatty() and subprocess.run(["sh", "-c", f"command -v {shlex.quote(tty['cmd'][0])}"],
                                                         capture_output=True).returncode == 0:
            print(f"llm {name}: {m} — native, via {tty['cmd'][0]}", file=sys.stderr)
            env.update(fill(tty.get("env") or {}, v))
            cmd = fill(tty["cmd"], v)
            os.execvpe(cmd[0], cmd, env)
        print(f"llm {name}: {m} — native", file=sys.stderr)
        cmd = fill(nat["cmd"], v) + args
        os.execvpe(cmd[0], cmd, env)

    load_env()
    if not proxy_live():
        if not os.path.exists(MODELS):
            sync()
        print(f"llm {name}: starting litellm on {BASE[7:]} …", file=sys.stderr)
        os.makedirs(STATE, exist_ok=True)
        lp = f"{STATE}/proxy.log"
        if os.path.exists(lp) and os.path.getsize(lp) > 20_000_000:
            os.replace(lp, lp + ".1")  # every error line carries the whole fallback list; 44 MB in a day
        log = open(lp, "a")
        subprocess.Popen([sys.argv[0], "serve"], stdout=log, stderr=log, stdin=subprocess.DEVNULL, start_new_session=True)
        # poll liveliness, not the child: two launches racing both spawn one,
        # the loser dies on the bound port while the winner answers here
        for _ in range(120):
            if proxy_live():
                break
            time.sleep(0.5)
        else:
            sys.exit(f"llm {name}: litellm did not answer within 60s — see {STATE}/proxy.log")

    # the model's window, for agents that size context by the id they were
    # given (Claude Code assumes 200K for an id it doesn't know). A pinned hop
    # uses its base alias's window; ids in context_unless are left alone.
    ctx = ""
    if not any(model.startswith(p) for p in agent.get("context_unless") or []):
        try:
            ctx = str(json.load(open(MODELS)).get(model.split("@")[0], {}).get("context") or "")
        except Exception:
            pass
    v = {"model": model, "base": BASE, "key": os.environ["LITELLM_MASTER_KEY"], "context": ctx,
         "home": HOME, "args_json": json.dumps(args)}

    prof = agent.get("profile")
    if prof:
        pdir, src = fill(prof["dir"], v), fill(prof["from"], v)
        os.makedirs(pdir, exist_ok=True)
        for item in prof.get("link", []):  # a snapshot of one version's layout; a new dir goes unlinked, silently
            if os.path.exists(f"{src}/{item}") and not os.path.lexists(f"{pdir}/{item}"):
                os.symlink(f"{src}/{item}", f"{pdir}/{item}")
        for f in prof.get("copy", []):
            if os.path.isfile(f"{src}/{f}") and not os.path.isfile(f"{pdir}/{f}"):
                open(f"{pdir}/{f}", "w").write(open(f"{src}/{f}").read())
        if prof.get("model_picker"):
            # the agent's in-session model list: every proxied name with tier ·
            # chain · the report under it. Only modelPicker is touched.
            sp = f"{pdir}/{prof['model_picker']}"
            try:
                s = json.load(open(sp))
            except Exception:
                s = {}
            s["modelPicker"] = {"replaceBuiltInOptions": True, "options": [
                {"model": r["name"], "label": r["name"],
                 "description": f"{r['tier']} · {' → '.join(r['providers'])}" + (f" · {r['note']}" if r["note"] else "")}
                for r in rs if r["kind"] != "native"]}
            json.dump(s, open(sp, "w"), indent=2)

    for k, val in fill(agent.get("env") or {}, v).items():
        if val:
            env[k] = val
    print(f"llm {name}: {model} via litellm", file=sys.stderr)
    cmd = fill(agent["cmd"], v) + args
    os.execvpe(cmd[0], cmd, env)


def main():
    a = sys.argv[1:]
    if not a or a[0].startswith("-"):
        cc(a, ask_agent=True)  # bare `llm`: pick the model, then the agent
        return
    cmd = a[0]
    if cmd == "sync":
        sync()
    elif cmd == "serve":
        serve(a[1:])
    elif cmd == "status":
        status(a[1:])
    elif cmd == "env":
        print(load_env())
    elif cmd == "needs":
        needs(a[1:])
    elif cmd == "report":
        report(a[1:])
    elif cmd == "judge":
        judge(a[1:])
    elif cmd == "cc":
        cc(a[1:])
    elif cmd in agents()["agents"]:
        cc(a)
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    signal.signal(signal.SIGPIPE, signal.SIG_DFL)  # `llm status | head` ends quietly
    main()
