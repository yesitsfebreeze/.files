#!/bin/sh
# ollama-host — print the reachable Ollama endpoint.
# Probes localhost; exits 1 if unreachable.

PORT="${OLLAMA_PORT:-11434}"
TIMEOUT="${OLLAMA_PROBE_TIMEOUT:-0.4}"

probe() {
	curl -fs --max-time "$TIMEOUT" "http://$1:$PORT/api/version" >/dev/null 2>&1
}

if probe "127.0.0.1"; then
	printf 'http://127.0.0.1:%s\n' "$PORT"
	exit 0
fi

echo "ollama-host: no Ollama reachable on port $PORT" >&2
exit 1
