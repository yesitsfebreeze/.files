# Surface: Neovim — the lazy.nvim stack.
# Schema, verify kinds and writing rules: see README.md in this directory.
#
# On `desc` inside an nvim-map target: it is the string the live map's own
# `desc` must equal. Absent means compare against this entry's `title`.
# Explicit `null` means the map carries no `desc` deliberately, so the drift
# check may only assert that it exists.
[
    # -------------------------------------------------------------------- edit
    {
        key: "<leader>"
        title: "Show what the leader key can do"
        use: "Press space and pause: which-key lists the groups — `f` find, `b` buffer, `c` code, `r` rename/refactor, `t` table, `x` Claude — and then the maps inside whichever one you press."
        topic: "edit"
        task: "editing"
        step: 5
        mode: "nvim:normal"
        why: "Leader is space, and it is set before any plugin spec is evaluated: a spec that declares `keys = { \"<leader>x\" }` resolves leader at declaration time, so setting it later silently binds the wrong key."
        verify: [{kind: "prose"}]
        source: "prds/03-editor/12-small-plugins/prd.md"
    }
    {
        key: "<Esc>"
        title: "Clear highlight"
        use: "Press `Esc` in normal mode to run `:nohlsearch`. Nothing visible happens in this config: `hlsearch` is off, so matches never stay highlighted and there is nothing to drop. Turn the option on and this is the key that clears it; the search itself is untouched either way, so `n` still works."
        topic: "edit"
        task: "editing"
        step: 16
        mode: "nvim:normal"
        why: "The map and the option have to be decided together or the key is dead, and live bug L-6 decided it the other way round: keep `hlsearch = false` and drop the map. So this documents a binding the rebuild is not meant to carry over."
        verify: [{kind: "prose"}]
        source: "prds/03-editor/02-keymaps/prd.md"
    }
    {
        key: "q"
        title: "Close a utility buffer"
        use: "Press `q` in a help, quickfix, man, lspinfo, checkhealth or startuptime buffer to close it — one key across all six. The buffer is also marked unlisted the moment it opens, so it never turns up under `<S-h>`/`<S-l>` or `:bnext` either."
        topic: "edit"
        task: "editing"
        step: 17
        mode: "nvim:normal"
        verify: [{kind: "nvim-map", mode: "n", lhs: "q", desc: null, scope: "buffer"}]
        source: "prds/03-editor/03-autocmds/prd.md"
    }
    {
        key: "<C-h> <C-j> <C-k> <C-l>"
        title: "Move between windows"
        use: "Control plus a vim direction letter moves the cursor to the window that way — no `<C-w>` prefix."
        topic: "edit"
        task: "editing"
        step: 8
        mode: "nvim:normal"
        also: ["<C-Up> <C-Down> <C-Left> <C-Right>", "<leader>| and <leader>-"]
        verify: [
            {kind: "nvim-map", mode: "n", lhs: "<C-h>", desc: "Go to left window"}
            {kind: "nvim-map", mode: "n", lhs: "<C-j>", desc: "Go to lower window"}
            {kind: "nvim-map", mode: "n", lhs: "<C-k>", desc: "Go to upper window"}
            {kind: "nvim-map", mode: "n", lhs: "<C-l>", desc: "Go to right window"}
        ]
        source: "prds/03-editor/02-keymaps/prd.md"
    }
    {
        key: "<C-Up> <C-Down> <C-Left> <C-Right>"
        title: "Resize the current window"
        use: "Control plus an arrow resizes by two: up and down change height, left and right change width. Hold it to keep going."
        topic: "edit"
        task: "editing"
        step: 10
        mode: "nvim:normal"
        also: ["<C-h> <C-j> <C-k> <C-l>"]
        verify: [
            {kind: "nvim-map", mode: "n", lhs: "<C-Up>", desc: "Increase height"}
            {kind: "nvim-map", mode: "n", lhs: "<C-Down>", desc: "Decrease height"}
            {kind: "nvim-map", mode: "n", lhs: "<C-Left>", desc: "Decrease width"}
            {kind: "nvim-map", mode: "n", lhs: "<C-Right>", desc: "Increase width"}
        ]
        source: "prds/03-editor/02-keymaps/prd.md"
    }
    {
        key: "<leader>| and <leader>-"
        title: "Split the window"
        use: "`<leader>|` splits vertically (the new window is to the right), `<leader>-` splits horizontally (the new window is below). The bar and the dash look like the split they make."
        topic: "edit"
        task: "editing"
        step: 9
        mode: "nvim:normal"
        also: ["<C-h> <C-j> <C-k> <C-l>"]
        verify: [
            {kind: "nvim-map", mode: "n", lhs: "<leader>|", desc: "Split right"}
            {kind: "nvim-map", mode: "n", lhs: "<leader>-", desc: "Split below"}
        ]
        source: "prds/03-editor/02-keymaps/prd.md"
    }
    {
        key: "<S-h> <S-l> <leader>bd"
        title: "Walk and close buffers"
        use: "`H` and `L` step to the previous and next buffer; `<leader>bd` runs a plain `:bdelete` on the one you are in. The buffer leaves the list — and so does its window: this is the bare command, so a split showing that buffer closes with it rather than falling back to another buffer."
        topic: "edit"
        task: "editing"
        step: 7
        mode: "nvim:normal"
        also: ["<leader>fb"]
        verify: [
            {kind: "nvim-map", mode: "n", lhs: "<S-h>", desc: "Previous buffer"}
            {kind: "nvim-map", mode: "n", lhs: "<S-l>", desc: "Next buffer"}
            {kind: "nvim-map", mode: "n", lhs: "<leader>bd", desc: "Delete buffer"}
        ]
        source: "prds/03-editor/02-keymaps/prd.md"
    }
    {
        key: "<A-j> <A-k>"
        title: "Move a line or a selection up and down"
        use: "Alt with `j` or `k` drags the current line. In visual mode it drags the whole selection, and the selection stays selected and re-indented for the next press, so you can walk a block through a file."
        topic: "edit"
        task: "editing"
        step: 14
        mode: "nvim:normal"
        verify: [
            {kind: "nvim-map", mode: "n", lhs: "<A-j>", desc: "Move line down"}
            {kind: "nvim-map", mode: "n", lhs: "<A-k>", desc: "Move line up"}
            {kind: "nvim-map", mode: "v", lhs: "<A-j>", desc: "Move selection down"}
            {kind: "nvim-map", mode: "v", lhs: "<A-k>", desc: "Move selection up"}
        ]
        source: "prds/03-editor/02-keymaps/prd.md"
    }
    {
        key: "<C-d> <C-u> n N"
        title: "Keep the cursor centred while jumping"
        use: "Half-page scrolls and search steps re-centre the line you land on, and `n`/`N` also open a fold you land inside. Nothing to press differently — the keys are the stock ones."
        topic: "edit"
        task: "editing"
        step: 15
        mode: "nvim:normal"
        why: "These four maps carry no description on purpose: which-key should not list a key whose behaviour is the vim default plus a re-centre, and the drift check treats a missing `desc` here as intended rather than as a mismatch."
        verify: [
            {kind: "nvim-map", mode: "n", lhs: "<C-d>", desc: null}
            {kind: "nvim-map", mode: "n", lhs: "<C-u>", desc: null}
            {kind: "nvim-map", mode: "n", lhs: "n", desc: null}
            {kind: "nvim-map", mode: "n", lhs: "N", desc: null}
        ]
        source: "prds/03-editor/02-keymaps/prd.md"
    }
    {
        key: "< and > (visual)"
        title: "Indent a selection without losing it"
        use: "`<` and `>` shift the selection and leave it selected, so you can press `>` four times instead of `4>` and reselecting."
        topic: "edit"
        task: "editing"
        step: 13
        mode: "nvim:visual"
        verify: [
            {kind: "nvim-map", mode: "v", lhs: "<", desc: null}
            {kind: "nvim-map", mode: "v", lhs: ">", desc: null}
        ]
        source: "prds/03-editor/02-keymaps/prd.md"
    }
    {
        key: "<leader>w and <leader>q"
        title: "Save and quit"
        use: "`<leader>w` writes the buffer, `<leader>q` quits the window."
        topic: "edit"
        task: "editing"
        step: 6
        mode: "nvim:normal"
        verify: [
            {kind: "nvim-map", mode: "n", lhs: "<leader>w", desc: "Save"}
            {kind: "nvim-map", mode: "n", lhs: "<leader>q", desc: "Quit"}
        ]
        source: "prds/03-editor/02-keymaps/prd.md"
    }
    {
        key: "<leader>p (visual)"
        title: "Paste (keep register)"
        use: "Select, then `<leader>p`: the selection is replaced and the register still holds what you copied, so you can paste the same thing over several places in a row."
        topic: "edit"
        task: "editing"
        step: 18
        mode: "nvim:visual"
        also: ["<C-v> (visual)"]
        why: "A plain `p` over a selection puts the deleted text into the unnamed register, which is why the second paste always pastes the wrong thing. This deletes into the black hole register first."
        verify: [{kind: "nvim-map", mode: "x", lhs: "<leader>p", desc: "Paste (keep register)"}]
        source: "prds/03-editor/02-keymaps/prd.md"
    }
    {
        key: "<S-Up> <S-Down> <S-Left> <S-Right>"
        title: "Select text with shift and the arrows"
        use: "Hold shift and press an arrow: from normal mode it starts a selection, from an existing selection it extends it, and from insert mode it leaves insert and selects — from insert, `<S-Left>` catches the last two characters rather than one. It behaves like every non-modal editor."
        topic: "edit"
        task: "editing"
        step: 11
        mode: "nvim:normal"
        also: ["h j k l (visual)", "<C-c> (visual)"]
        why: "The insert cursor sits between characters and leaving insert drops it onto the one behind, which every shift map out of insert has to correct for — in opposite directions. `<S-Right>` moves right once before entering visual, or the character under the cursor is left out; leftward there is nothing to correct, and the extra character is the price."
        verify: [
            {kind: "nvim-map", mode: "n", lhs: "<S-Up>", desc: "Select up"}
            {kind: "nvim-map", mode: "n", lhs: "<S-Down>", desc: "Select down"}
            {kind: "nvim-map", mode: "n", lhs: "<S-Left>", desc: "Select left"}
            {kind: "nvim-map", mode: "n", lhs: "<S-Right>", desc: "Select right"}
            {kind: "nvim-map", mode: "v", lhs: "<S-Up>", desc: "Extend selection up"}
            {kind: "nvim-map", mode: "v", lhs: "<S-Down>", desc: "Extend selection down"}
            {kind: "nvim-map", mode: "v", lhs: "<S-Left>", desc: "Extend selection left"}
            {kind: "nvim-map", mode: "v", lhs: "<S-Right>", desc: "Extend selection right"}
            {kind: "nvim-map", mode: "i", lhs: "<S-Up>", desc: "Select up"}
            {kind: "nvim-map", mode: "i", lhs: "<S-Down>", desc: "Select down"}
            {kind: "nvim-map", mode: "i", lhs: "<S-Left>", desc: "Select left"}
            {kind: "nvim-map", mode: "i", lhs: "<S-Right>", desc: "Select right"}
        ]
        source: "prds/03-editor/14-shift-select/prd.md"
    }
    {
        key: "h j k l (visual)"
        title: "Move (collapse selection)"
        use: "In a selection that shift started, a plain motion — `h`/`j`/`k`/`l` or an unshifted arrow — drops the selection and moves, the way it would in a normal editor. A count still applies: `3j` collapses and goes down three lines. In a selection you started with `v`, the same keys extend it, exactly as stock vim does."
        topic: "edit"
        task: "editing"
        step: 12
        mode: "nvim:visual"
        also: ["<S-Up> <S-Down> <S-Left> <S-Right>"]
        why: "This is the half most configs get wrong, and it needs a flag rather than a mapping: the flag records that the selection began with shift, and a `ModeChanged` autocmd clears it on leaving visual mode. Without that reset, the next `v` selection would inherit collapse-on-motion and stop behaving like vim."
        verify: [
            {kind: "nvim-map", mode: "v", lhs: "h", desc: "Move (collapse selection)"}
            {kind: "nvim-map", mode: "v", lhs: "j", desc: "Move (collapse selection)"}
            {kind: "nvim-map", mode: "v", lhs: "k", desc: "Move (collapse selection)"}
            {kind: "nvim-map", mode: "v", lhs: "l", desc: "Move (collapse selection)"}
        ]
        source: "prds/03-editor/14-shift-select/prd.md"
    }
    {
        key: "<C-c> (visual)"
        title: "Copy to clipboard"
        use: "`<C-c>` on a selection yanks it and leaves visual mode. The clipboard is shared with the system, so it pastes into the terminal and into any other application."
        topic: "edit"
        task: "editing"
        step: 19
        mode: "nvim:visual"
        also: ["<C-v> (visual)", "<leader>p (visual)"]
        why: "`clipboard=unnamedplus` is what makes this work in both directions — there is no separate editor clipboard to copy out of."
        verify: [{kind: "nvim-map", mode: "v", lhs: "<C-c>", desc: "Copy to clipboard"}]
        source: "prds/03-editor/14-shift-select/prd.md"
    }
    {
        key: "<C-v> (visual)"
        title: "Paste over selection"
        use: "`<C-v>` on a selection replaces it with the clipboard, and the clipboard still holds what it held, so you can do it again somewhere else."
        topic: "edit"
        task: "editing"
        step: 20
        mode: "nvim:visual"
        also: ["<C-c> (visual)", "<leader>p (visual)"]
        why: "Note what this costs: `<C-v>` no longer starts visual-block from within a selection. Blockwise select is still `<C-v>` from normal mode."
        verify: [{kind: "nvim-map", mode: "v", lhs: "<C-v>", desc: "Paste over selection"}]
        source: "prds/03-editor/14-shift-select/prd.md"
    }
    {
        key: "<Tab> <S-Tab> <C-n> <C-p> <C-Space> <C-e>"
        title: "Drive the completion menu"
        use: "`<Tab>` selects and accepts, and jumps to the next snippet placeholder once you are inside one; `<S-Tab>` goes back. `<C-n>`/`<C-p>` cycle, `<C-Space>` toggles the menu, `<C-e>` hides it. Documentation for the selected item appears on its own after a moment, and signature help shows while you are inside a call."
        topic: "edit"
        task: "code"
        step: 1
        mode: "nvim:insert"
        why: "`<CR>` accepts the selected item and `<Esc>` cancels the menu, but both fall back to their ordinary meaning when no menu is open — that fallback is load-bearing: without it you could not insert a newline or leave insert mode."
        verify: [{kind: "prose"}]
        source: "prds/03-editor/05-completion/prd.md"
    }
    {
        key: "<BS> and <CR> (autopairs)"
        title: "Delete a bracket pair, and let Enter fall through to it"
        use: "`<BS>` next to an auto-inserted closing bracket or quote deletes both characters as one press, the same key as anywhere else. `<CR>` right after an opening bracket splits it onto three lines with the cursor indented in between — `{` then Enter gives `{`, a blank indented line, `}` — but only when no completion menu is showing; with one open, `<CR>` accepts the highlighted item instead, exactly as the entry above describes."
        topic: "edit"
        task: "code"
        step: 2
        mode: "nvim:insert"
        why: "Both keys look like they belong entirely to completion, and only one does. blink.cmp maps `<CR>` to `{\"accept\", \"fallback\"}`: `fallback` means \"run whatever `<CR>` did before blink.cmp claimed it\", and because autopairs sets up first in load order, that prior mapping is autopairs' own bracket-expand handler — so the expand survives, but only through blink.cmp's fallback chain, and only while no menu is open. `<BS>` has no such chain: it is the one map autopairs sets that nothing else claims, so its default wins outright."
        verify: [
            {kind: "nvim-map", mode: "i", lhs: "<BS>", desc: "autopairs delete", scope: "buffer"}
            {kind: "nvim-map", mode: "i", lhs: "<CR>", desc: "blink.cmp: Accept", scope: "buffer"}
        ]
        source: "prds/03-editor/12-small-plugins/prd.md"
    }
    {
        key: "<leader>e"
        title: "Open the current directory as a buffer"
        use: "Press `<leader>e` in any buffer: oil opens on the directory of the current file, dotfiles included. It is a normal buffer — rename a line, delete a line, add a line, then `:w` and the filesystem matches."
        topic: "edit"
        task: "files"
        step: 11
        mode: "nvim:normal"
        why: "`<leader>e` is the fast path, not the only one: oil loads eagerly (`lazy = false`) so its `default_file_explorer` hijack is installed at startup, and `:e some/dir` reaches it with no key pressed. Netrw is disabled either way, so nothing else could claim the directory instead."
        verify: [{kind: "nvim-map", mode: "n", lhs: "<leader>e", desc: "Open file explorer"}]
        source: "prds/03-editor/06-explorer/prd.md"
    }
    {
        key: "<leader>cf"
        title: "Format the buffer now"
        use: "Press `<leader>cf` and the buffer formats asynchronously. You rarely need it: saving formats already — stylua for lua, rustfmt for rust, black for python, prettier for markdown — and a filetype with no formatter of its own is formatted by its language server instead."
        topic: "edit"
        task: "code"
        step: 6
        mode: "nvim:normal"
        why: "Prettier is the markdown formatter because it aligns table pipes, but prose must stay exactly as wrapped: these files are hand-wrapped at ~78 columns and reflowing them would churn every diff. On-save formatting gives up after 500 ms rather than blocking the write."
        verify: [{kind: "nvim-map", mode: "n", lhs: "<leader>cf", desc: "Format buffer"}]
        source: "prds/03-editor/07-formatting/prd.md"
    }
    {
        key: "<leader>t"
        title: "Work with markdown tables"
        use: "In a markdown buffer, table mode is already on: type a row and the pipes realign as you type, with GitHub-style `|` corners. `<leader>t` is the prefix for the rest — `<leader>tt` tableizes the line or the selection, `<leader>tm` toggles the mode, `<leader>tr` realigns. Moving between cells is not under the prefix: `[|` and `]|` step left and right, `{|` and `}|` up and down."
        topic: "edit"
        task: "code"
        step: 7
        mode: "nvim:normal"
        also: ["<leader>cf"]
        why: "Table mode is switched on by a FileType autocmd, not by the plugin itself: `vim-table-mode` ships inactive and needs `TableModeEnable` per buffer. Without the autocmd only the file you opened nvim with would align, and every markdown buffer you `:edit` afterwards would not."
        verify: [{kind: "prose"}]
        source: "prds/03-editor/15-markdown-tables/prd.md"
    }

    # -------------------------------------------------------------------- find
    {
        key: "<leader>ff and <leader><space>"
        title: "Find files in the project"
        use: "Either one opens telescope over the project's files; type any part of the path. `<leader><space>` exists because it is the fastest thing your thumb can do."
        topic: "find"
        task: "files"
        step: 6
        mode: "nvim:normal"
        also: ["<Tab> <S-Tab> <CR> (telescope)", "<leader>fg"]
        why: "This is the editor's finder, and it is deliberately not the shell's. television owns the shell's pickers, telescope owns the editor's; unifying them was considered and rejected."
        verify: [
            {kind: "nvim-map", mode: "n", lhs: "<leader>ff", desc: "Find files"}
            {kind: "nvim-map", mode: "n", lhs: "<leader><space>", desc: "Find files"}
        ]
        source: "prds/03-editor/08-telescope/prd.md"
    }
    {
        key: "<leader>fg"
        title: "Grep the project live"
        use: "Press `<leader>fg`, then type: the search runs over file contents as you type, and enter opens the file on the matching line."
        topic: "find"
        task: "files"
        step: 7
        mode: "nvim:normal"
        also: ["<leader>ff and <leader><space>", "<Tab> <S-Tab> <CR> (telescope)"]
        verify: [{kind: "nvim-map", mode: "n", lhs: "<leader>fg", desc: "Live grep"}]
        source: "prds/03-editor/08-telescope/prd.md"
    }
    {
        key: "<leader>fb"
        title: "Switch to an open buffer"
        use: "Press `<leader>fb` to get the open buffers as a picker, then type part of a name and press enter — the alternative to walking them with `H` and `L` when there are many."
        topic: "find"
        task: "files"
        step: 8
        mode: "nvim:normal"
        also: ["<S-h> <S-l> <leader>bd"]
        verify: [{kind: "nvim-map", mode: "n", lhs: "<leader>fb", desc: "Buffers"}]
        source: "prds/03-editor/08-telescope/prd.md"
    }
    {
        key: "<leader>fh"
        title: "Search Neovim's own help"
        use: "Press `<leader>fh`, then type a topic: it fuzzy-searches the help tags — vim's documentation, not this manual. `help` in the shell is this configuration; `:help` in the editor is Neovim."
        topic: "find"
        task: "files"
        step: 9
        mode: "nvim:normal"
        verify: [{kind: "nvim-map", mode: "n", lhs: "<leader>fh", desc: "Help tags"}]
        source: "prds/03-editor/08-telescope/prd.md"
    }
    {
        key: "<Tab> <S-Tab> <CR> (telescope)"
        title: "Send several picks to the quickfix list"
        use: "Inside any telescope picker, `<Tab>` marks the highlighted row and steps one entry towards the worse matches, `<S-Tab>` marks and steps back towards the better ones — the best match sits at the bottom next to the prompt, so `<Tab>` walks up the screen. Then `<CR>`: with anything marked it sends every mark to the quickfix list and opens it; with nothing marked it just opens the highlighted row. The same keys work whether you are typing or in normal mode inside the picker."
        topic: "find"
        task: "files"
        step: 10
        mode: "nvim:normal"
        also: ["<leader>fg"]
        why: "`prose` because these maps are buffer-local to telescope's own prompt buffer, created only while a picker is open and gone once it closes — `maparg` can see them (a live picker really does return an `lhs`, with `buffer = 1`), but nothing static can, so no `nvim --headless` probe outside a running picker has anything to check against."
        verify: [{kind: "prose"}]
        source: "prds/03-editor/08-telescope/prd.md"
    }

    # ------------------------------------------------------------------- edit / lsp
    {
        key: "gd and gI"
        title: "Jump to a definition or an implementation"
        use: "`gd` on a symbol goes to where it is defined, `gI` to where it is implemented. `<C-o>` comes back."
        topic: "edit"
        task: "code"
        step: 3
        mode: "nvim:normal"
        also: ["Neovim's own LSP keys", "<leader>rn and <leader>ca"]
        why: "These two are aliases for keys Neovim already provides, kept because the fingers know them. They attach per buffer on `LspAttach`, so they only exist where a language server is running — introspecting them needs an attached buffer, not a bare `nvim --headless`."
        verify: [
            {kind: "nvim-map", mode: "n", lhs: "gd", desc: "LSP: Goto definition", scope: "buffer"}
            {kind: "nvim-map", mode: "n", lhs: "gI", desc: "LSP: Goto implementation", scope: "buffer"}
        ]
        source: "prds/03-editor/09-lsp/prd.md"
    }
    {
        key: "<leader>rn and <leader>ca"
        title: "Rename a symbol or take a code action"
        use: "`<leader>rn` renames across the project — type the new name, enter. `<leader>ca` offers the actions the server has for the thing under the cursor. Both are buffer-local, so they appear once a server attaches."
        topic: "edit"
        task: "code"
        step: 5
        mode: "nvim:normal"
        also: ["Neovim's own LSP keys", "gd and gI"]
        verify: [
            {kind: "nvim-map", mode: "n", lhs: "<leader>rn", desc: "LSP: Rename", scope: "buffer"}
            {kind: "nvim-map", mode: "n", lhs: "<leader>ca", desc: "LSP: Code action", scope: "buffer"}
        ]
        source: "prds/03-editor/09-lsp/prd.md"
    }
    {
        key: "Neovim's own LSP keys"
        title: "Use the LSP keys Neovim already ships"
        use: "`K` hovers. `grn` renames, `gra` acts, `grr` lists references, `gri` implementations, `gO` the symbols in the file. `]d` and `[d` walk diagnostics, which show inline with a `●`; to read one in full press `<C-w>d`, which is the key that opens the bordered float naming the server it came from."
        topic: "edit"
        task: "code"
        step: 4
        mode: "nvim:normal"
        also: ["gd and gI", "<leader>rn and <leader>ca"]
        why: "Documented although they are not ours: Neovim provides them itself from 0.11 onward, this config deliberately does not re-map them, and they are how you use this editor. They are the one exception to the rule that plugin- and core-provided maps are allowlisted out of the drift check rather than documented."
        verify: [
            {kind: "nvim-map", mode: "n", lhs: "K", desc: "vim.lsp.buf.hover()", scope: "buffer"}
            {kind: "nvim-map", mode: "n", lhs: "grn", desc: "vim.lsp.buf.rename()"}
            {kind: "nvim-map", mode: "n", lhs: "gra", desc: "vim.lsp.buf.code_action()"}
            {kind: "nvim-map", mode: "n", lhs: "grr", desc: "vim.lsp.buf.references()"}
            {kind: "nvim-map", mode: "n", lhs: "gri", desc: "vim.lsp.buf.implementation()"}
            {kind: "nvim-map", mode: "n", lhs: "gO", desc: "vim.lsp.buf.document_symbol()"}
            {kind: "nvim-map", mode: "n", lhs: "]d", desc: "Jump to the next diagnostic in the current buffer"}
            {kind: "nvim-map", mode: "n", lhs: "[d", desc: "Jump to the previous diagnostic in the current buffer"}
        ]
        source: "prds/03-editor/09-lsp/prd.md"
    }
    {
        key: "<leader>ss <leader>sl <leader>sd"
        title: "Restore the buffers you had open here"
        use: "The session for a directory is written automatically when you quit Neovim with at least one real file open. `<leader>ss` restores the one belonging to the directory you are in, `<leader>sl` restores the most recent session from anywhere, and `<leader>sd` turns the save off for this run when you do not want what you are about to do remembered. Nothing is restored unless you ask: starting `nvim` plainly gives you an empty editor, as it always did."
        topic: "edit"
        task: "code"
        step: 8
        mode: "nvim:normal"
        also: ["<leader>w and <leader>q"]
        why: "This is what tmux-resurrect brings back after a reboot: it re-launches nvim in the pane's directory with the restore command, and without a written session that pane would come back as an empty editor in the right place. The keys sit on `<leader>s` and not persistence.nvim's documented `<leader>q` because `<leader>q` is already Quit here, and making it a prefix would leave every quit waiting `timeoutlen` for a second key."
        verify: [
            {kind: "nvim-map", mode: "n", lhs: "<leader>ss", desc: "Restore session for this directory"}
            {kind: "nvim-map", mode: "n", lhs: "<leader>sl", desc: "Restore last session"}
            {kind: "nvim-map", mode: "n", lhs: "<leader>sd", desc: "Stop session save on exit"}
        ]
        source: "prds/07-multiplexer/06-nvim-session/prd.md"
    }

    # ----------------------------------------------------------------- claude
    # The <leader>x* set is coder/claudecode.nvim riding mr55p-dev/claude-tmux,
    # the editor half of 08-claude-agent. Titles must equal the live `desc`,
    # because these nvim-map targets compare against it.
    {
        key: "<leader>x"
        title: "Show what <leader>x can do"
        use: "Press `<leader>x` and pause: which-key lists the Claude maps — `c` toggle, `f` focus, `r` resume, `C` continue, `m` model, `b` add buffer, `s` send selection, `a` accept diff, `d` deny diff. Claude owns this prefix outright; nothing else sits on `x`."
        topic: "agents"
        task: "agents"
        step: 11
        mode: "nvim:normal"
        also: ["<leader>xc"]
        verify: [{kind: "nvim-map", mode: "n", lhs: "<leader>x", desc: "Claude"}]
        source: "prds/08-claude-agent/02-nvim-plugin/prd.md"
    }
    {
        key: "<leader>xc"
        title: "Toggle Claude"
        use: "Press `<leader>xc` to spawn Claude in a split below the editor — cll's model picker runs first, so the pane starts on the model you pick (`native:*` rows ride the Max plan through `cc`'s login picker, everything else goes through the litellm proxy). Press it again to hide and again to show; only a FRESH spawn re-picks. From the Claude pane, `<C-j>` returns to the editor. Esc in the picker aborts: `cll` exits and the empty pane closes."
        topic: "agents"
        task: "agents"
        step: 12
        mode: "nvim:normal"
        also: ["<leader>xf", "cll [model]", "cc [...args]"]
        why: "Inside tmux the terminal provider is claude-tmux, so this is a REAL pane of the `main` tmux session that tmux owns — addressable by its pane keys, F5-visible, and not nvim's built-in terminal. `<C-j>` is bound pane-locally, so nvim's own `<C-j>` window-down and every other pane are untouched. Outside a tmux session the provider falls back to snacks' terminal; headless runs do the same. The pane spawns through `cll` (claudecode's terminal_cmd), so model and proxy routing belong to cll: a `native:*` pick hands to `cc`'s login picker, a proxied pick sets CLAUDE_CONFIG_DIR to the litellm profile and exports the proxy — overriding whatever login resolution exported. Claudecode's own IDE env (the SSE port) rides the same spawn line, so diffs and @-mentions keep working under either route. The profile resolution in this file seeds only what cll does not govern: an inherited, logged-in CLAUDE_CONFIG_DIR for the native hop, resolved as above (`oauthAccount` decides, `~/.claude/.last-login` breaks the tie)."
        verify: [{kind: "nvim-map", mode: "n", lhs: "<leader>xc", desc: "Toggle Claude"}]
        source: "prds/08-claude-agent/02-nvim-plugin/prd.md"
    }
