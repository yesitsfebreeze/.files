{
  "default": "claude",
  "launch": {
    "codex": {
      "args": ["-c", "model_provider=\"litellm\"",
               "-c", "model_providers.litellm={name=\"litellm\",base_url=\"{base}/v1\",wire_api=\"responses\",env_key=\"OPENAI_API_KEY\"}",
               "-c", "model=\"{model}\""],
      "env": {"OPENAI_API_KEY": "{key}"},
      "unset": ["OPENAI_BASE_URL"]
    },
    "pi": {
      "args": ["--provider", "litellm", "--model", "{model}"],
      "env": {"LITELLM_MASTER_KEY": "{key}"}
    },
    "gemini": {
      "args": [],
      "env": {"GEMINI_API_KEY": "{key}"}
    },
    "aider": {
      "args": ["--openai-api-base", "{base}", "--model", "openai/{model}"],
      "env": {"OPENAI_API_KEY": "{key}"}
    },
    "opencode": {
      "args": [],
      "env": {"OPENAI_API_KEY": "{key}", "OPENAI_BASE_URL": "{base}"}
    }
  },
  "agents": {
    "claude": {
      "cmd": ["claude", "--dangerously-skip-permissions"],
      "env": {
        "CLAUDE_CONFIG_DIR": "{home}/.claude/litellm",
        "ANTHROPIC_BASE_URL": "{base}",
        "ANTHROPIC_AUTH_TOKEN": "{key}",
        "ANTHROPIC_MODEL": "{model}",
        "ANTHROPIC_SMALL_FAST_MODEL": "auto:free",
        "ANTHROPIC_DEFAULT_HAIKU_MODEL": "auto:free",
        "CLAUDE_CODE_MAX_CONTEXT_TOKENS": "{context}"
      },
      "unset": ["ANTHROPIC_API_KEY"],
      "context_unless": ["claude-"],
      "profile": {
        "dir": "{home}/.claude/litellm",
        "from": "{home}/.claude",
        "link": ["plugins", "projects", "sessions", "session-env", "history.jsonl", "cache", "file-history",
                 "shell-snapshots", "agent-memory", "hooks", "hub", "jobs", "plans", "backups", "paste-cache",
                 "context-mode", "debug", "tasks", "teams", "telemetry"],
        "copy": [".claude.json", "settings.json", "settings.local.json"],
        "model_picker": "settings.json"
      },
      "native": {
        "prefix": "native:",
        "models": ["opus", "sonnet", "haiku", "fable"],
        "tty": {
          "cmd": ["nu", "-c", "source ~/.config/nushell/config.nu\ncc ...([--model, $env.CLL_NATIVE_MODEL] ++ ($env.CLL_NATIVE_ARGS? | default \"[]\" | from json))"],
          "env": {"CLL_NATIVE_MODEL": "{model}", "CLL_NATIVE_ARGS": "{args_json}"}
        },
        "cmd": ["claude", "--model", "{model}", "--dangerously-skip-permissions"]
      }
    },
    "pi": {
      "cmd": ["pi", "--provider", "litellm", "--model", "{model}"],
      "env": {}
    }
  }
}