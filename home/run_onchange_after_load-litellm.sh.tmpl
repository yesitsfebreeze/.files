#!/usr/bin/env bash
# chezmoi run_onchange — the router is a launchd service: the proxy stays up
# (KeepAlive) and `llm sync` runs nightly. Re-run only when one of these
# changes, because it restarts the proxy and that cuts every request in flight:
# hook:  {{ include "dot_config/litellm/litellm_hooks.py" | sha256sum }}
# serve: {{ include "Library/LaunchAgents/litellm.plist.tmpl" | sha256sum }}
# sync:  {{ include "Library/LaunchAgents/litellm-sync.plist.tmpl" | sha256sum }}
set -u
log() { printf '\033[1;34m::\033[0m litellm: %s\n' "$*" >&2; }
uid=$(id -u)
for job in litellm-sync litellm; do
    launchctl bootout "gui/$uid/$job" 2> /dev/null
    launchctl bootstrap "gui/$uid" "$HOME/Library/LaunchAgents/$job.plist" || log "could not load $job"
done
log "proxy and nightly sync loaded"
exit 0
