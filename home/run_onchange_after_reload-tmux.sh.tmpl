#!/bin/sh
# chezmoi run_onchange — a running tmux server keeps the config it started
# with, so an apply that changes tmux.conf or cockpit.tsv reloads it; otherwise
# a new binding or cockpit row exists on disk and not on the keyboard. The
# hashes below are what make chezmoi re-run this when either changes.
# tmux.conf {{ include "dot_config/tmux/tmux.conf" | sha256sum }}
# cockpit.tsv {{ include "dot_config/tmux/cockpit.tsv" | sha256sum }}
tmux info >/dev/null 2>&1 || exit 0
tmux source-file "${XDG_CONFIG_HOME:-$HOME/.config}/tmux/tmux.conf"
# terminal-features apply only at attach: a client that attached before
# `sync` was set keeps repainting popups as erase-then-draw. Say so on it.
tmux list-clients -F '#{client_tty} ,#{client_termfeatures},' | grep -v ',sync,' |
    while read -r tty _; do tmux display -c "$tty" -d 5000 'no sync on this client, redraws flicker: tmux detach-client -E "tmux attach"'; done
