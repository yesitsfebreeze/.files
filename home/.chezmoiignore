{{- /*
    Linux is the target; macOS is supported via Homebrew.
    Gate the macOS-only Homebrew bootstrap out on every non-macOS system.
*/ -}}
{{ if ne .chezmoi.os "darwin" }}
install-homebrew.sh
{{ end }}

# WezTerm colors.lua is a generated artifact, NOT tracked in git:
# run_after_generate-shell-init.sh.tmpl regenerates it at apply time by
# running `tinty apply <scheme>`, where <scheme> is the single synced source of
# truth in .chezmoidata/theme.toml. Tracking the generated file made every machine
# commit its own palette and collide; ignoring it here keeps chezmoi from managing
# the deployed copy the hook owns.
.config/wezterm/colors.lua
