@@ -629,0 +630,62 @@ run-shell 'f="${XDG_DATA_HOME:-$HOME/.local/share}/tmux/plugins/tmux-continuum/c
+
+# ── 08-claude-agent/03-tmux-config: Claude Code inside tmux ─────────────────
+#
+# prds/08-claude-agent/03-tmux-config owns everything below. Two lines, both
+# from Claude Code's terminal-config docs (the "Configure tmux" section),
+# both required for Shift+Enter to insert a newline instead of submitting
+# when the agent runs in a pane of this session.
+#
+# THE DECISION, measured on tmux 3.7c (probe/01, probe/02, probe/04): the
+# repo pairs WezTerm's `enable_kitty_keyboard = false` with nushell's
+# `use_kitty_protocol = false` so reedline never fires the kitty support
+# query whose reply the WezTerm pty returns too late (04-shell/01). Adding
+# `extended-keys on` does NOT disturb that pairing, because the option
+# governs what tmux SENDS to pane PROGRAMS only at each program's own
+# request, and nushell never asks:
+#
+#   - A pane program that asked for nothing (reedline's situation --
+#     `use_kitty_protocol: false`, config.nu) receives byte-for-byte the
+#     same input with extended-keys off and on. Measured: plain Enter,
+#     Ctrl+X and arrow-up arrived as `\r 030 ESC[A` in BOTH settings, all
+#     eight request/feature combinations of probe/01.
+#   - Modified keys reach a pane only in extended form after that pane
+#     enables modifyOtherKeys itself (CSI >4;1m, the mode-1 request; probe/04
+#     measured mode 2 giving the same answer). Shift+Enter then arrives as
+#     `CSI 27;2;13~`, Ctrl+X stays the bare byte 018, arrow-up stays
+#     `CSI A`. tmux's man page says the same in prose: `on` lets the pane
+#     program request mode 1 or 2; only `always` would force it.
+#   - The kitty protocol, by contrast, tmux does not track per pane at all:
+#     a pane pushing `CSI >1u` or flags 15 (probe/04) still got plain `\r`
+#     for Shift+Enter. So there is no path by which this line could re-arm
+#     the kitty behaviour that 04-shell/01 turned off.
+#
+# What each line buys:
+#
+#  - `extended-keys on` is the pane HALF. With it off, tmux folds BOTH
+#    Shift+Enter spellings into the bare `\r` of plain Enter (measured,
+#    probe/01) and Claude Code cannot tell a newline from a submit, even
+#    though the outer terminal encoded them differently -- every encoding
+#    collapses to the one byte the pane asked to have. On, a pane that asks
+#    (Claude Code does: its binary carries the `CSI >4;2m` enable and a
+#    `CSI ?u` kitty reply parser) gets Shift+Enter whole and Ctrl+J keeps
+#    working unchanged.
+#  - `xterm*:extkeys` names the CLIENT terminal as extended-key capable, so
+#    tmux asks it (it "always requests" per the man page) and the outer
+#    terminal knows it may answer in modifyOtherKeys form. Measured
+#    (probe/02): with extended-keys on, tmux emits `CSI >4;2m` on the client
+#    wire at attach with the feature line present AND absent alike, on an
+#    xterm-shaped TERM and on screen-256color alike -- on 3.7c the feature
+#    line is belt and braces, carried because the docs require it and
+#    because an older tmux gates the request on a matching extkeys feature.
+#  - `allow-passthrough on` needs no line here; the terminal-integration
+#    floor set it above (01-session-and-windows), and it is the channel the
+#    notifications ride.
+#
+# The format stays the default `xterm` (CSI 27;2;13~), which is what tmux
+# sent in every measured case above; Claude Code decodes both spellings.
+#
+# Appended, not edited, per this file's header contract. No key tables, no
+# palette, no copy mode: F4/F5/F6 and everything 07-multiplexer shipped are
+# untouched above.
+set -s extended-keys on
+set -as terminal-features 'xterm*:extkeys'
