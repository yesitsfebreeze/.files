diff --git a/home/dot_config/tmux/tmux.conf b/home/dot_config/tmux/tmux.conf
index bf84ca5..ea9c8ca 100644
--- a/home/dot_config/tmux/tmux.conf
+++ b/home/dot_config/tmux/tmux.conf
@@ -152,0 +153,265 @@ set -ga update-environment XDG_CONFIG_HOME
+
+# ── 02-key-tables: F4 split, F5 switch, F6 theme — and nothing in WezTerm ────
+#
+# prds/07-multiplexer/02-key-tables owns everything below. Three keys, bound
+# with `-n` so they need no prefix, which is what makes them feel like
+# terminal keys rather than multiplexer keys.
+#
+# HOW A PUSHED TABLE BEHAVES, measured on 3.7c (probe/notes.md K1, K2) —
+# this is the property the whole design rests on and it is not documented
+# anywhere obvious:
+#
+#   A key with no binding in the pushed table is looked up A SECOND TIME in
+#   `root`. If root does not bind it either, it is DROPPED — it does not
+#   reach the program in the pane. So a mistyped letter cancels the mode and
+#   types nothing, which is exactly the behaviour 02-terminal/03-f5-jump-mode
+#   R2 demanded and got by binding all 26 letters to a no-op. On this
+#   mechanism those binds would be dead code: tmux already does it.
+#
+#   The same second lookup is why the double-tap needs an explicit binding
+#   (Q10). Without `bind -T jump F5 send-keys F5`, the second F5 misses in
+#   `jump`, hits `bind -n F5` in `root`, and silently re-arms the table
+#   instead of forwarding anything.
+#
+# No timeout is needed or possible. WezTerm's jump_mode carried a 5 s
+# JUMP_TIMEOUT_MS because its key table persisted; a tmux table is popped by
+# the very next keystroke whatever it is, so the mode is at most one key deep.
+
+# ── F4 — split, the arrow gives the direction ───────────────────────────────
+#
+# `-c "#{pane_current_path}"` is the split's cwd rule and it is deliberately
+# NOT the digit's: a split inherits where you are (you are dividing this
+# work), a lazily created window starts at ~ (Q14 — a digit is a clean
+# slate). The two gestures disagree on purpose.
+#
+# The value behind #{pane_current_path} is the shell's OSC 7, which is why
+# config.nu keeps `osc7: true`. Its neighbour `osc133: false` stays off for
+# an unrelated and expensive reason — double-marking produced phantom prompt
+# lines — and nothing here needs it.
+bind -n F4 switch-client -T split
+bind -T split Left  split-window -hb -c "#{pane_current_path}"
+bind -T split Right split-window -h  -c "#{pane_current_path}"
+bind -T split Up    split-window -vb -c "#{pane_current_path}"
+bind -T split Down  split-window -v  -c "#{pane_current_path}"
+# The double-tap (Q10): F4 F4 puts a literal F4 on the pane's pty, which a
+# nested tmux reads as the key. Verified as bytes on the wire, not inferred.
+bind -T split F4 send-keys F4
+
+# ── F5 — a digit is a window, a letter is a pane ────────────────────────────
+bind -n F5 switch-client -T jump
+
+# Q2, lazy: the digit selects window N, and CREATES it at index N when it is
+# absent, so a digit is always a valid address and nothing is respawned in
+# the background. The hole left by killing window 4 is not a dead key.
+#
+# `if-shell -F` tests a FORMAT, so no /bin/sh is spawned per keypress. The
+# existence test loops the window list and matches the index inside
+# delimiters:
+#
+#     #{W:|#{window_index}|}   →  |1||4||7|
+#
+# THE DELIMITER MUST NOT BE A GLOB METACHARACTER. `#{m:}` is fnmatch and `[`
+# opens a character class, so the natural `#{m:*[1]*,#{W:[#{window_index}]}}`
+# answers TRUE for window **11** when asked about window 1, and the binding
+# then selects a window that does not exist. Measured. `|` is inert to
+# fnmatch.
+#
+# `-c ~` on the create arm is belt and braces: the session is created at
+# $HOME by ~/.local/bin/tmux-main, and a key-bound `new-window` resolves the
+# SESSION's path (01-session-and-windows F14), so this is already ~ for a
+# session this repo started. It is stated so the rule also holds against a
+# session somebody else created by hand somewhere else.
+bind -T jump 1 if-shell -F '#{m:*|1|*,#{W:|#{window_index}|}}' 'select-window -t :1' 'new-window -t :1 -c ~'
+bind -T jump 2 if-shell -F '#{m:*|2|*,#{W:|#{window_index}|}}' 'select-window -t :2' 'new-window -t :2 -c ~'
+bind -T jump 3 if-shell -F '#{m:*|3|*,#{W:|#{window_index}|}}' 'select-window -t :3' 'new-window -t :3 -c ~'
+bind -T jump 4 if-shell -F '#{m:*|4|*,#{W:|#{window_index}|}}' 'select-window -t :4' 'new-window -t :4 -c ~'
+bind -T jump 5 if-shell -F '#{m:*|5|*,#{W:|#{window_index}|}}' 'select-window -t :5' 'new-window -t :5 -c ~'
+bind -T jump 6 if-shell -F '#{m:*|6|*,#{W:|#{window_index}|}}' 'select-window -t :6' 'new-window -t :6 -c ~'
+bind -T jump 7 if-shell -F '#{m:*|7|*,#{W:|#{window_index}|}}' 'select-window -t :7' 'new-window -t :7 -c ~'
+bind -T jump 8 if-shell -F '#{m:*|8|*,#{W:|#{window_index}|}}' 'select-window -t :8' 'new-window -t :8 -c ~'
+bind -T jump 9 if-shell -F '#{m:*|9|*,#{W:|#{window_index}|}}' 'select-window -t :9' 'new-window -t :9 -c ~'
+
+# Q3: a-i address pane index 1-9. The capability WezTerm refused — I3 forbids
+# PaneSelect, so letter addressing there meant self-painting an overlay, and
+# all 26 letters sat bound as bare cancels holding this space. Here it is
+# nine `select-pane -t`.
+#
+# tmux RENUMBERS panes when one is killed, so a letter does not keep its pane
+# for life. That is why 03-status-bar's `pane-border-format` prints the
+# letter: the label is derived from the same index the key uses, so it is
+# right the instant after a renumber rather than describing where the pane
+# used to be. The letters are only honest WITH that border, and the two nodes
+# are one design.
+bind -T jump a select-pane -t :.1
+bind -T jump b select-pane -t :.2
+bind -T jump c select-pane -t :.3
+bind -T jump d select-pane -t :.4
+bind -T jump e select-pane -t :.5
+bind -T jump f select-pane -t :.6
+bind -T jump g select-pane -t :.7
+bind -T jump h select-pane -t :.8
+bind -T jump i select-pane -t :.9
+
+# The double-tap (Q10). See the F4 twin above.
+bind -T jump F5 send-keys F5
+
+# ── F6 — theme toggle, and the one key that is never forwarded ──────────────
+#
+# F6 gets no table and no `send-keys F6` anywhere, deliberately (Q10): the
+# palette belongs to the OUTERMOST terminal, because that is the process
+# that owns the ANSI colours and reads the OSC. An F6 forwarded into a nested
+# session could only retint a session that does not own them.
+#
+# Bound in the multiplexer rather than in the shell because a full-screen TUI
+# would swallow a shell-level binding. `-b` so the tmux server is not blocked
+# for the length of a `tinty apply`, which runs a whole hook chain.
+#
+# `sh -lc` is a LOGIN shell on purpose: /etc/profile runs path_helper, which
+# puts Homebrew's bin on PATH by itself, so this file names no Homebrew path
+# and stays the same file on a machine that has never heard of it. The two
+# directories prepended are the ones no login shell adds anywhere — tinty
+# lives in ~/.local/bin — and both are $HOME-relative, so they are inert
+# where they do not exist. Do NOT drop the prefix on the grounds that `nu`
+# resolves without it: the toggle would then fail one layer deeper, on
+# `tinty`, where the cause is far harder to see than a missing shell.
+bind -n F6 run-shell -b 'PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH" sh -lc '"'"'exec nu -n -c "source $HOME/.config/nushell/theme.nu; _theme_toggle"'"'"''
+
+# ── 05-copy-and-clipboard: copy mode, the c-cycle, and the sink ─────────────
+#
+# prds/07-multiplexer/05-copy-and-clipboard owns everything below. It ports
+# the WezTerm gesture of 02-terminal/04-copy-mode onto tmux's own copy mode
+# (epic Q6) and picks the clipboard sink by where the panes are (epic Q14).
+
+# vi keys in copy mode, stated rather than inherited. tmux picks mode-keys
+# from $EDITOR/$VISUAL when it is not set, so on a host where EDITOR is
+# unset or emacs-shaped the whole c-cycle would sit on top of a table whose
+# motions are emacs bindings. The rest of this section names copy-mode-vi
+# explicitly, so the option and the table have to agree.
+set -gw mode-keys vi
+
+# ── the sink: pbcopy here, OSC 52 anywhere else ─────────────────────────────
+#
+# pbcopy writes the clipboard of the machine the TMUX SERVER runs on, which
+# is the machine the panes are on. That is the right clipboard when the
+# server is this desk and the wrong one — or no one at all — when you have
+# ssh'd somewhere and started tmux there. OSC 52 is the opposite: it travels
+# out through the client's terminal, so it reaches the clipboard of the
+# machine you are SITTING at, whatever is in between.
+#
+# So the branch is `does this machine have pbcopy`, taken once at parse time
+# (if-shell in a config file is synchronous — 01-session-and-windows F1).
+#
+# The two arms are EXCLUSIVE, and that is what `set-clipboard off` buys on
+# the local arm: measured on tmux 3.7c, `copy-pipe-and-cancel pbcopy` under
+# `set-clipboard on` puts the text on the clipboard AND emits an OSC 52 for
+# the same text, so "picks its sink" would have been two sinks. `off` costs
+# nothing here: also measured on 3.7c, an OSC 52 written by an APPLICATION
+# inside a pane (remote nvim's osc52 provider on the far end of an ssh) is
+# forwarded to the outer terminal under off, external and on alike. The
+# manual is wrong about that on this version; do not restore `on` locally on
+# the strength of the manual page without re-measuring.
+#
+# The case this gets wrong, named rather than hidden: a tmux server on THIS
+# machine attached from somewhere else over ssh copies to this desk's
+# clipboard, not to the one in front of you. Copying out is the direction
+# this environment is built for; copying in was not bought.
+if-shell 'command -v pbcopy >/dev/null 2>&1' {
+    set -g @copy-sink pbcopy
+    set -s set-clipboard off
+} {
+    set -g @copy-sink osc52
+    set -s set-clipboard on
+}
+
+# ── entry ───────────────────────────────────────────────────────────────────
+#
+# Ctrl+Shift+X, the gesture 02-terminal/04-copy-mode built and Q6 keeps.
+#
+# THE CONSTRAINT, measured, because it decides whether this key exists at
+# all: a terminal cannot express Ctrl+Shift+X in the legacy encoding — both
+# Ctrl+X and Ctrl+Shift+X are the single byte 0x18. The key only arrives as
+# something distinguishable when the terminal speaks an extended-key
+# protocol. tmux 3.7c DECODES both spellings — `CSI 120;6u` (kitty/CSI-u)
+# and `CSI 27;6;120~` (xterm modifyOtherKeys) — into `C-S-x`, and it does so
+# with `extended-keys` off, on and always alike: that option governs what
+# tmux SENDS, never what it accepts.
+#
+# WezTerm as this repo configures it sends neither, because
+# `enable_kitty_keyboard = false` is a matched pair with nushell's
+# `use_kitty_protocol = false` (04-shell/01-core-config) and must not be
+# flipped. 07-multiplexer/08-wezterm-reduction owes the one-line shim that
+# closes the gap — `Ctrl+Shift+X` -> `SendString "\x1b[120;6u"` — in the
+# place where the WezTerm copy-mode block is being deleted anyway. Until it
+# lands the key works on a terminal that speaks CSI-u natively (kitty,
+# Ghostty, foot, WezTerm with the kitty protocol on) and nowhere else, and
+# `C-b [` is the entry that works on every terminal ever.
+#
+# Binding C-S-x costs plain C-x nothing: measured, with only C-S-x bound a
+# plain Ctrl+X still reaches the pane as 0x18, so nvim's i_CTRL-X completion
+# prefix and every readline binding are untouched. Binding C-x instead — the
+# byte that actually arrives on a legacy terminal — would have taken them
+# all.
+bind -n C-S-x copy-mode
+
+# The cycle position is per pane and lives in @copy-cycle. It is cleared on
+# EVERY entry to copy mode, which is what makes an exit by q, Escape or y
+# unable to leave it stale — the reason 02-terminal/04-copy-mode R1 gives,
+# on a new mechanism. The hook rather than the binding, because copy mode is
+# also entered by the mouse wheel and by `copy-mode` typed as a command, and
+# a stale toggle on those paths would start the cycle in the middle.
+#
+# It also guards a real trap: `jump-to-mark` with no mark set does not stay
+# put, it moves the cursor to line 2 column 0 (measured). The cycle only
+# ever jumps in its `line` state, which is reachable only after the state
+# that sets the mark.
+set-hook -g after-copy-mode 'set -pu @copy-cycle'
+
+# ── the c-cycle: cell -> word -> line -> cell ───────────────────────────────
+#
+# One key drives the whole select-and-copy gesture, as it did in WezTerm.
+# What is new is that tmux's own selection granularities do the work:
+# begin-selection is a cell, select-word is the word under the cursor,
+# select-line is the whole line.
+#
+# THE TRAP, measured: select-word leaves the cursor at the end of the word
+# and select-line at the end of the line, so a naive cycle wrapping back to
+# cell anchors on wherever the last selection ENDED. On `alpha beta gamma
+# delta` with the cursor on `beta`, cell/word/line read b / beta / the whole
+# line, and the next `c` without a restore reads `delta`. set-mark on the
+# first press records the anchor; `jump-to-mark` then `set-mark` on the wrap
+# restores it and puts the mark back (jump-to-mark SWAPS cursor and mark, it
+# does not copy), so the cycle returns to the same cell it started from.
+#
+# The position is tracked in an option rather than by reading the selection
+# back, for the reason 04-copy-mode R4 gives and which survives the move: a
+# one-cell selection reads #{selection_present} 0 while #{selection_active}
+# is 1, so a state machine driven off the selection desyncs on its own first
+# step.
+bind -T copy-mode-vi c {
+    if -F '#{==:#{@copy-cycle},cell}' {
+        send -X select-word
+        set -p @copy-cycle word
+    } {
+        if -F '#{==:#{@copy-cycle},word}' {
+            send -X select-line
+            set -p @copy-cycle line
+        } {
+            if -F '#{==:#{@copy-cycle},line}' { send -X jump-to-mark }
+            send -X set-mark
+            send -X clear-selection
+            send -X begin-selection
+            set -p @copy-cycle cell
+        }
+    }
+}
+
+# y copies and leaves, through whichever sink the branch above chose, and
+# resets the cycle so the next entry starts at cell even though the hook
+# would have done it anyway. Everything else in copy-mode-vi is tmux's own
+# table, untouched: v / V / C-v, the searches, and every motion.
+bind -T copy-mode-vi y {
+    set -pu @copy-cycle
+    if -F '#{==:#{@copy-sink},pbcopy}' \
+        'send -X copy-pipe-and-cancel pbcopy' \
+        'send -X copy-selection-and-cancel'
+}
